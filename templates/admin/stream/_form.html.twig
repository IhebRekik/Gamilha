{# templates/admin/stream/_form.html.twig #}
{{ form_start(form) }}

<div class="card bg-dark border-primary border-opacity-25 shadow-lg rounded-4">
    <div class="card-body p-4">
        <div class="row g-4">

            {# Title #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.title, 'Titre du Stream', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    {{ form_widget(form.title, {
                        'attr': {
                            'class': 'form-control bg-dark text-white border-secondary border-opacity-50',
                            'placeholder': 'Entrez le titre du stream'
                        }
                    }) }}
                    {{ form_errors(form.title, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

            {# Viewers #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.viewers, 'Nombre de spectateurs', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    <div class="input-group">
                        <span class="input-group-text bg-info border-0 text-white">
                            <i class="bi bi-people-fill"></i>
                        </span>
                        {{ form_widget(form.viewers, {
                            'attr': {
                                'class': 'form-control bg-dark text-white border-secondary border-opacity-50',
                                'placeholder': '0'
                            }
                        }) }}
                    </div>
                    {{ form_errors(form.viewers, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

        

        </div>
    </div>
     <div class="col-12">
                <div class="mb-3">
                    {{ form_label(form.url, 'Lien du Stream', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    {{ form_widget(form.url, {
                        'attr': {
                            'class': 'form-control bg-dark text-white border-secondary border-opacity-50',
                            'placeholder': 'https://...'
                        }
                    }) }}
                    {{ form_errors(form.url, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

        </div>
    </div>

    {# Footer avec actions #}
    <div class="card-footer bg-black bg-opacity-25 border-top border-secondary border-opacity-10 p-3">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('admin_stream_index') }}" class="btn btn-link text-secondary text-decoration-none">
                <i class="bi bi-x-circle me-1"></i> Annuler
            </a>
            <button type="submit" class="btn btn-primary px-5 shadow">
                <i class="bi bi-save-fill me-2"></i> {{ button_label|default('Enregistrer') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}
