{% extends 'base.html.twig' %}

{% block title %}Gamelha - Streams{% endblock %}

{% block body %}
<div class="container py-4">

    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <h1 class="text-white d-flex align-items-center mb-0">
            <i class="bi bi-broadcast-pin text-primary me-2"></i>
            Gestion des streams
        </h1>

        <a href="{{ path('admin_stream_new') }}" class="btn btn-success shadow-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Nouveau stream
        </a>
    </div>

    <!-- Barre de recherche + filtres -->
    <div class="card bg-dark border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <!-- Recherche -->
                <div class="col-12 col-md-5 col-lg-4">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-secondary border-0 text-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input 
                            id="searchInput" 
                            type="text" 
                            class="form-control bg-secondary text-white border-0 shadow-none" 
                            placeholder="Rechercher (titre, url...)" 
                            aria-label="Rechercher">
                    </div>
                </div>

                <!-- Filtres -->
                <div class="col-12 col-md-7 col-lg-8">
                    <div class="d-flex flex-wrap gap-3">
                        <!-- Filtre viewers minimum -->
                        <div class="flex-grow-1 flex-shrink-1" style="min-width: 180px;">
                            <select id="filterViewers" class="form-select bg-secondary text-white border-0 shadow-none">
                                <option value="">Tous les viewers</option>
                                <option value="50">+50 viewers</option>
                                <option value="100">+100 viewers</option>
                                <option value="500">+500 viewers</option>
                                <option value="1000">+1 000 viewers</option>
                                <option value="5000">+5 000 viewers</option>
                            </select>
                        </div>

                        <!-- Tri par viewers -->
                        <div class="flex-grow-1 flex-shrink-1" style="min-width: 200px;">
                            <select id="sortViewers" class="form-select bg-secondary text-white border-0 shadow-none">
                                <option value="">Tri par défaut</option>
                                <option value="desc">Viewers : le plus regardé ↓</option>
                                <option value="asc">Viewers : le moins regardé ↑</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau -->
    <div class="card bg-dark border-0 shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" id="streamsTable">
                    <thead class="text-secondary text-uppercase small border-bottom border-primary border-opacity-25">
                        <tr>
                            <th>Titre</th>
                            <th>Viewers</th>
                            <th>URL</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                    {% for stream in streams %}
                        <tr class="border-bottom border-secondary border-opacity-10">
                            <td class="title fw-semibold text-white">{{ stream.title }}</td>
                            <td class="viewers" data-viewers="{{ stream.viewers }}">
                                <span class="badge bg-danger border border-light border-opacity-25 px-3 py-2">
                                    <i class="bi bi-eye-fill me-1"></i>
                                    {{ stream.viewers|number_format(0, ',', ' ') }}
                                </span>
                            </td>
                            <td class="url text-truncate" style="max-width: 280px;">
                                <a href="{{ stream.url }}" target="_blank" class="text-info text-decoration-none">
                                    {{ stream.url }}
                                </a>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm">
                                    <a href="{{ path('admin_stream_show', {'id': stream.id}) }}"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('admin_stream_edit', {'id': stream.id}) }}"
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                   
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-secondary">
                                <i class="bi bi-broadcast fs-1 d-block mb-2"></i>
                                Aucun stream trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- JavaScript pour recherche, filtre et tri -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput   = document.getElementById('searchInput');
    const filterViewers = document.getElementById('filterViewers');
    const sortViewers   = document.getElementById('sortViewers');
    const table         = document.getElementById('streamsTable');
    const tbody         = table.querySelector('tbody');
    const rows          = Array.from(tbody.querySelectorAll('tr:not(:has(td[colspan]))'));

    function filterAndSort() {
        const searchText = searchInput.value.toLowerCase().trim();
        const minViewers = parseInt(filterViewers.value) || 0;
        const sortOrder  = sortViewers.value;

        // Filtrer
        let filteredRows = rows.filter(row => {
            const title = row.querySelector('.title')?.textContent.toLowerCase() || '';
            const url   = row.querySelector('.url a')?.textContent.toLowerCase() || '';
            const viewers = parseInt(row.querySelector('.viewers')?.dataset.viewers || 0);

            const matchesSearch = title.includes(searchText) || url.includes(searchText);
            const matchesViewers = viewers >= minViewers;

            return matchesSearch && matchesViewers;
        });

        // Trier
        if (sortOrder === 'asc' || sortOrder === 'desc') {
            filteredRows.sort((a, b) => {
                const va = parseInt(a.querySelector('.viewers')?.dataset.viewers || 0);
                const vb = parseInt(b.querySelector('.viewers')?.dataset.viewers || 0);
                return sortOrder === 'asc' ? va - vb : vb - va;
            });
        }

        // Afficher
        tbody.innerHTML = '';
        filteredRows.forEach(row => tbody.appendChild(row));

        // Message aucun résultat
        if (filteredRows.length === 0 && rows.length > 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center py-5 text-secondary">
                        <i class="bi bi-search fs-1 d-block mb-2"></i>
                        Aucun stream ne correspond à votre recherche
                    </td>
                </tr>
            `;
        }
    }

    searchInput.addEventListener('input', filterAndSort);
    filterViewers.addEventListener('change', filterAndSort);
    sortViewers.addEventListener('change', filterAndSort);
});
</script>
{% endblock %}