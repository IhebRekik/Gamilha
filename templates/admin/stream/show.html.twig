{% extends 'base.html.twig' %}

{% block title %}Gamelha - Stream Détails{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('admin_stream_index') }}" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="text-white h3 mb-0">Détails du Stream</h1>
    </div>

    <div >
        <div >
            <div class="card bg-dark border border-primary border-opacity-25 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark border-bottom border-secondary border-opacity-10 py-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                            <i class="bi bi-camera-video-fill text-white fs-5"></i>
                        </div>
                        <div>
                            <h6 class="text-white mb-0">Stream Administrateur</h6>
                            <small class="text-secondary">Titre du Stream: <span class="text-info">{{ stream.title }}</span></small>
                        </div>
                    </div>
                </div>

                <div class="card-body py-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-white">ID</dt>
                        <dd class="col-sm-8 text-white">{{ stream.id }}</dd>

                        <dt class="col-sm-4 text-white">Viewers</dt>
                        <dd class="col-sm-8 text-white">{{ stream.viewers }}</dd>

                        <dt class="col-sm-4 text-white">URL</dt>
                        <dd class="col-sm-8">
                            <a href="{{ stream.url }}" class="text-info" target="_blank">{{ stream.url }}</a>
                        </dd>
                    </dl>
                </div>

                <div class="card-footer bg-dark border-top border-secondary border-opacity-10 py-3">
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('admin_stream_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left-circle-fill me-2"></i>Retour
                        </a>

                        <div class="d-flex">
                            <a href="{{ path('admin_stream_edit', {'id': stream.id}) }}" class="btn btn-warning me-2">
                                <i class="bi bi-pencil-fill me-1"></i>Modifier
                            </a>
                            {{ include('admin/stream/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

       
    </div>
</div>
{% endblock %}
