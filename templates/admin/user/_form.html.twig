{# templates/user/_form.html.twig #}

{{ form_start(form, {
    'attr': {
        'class': 'needs-validation',
        'novalidate': 'novalidate'
    }
}) }}

{# 🔴 Erreurs globales (ex: email déjà utilisé) #}
{% if form_errors(form) %}
    <div class="alert alert-danger mb-4">
        {{ form_errors(form) }}
    </div>
{% endif %}

<div class="row g-4">

    {# ===================== NOM ===================== #}
    <div class="col-md-6">
        <div class="mb-3">
            {{ form_label(form.name, null, {
                'label_attr': {
                    'class': 'form-label text-white fw-semibold'
                }
            }) }}

            {{ form_widget(form.name, {
                'attr': {
                    'class': 'form-control bg-dark text-white border-primary border-opacity-50',
                    'placeholder': 'Entrez le nom complet',
                    'required': false
                }
            }) }}

            <div class="text-danger small mt-1">
                {{ form_errors(form.name) }}
            </div>
        </div>
    </div>

    {# ===================== EMAIL ===================== #}
    <div class="col-md-6">
        <div class="mb-3">
            {{ form_label(form.email, null, {
                'label_attr': {
                    'class': 'form-label text-white fw-semibold'
                }
            }) }}

            {{ form_widget(form.email, {
                'attr': {
                    'class': 'form-control bg-dark text-white border-primary border-opacity-50',
                    'placeholder': 'exemple@domaine.com',
                    'required': false
                }
            }) }}

            <div class="text-danger small mt-1">
                {{ form_errors(form.email) }}
            </div>
        </div>
    </div>

</div>

<div class="row g-4">

    {# ===================== MOT DE PASSE ===================== #}
    <div class="col-md-6">
        <div class="mb-3">
            {{ form_label(form.password, null, {
                'label_attr': {
                    'class': 'form-label text-white fw-semibold'
                }
            }) }}

            {{ form_widget(form.password, {
                'attr': {
                    'class': 'form-control bg-dark text-white border-primary border-opacity-50',
                    'placeholder': '••••••••••••',
                    'required': false
                }
            }) }}

            <div class="text-danger small mt-1">
                {{ form_errors(form.password) }}
            </div>
        </div>
    </div>

</div>

{# ===================== ACTIONS ===================== #}
<div class="mt-4 pt-3 border-top border-secondary border-opacity-25 d-flex justify-content-center">

    <button type="submit" class="btn btn-primary px-5 py-2">
        <i class="bi bi-save-fill me-2"></i>
        Enregistrer
    </button>

    <a href="{{ path('admin_user_index') }}"
       class="btn btn-outline-secondary ms-3">
        <i class="bi bi-arrow-left-circle me-2"></i>
        Retour à la liste
    </a>

</div>

{{ form_end(form) }}
