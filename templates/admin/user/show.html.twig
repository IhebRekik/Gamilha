{% extends 'base.html.twig' %}

{% block title %}Gamelha - Détails Utilisateur{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('admin_user_index') }}" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="text-white h3 mb-0">Détails de l'utilisateur</h1>
    </div>

    <div class="card bg-dark border border-primary border-opacity-25 shadow-lg rounded-4 overflow-hidden">
        <div class="card-body py-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-white">ID</dt>
                <dd class="col-sm-9 text-white">{{ user.id }}</dd>

                <dt class="col-sm-3 text-white">Nom</dt>
                <dd class="col-sm-9 text-white">{{ user.name }}</dd>

                <dt class="col-sm-3 text-white">Email</dt>
                <dd class="col-sm-9 text-white">{{ user.email }}</dd>

                <dt class="col-sm-3 text-white">Équipes</dt>
                <dd class="col-sm-9 text-white">
                    {% for team in user.teams %}
                        {{ team.name }}{% if not loop.last %}, {% endif %}
                    {% else %}
                        <span class="text-secondary">Aucune équipe</span>
                    {% endfor %}
                </dd>

                <dt class="col-sm-3 text-white">Abonnements</dt>
                <dd class="col-sm-9 text-white">
                    {% for ab in user.userAbonnements %}
                        {{ ab.abonnement.type }} ({{ ab.dateDebut ? ab.dateDebut|date('d/m/Y') : '-' }} → {{ ab.dateFin ? ab.dateFin|date('d/m/Y') : '-' }})<br>
                    {% else %}
                        <span class="text-secondary">Aucun abonnement</span>
                    {% endfor %}
                </dd>
            </dl>
        </div>

        <div class="card-footer bg-dark border-top border-secondary border-opacity-10 d-flex justify-content-between">
            <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle-fill me-2"></i>Retour
            </a>

            <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');" class="d-inline">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                <button class="btn btn-danger">
                    <i class="bi bi-trash-fill me-1"></i>Supprimer
                </button>
            </form>
        </div>
    </div>
</div>
{% endblock %}
