{% extends 'base.html.twig' %}

{% block title %}Gérer les Utilisateurs{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* ── Pagination personnalisée dark-theme ────────────────────── */
.knp-pagination-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-top: 1.5rem;
}
.knp-pagination-info {
    font-size: .82rem;
    color: rgba(167,139,250,.7);
    letter-spacing: .03em;
}
.knp-pagination .pagination {
    gap: 4px;
    margin: 0;
}
.knp-pagination .page-link {
    background: rgba(26,26,40,.9);
    border: 1px solid rgba(139,92,246,.25);
    color: #a78bfa;
    border-radius: 8px !important;
    min-width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .88rem;
    font-weight: 500;
    transition: background .2s, border-color .2s, color .2s, box-shadow .2s;
}
.knp-pagination .page-link:hover {
    background: rgba(139,92,246,.18);
    color: #c084fc;
    border-color: rgba(139,92,246,.55);
    box-shadow: 0 0 8px rgba(139,92,246,.25);
}
.knp-pagination .page-item.active .page-link,
.knp-pagination .page-link.active-page {
    background: linear-gradient(135deg, #8b5cf6, #7c3aed) !important;
    border-color: #8b5cf6 !important;
    color: #fff !important;
    box-shadow: 0 2px 10px rgba(139,92,246,.4);
    cursor: default;
}
.knp-pagination .page-item.disabled .page-link {
    background: rgba(26,26,40,.5);
    color: rgba(167,139,250,.25);
    border-color: rgba(139,92,246,.08);
    cursor: not-allowed;
    pointer-events: none;
}
</style>
{% endblock %}

{% block body %}
<div class="container py-4">

    <!-- Messages flash -->
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <h1 class="text-white d-flex align-items-center mb-0">
            <i class="bi bi-people-fill text-primary me-2"></i>
            Gestion des utilisateurs
        </h1>

        <a href="{{ path('admin_user_new') }}" class="btn btn-success shadow-sm px-3">
            <i class="bi bi-plus-lg me-1"></i> Créer un utilisateur
        </a>
    </div>

    <!-- Barre de recherche + filtres -->
    <div class="card bg-dark border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <!-- Recherche -->
                <div class="col-12 col-md-5 col-lg-4">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-secondary border-0 text-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input 
                            id="searchInput" 
                            type="text" 
                            class="form-control bg-secondary text-white border-0 shadow-none" 
                            placeholder="Rechercher (nom, email...)" 
                            aria-label="Rechercher">
                    </div>
                </div>

                <!-- Filtres -->
                <div class="col-12 col-md-7 col-lg-8">
                    <div class="d-flex flex-wrap gap-3">
                        <!-- Filtre par rôle -->
                        <div class="flex-grow-1 flex-shrink-1" style="min-width: 180px;">
                            <select id="filterRole" class="form-select bg-secondary text-white border-0 shadow-none">
                                <option value="">Tous les rôles</option>
                                <option value="ROLE_USER">Utilisateur</option>
                                <option value="ROLE_ADMIN">Administrateur</option>
                                <option value="ROLE_MODERATOR">Modérateur</option>
                                <option value="ROLE_COACH">Coach</option>
                            </select>
                        </div>

                        <!-- Filtre par statut -->
                        <div class="flex-grow-1 flex-shrink-1" style="min-width: 180px;">
                            <select id="filterStatus" class="form-select bg-secondary text-white border-0 shadow-none">
                                <option value="">Tous les statuts</option>
                                <option value="active">Actifs</option>
                                <option value="inactive">Inactifs</option>
                                <option value="banned">Bannis</option>
                            </select>
                        </div>

                        <!-- Tri par nom -->
                        <div class="flex-grow-1 flex-shrink-1" style="min-width: 180px;">
                            <select id="sortName" class="form-select bg-secondary text-white border-0 shadow-none">
                                <option value="">Tri par défaut</option>
                                <option value="asc">Nom : A → Z</option>
                                <option value="desc">Nom : Z → A</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau -->
    <div class="card bg-dark border-0 shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" id="usersTable">
                    <thead class="text-secondary text-uppercase small border-bottom border-primary border-opacity-25">
                        <tr>
                            <th>Avatar</th>
                            <th>Nom</th>
                            <th>Email</th>
                            <th>Rôle(s)</th>
                            <th>Statut</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for user in pagination %}
                        <tr class="border-bottom border-secondary border-opacity-10" 
                            data-status="{{ user.isActive ? (user.banUntil and user.banUntil > date()) ? 'banned' : 'active' : 'inactive' }}"
                            data-roles="{{ user.roles|join(',') }}">
                            <td style="width:72px;">
                                {% if user.profileImage %}
                                    <img src="{{ asset('uploads/profile_images/' ~ user.profileImage) }}" class="rounded-circle" width="48" height="48" alt="Avatar">
                                {% else %}
                                    <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center" style="width:48px;height:48px;">
                                        <i class="bi bi-person-fill text-white-50"></i>
                                    </div>
                                {% endif %}
                            </td>
                            <td class="name">
                                <span class="fw-semibold text-white">{{ user.name ?: user.username ?: '—' }}</span>
                            </td>
                            <td class="email text-white-50">{{ user.email }}</td>
                            <td class="roles">
                                {% for role in user.roles %}
                                    {% if role != 'ROLE_USER' %}
                                        <span class="badge bg-primary bg-opacity-75 me-1 mb-1">{{ role|replace({'ROLE_': ''}) }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge bg-secondary text-muted">Utilisateur</span>
                                {% endfor %}
                            </td>
                            <td>
                                {% if user.banUntil and user.banUntil > date() %}
                                    <span class="badge bg-danger">
                                        <i class="bi bi-ban me-1"></i>Banni jusqu'au {{ user.banUntil|date('d/m/Y') }}
                                    </span>
                                {% elseif user.isActive %}
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i>Actif
                                    </span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-x-circle me-1"></i>Inactif
                                    </span>
                                {% endif %}
                                {% if user.reports > 0 %}
                                    <span class="badge bg-danger ms-1" title="Signalements">
                                        <i class="bi bi-flag-fill"></i> {{ user.reports }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm" role="group">
                                    <!-- Voir -->
                                    <a href="{{ path('admin_user_show', {'id': user.id}) }}"
                                       class="btn btn-sm btn-outline-info"
                                       title="Voir les détails">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    
                                    <!-- Éditer -->
                                    <a href="{{ path('admin_user_edit', {'id': user.id}) }}"
                                       class="btn btn-sm btn-outline-warning"
                                       title="Modifier">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    
                                    <!-- Activer/Désactiver -->
                                    <button class="btn btn-sm {{ user.isActive ? 'btn-outline-secondary' : 'btn-outline-success' }}"
                                            type="button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#toggleActiveModal{{ user.id }}"
                                            title="{{ user.isActive ? 'Désactiver' : 'Activer' }}">
                                        <i class="bi bi-{{ user.isActive ? 'toggle-off' : 'toggle-on' }}"></i>
                                    </button>
                                    
                                    <!-- Bannir/Débannir -->
                                    {% if user.banUntil and user.banUntil > date() %}
                                        <form method="post"
                                              action="{{ path('admin_user_unban', {'id': user.id}) }}"
                                              class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('unban' ~ user.id) }}">
                                            <button class="btn btn-sm btn-outline-success"
                                                    type="submit"
                                                    title="Débannir">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        </form>
                                    {% else %}
                                        <button class="btn btn-sm btn-outline-danger"
                                                type="button"
                                                title="Bannir"
                                                data-bs-toggle="modal"
                                                data-bs-target="#banModal{{ user.id }}"
                                                data-user-id="{{ user.id }}"
                                                data-user-name="{{ user.name }}">
                                            <i class="bi bi-ban"></i>
                                        </button>
                                    {% endif %}
                                    
                                    <!-- Supprimer -->
                                    <button class="btn btn-sm btn-outline-danger"
                                            type="button"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal{{ user.id }}"
                                            title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-secondary">
                                <i class="bi bi-search fs-1 d-block mb-2"></i>
                                Aucun utilisateur trouvé
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modaux de bannissement -->
    {% for user in pagination %}
        {% if not (user.banUntil and user.banUntil > date()) %}
        <div class="modal fade" id="banModal{{ user.id }}" tabindex="-1" aria-labelledby="banModalLabel{{ user.id }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark border-danger">
                    <div class="modal-header border-danger border-opacity-25">
                        <h5 class="modal-title text-white" id="banModalLabel{{ user.id }}">
                            <i class="bi bi-ban me-2 text-danger"></i>Bannir {{ user.name }}
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form method="post" action="{{ path('admin_user_ban', {'id': user.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('ban' ~ user.id) }}">
                        
                        <div class="modal-body">
                            <p class="text-white-50 mb-3">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                Choisissez la durée du bannissement pour <strong class="text-white">{{ user.name }}</strong>
                            </p>

                            <!-- Durées prédéfinies -->
                            <div class="mb-3">
                                <label class="form-label text-white fw-semibold">Durée prédéfinie</label>
                                <div class="d-grid gap-2">
                                    <button type="button" class="btn btn-outline-warning ban-duration-btn" data-duration="1">
                                        <i class="bi bi-clock me-2"></i>1 jour
                                    </button>
                                    <button type="button" class="btn btn-outline-warning ban-duration-btn" data-duration="7">
                                        <i class="bi bi-clock me-2"></i>7 jours
                                    </button>
                                    <button type="button" class="btn btn-outline-warning ban-duration-btn" data-duration="30">
                                        <i class="bi bi-clock me-2"></i>30 jours
                                    </button>
                                    <button type="button" class="btn btn-outline-danger ban-duration-btn" data-duration="permanent">
                                        <i class="bi bi-ban me-2"></i>Permanent
                                    </button>
                                </div>
                            </div>

                            <div class="text-center text-white-50 my-3">
                                <small>— OU —</small>
                            </div>

                            <!-- Date personnalisée -->
                            <div class="mb-3">
                                <label for="customBanDate{{ user.id }}" class="form-label text-white fw-semibold">
                                    <i class="bi bi-calendar-event me-2"></i>Date personnalisée
                                </label>
                                <input type="datetime-local" 
                                       class="form-control bg-dark text-white border-danger border-opacity-50" 
                                       id="customBanDate{{ user.id }}" 
                                       name="custom_ban_date"
                                       min="{{ 'now'|date('Y-m-d\\TH:i') }}">
                                <small class="text-white-50">Bannir jusqu'à une date précise</small>
                            </div>

                            <input type="hidden" name="ban_duration" id="banDuration{{ user.id }}">
                        </div>

                        <div class="modal-footer border-danger border-opacity-25">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                <i class="bi bi-x-circle me-1"></i>Annuler
                            </button>
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-ban me-1"></i>Confirmer le ban
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        {% endif %}

        {# Modal de confirmation pour activer/désactiver #}
        <div class="modal fade" id="toggleActiveModal{{ user.id }}" tabindex="-1" aria-labelledby="toggleActiveModalLabel{{ user.id }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark border-warning">
                    <div class="modal-header border-warning border-opacity-25">
                        <h5 class="modal-title text-white" id="toggleActiveModalLabel{{ user.id }}">
                            <i class="bi bi-{{ user.isActive ? 'toggle-off' : 'toggle-on' }} me-2 text-warning"></i>
                            {{ user.isActive ? 'Désactiver' : 'Activer' }} le compte
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center mb-3">
                            <i class="bi bi-{{ user.isActive ? 'person-x' : 'person-check' }} text-warning" style="font-size: 4rem;"></i>
                        </div>
                        <p class="text-white text-center mb-3">
                            {% if user.isActive %}
                                Êtes-vous sûr de vouloir <strong class="text-warning">désactiver</strong> le compte de<br>
                                <strong class="fs-5">{{ user.name }}</strong> ?
                            {% else %}
                                Êtes-vous sûr de vouloir <strong class="text-success">activer</strong> le compte de<br>
                                <strong class="fs-5">{{ user.name }}</strong> ?
                            {% endif %}
                        </p>
                        <div class="alert alert-warning bg-opacity-10 border-warning border-opacity-50">
                            <small>
                                <i class="bi bi-info-circle me-1"></i>
                                {% if user.isActive %}
                                    L'utilisateur ne pourra plus se connecter après désactivation.
                                {% else %}
                                    L'utilisateur pourra à nouveau se connecter après activation.
                                {% endif %}
                            </small>
                        </div>
                    </div>
                    <div class="modal-footer border-warning border-opacity-25">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>Annuler
                        </button>
                        <form method="post" action="{{ path('admin_user_toggle_active', {'id': user.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('toggle-active' ~ user.id) }}">
                            <button type="submit" class="btn btn-{{ user.isActive ? 'warning' : 'success' }}">
                                <i class="bi bi-check-circle me-1"></i>
                                Confirmer {{ user.isActive ? 'la désactivation' : 'l\'activation' }}
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        {# Modal de confirmation pour suppression #}
        <div class="modal fade" id="deleteModal{{ user.id }}" tabindex="-1" aria-labelledby="deleteModalLabel{{ user.id }}" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content bg-dark border-danger">
                    <div class="modal-header border-danger border-opacity-25">
                        <h5 class="modal-title text-white" id="deleteModalLabel{{ user.id }}">
                            <i class="bi bi-trash-fill me-2 text-danger"></i>Supprimer l'utilisateur
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center mb-3">
                            <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size: 4rem;"></i>
                        </div>
                        <p class="text-white text-center mb-3">
                            Êtes-vous sûr de vouloir <strong class="text-danger">supprimer définitivement</strong><br>
                            <strong class="fs-5">{{ user.name }}</strong> ?
                        </p>
                        <div class="alert alert-danger bg-opacity-10 border-danger border-opacity-50">
                            <small>
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                <strong>Attention :</strong> Cette action est <strong>irréversible</strong>. 
                                Toutes les données de l'utilisateur (posts, commentaires, abonnements, etc.) seront perdues.
                            </small>
                        </div>
                        <p class="text-white-50 text-center mb-0">
                            <small>Email : {{ user.email }}</small>
                        </p>
                    </div>
                    <div class="modal-footer border-danger border-opacity-25">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i>Annuler
                        </button>
                        <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" class="d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash-fill me-1"></i>
                                Oui, supprimer définitivement
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}

    <!-- Pagination -->
    <div class="knp-pagination-wrapper">
        <span class="knp-pagination-info">
            {% set pageStart = (pagination.currentPageNumber - 1) * pagination.itemNumberPerPage + 1 %}
            {% set pageEnd   = min(pagination.currentPageNumber * pagination.itemNumberPerPage, pagination.getTotalItemCount) %}
            Affichage de <strong style="color:#a78bfa">{{ pageStart }}</strong>
            à <strong style="color:#a78bfa">{{ pageEnd }}</strong>
            sur <strong style="color:#a78bfa">{{ pagination.getTotalItemCount }}</strong> utilisateurs
        </span>
        {{ knp_pagination_render(pagination) }}
    </div>

</div>

<!-- JavaScript pour recherche, filtre et tri côté client -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const filterRole  = document.getElementById('filterRole');
    const filterStatus = document.getElementById('filterStatus');
    const sortName    = document.getElementById('sortName');
    const table       = document.getElementById('usersTable');
    const tbody       = table.querySelector('tbody');
    const rows        = Array.from(tbody.querySelectorAll('tr:not(:has(td[colspan]))'));

    function filterAndSort() {
        const searchText = searchInput.value.toLowerCase().trim();
        const selectedRole = filterRole.value;
        const selectedStatus = filterStatus.value;
        const sortOrder  = sortName.value;

        let filteredRows = rows.filter(row => {
            const name  = row.querySelector('.name')?.textContent.toLowerCase() || '';
            const email = row.querySelector('.email')?.textContent.toLowerCase() || '';
            const roles = row.dataset.roles || '';
            const status = row.dataset.status || '';

            const matchesSearch = name.includes(searchText) || email.includes(searchText);
            const matchesRole   = !selectedRole || roles.includes(selectedRole);
            const matchesStatus = !selectedStatus || status === selectedStatus;

            return matchesSearch && matchesRole && matchesStatus;
        });

        // Tri par nom
        if (sortOrder === 'asc' || sortOrder === 'desc') {
            filteredRows.sort((a, b) => {
                const nameA = a.querySelector('.name')?.textContent.trim().toLowerCase() || '';
                const nameB = b.querySelector('.name')?.textContent.trim().toLowerCase() || '';
                return sortOrder === 'asc' 
                    ? nameA.localeCompare(nameB)
                    : nameB.localeCompare(nameA);
            });
        }

        // Affichage
        tbody.innerHTML = '';
        filteredRows.forEach(row => tbody.appendChild(row));

        // Message aucun résultat
        if (filteredRows.length === 0 && rows.length > 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-5 text-secondary">
                        <i class="bi bi-search fs-1 d-block mb-2"></i>
                        Aucun utilisateur ne correspond à votre recherche
                    </td>
                </tr>
            `;
        }
    }

    searchInput.addEventListener('input', filterAndSort);
    filterRole.addEventListener('change', filterAndSort);
    filterStatus.addEventListener('change', filterAndSort);
    sortName.addEventListener('change', filterAndSort);

    // === Gestion des modaux de bannissement ===
    document.querySelectorAll('.ban-duration-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            const duration = this.dataset.duration;
            const modal = this.closest('.modal');
            const banDurationInput = modal.querySelector('input[name="ban_duration"]');
            const customDateInput = modal.querySelector('input[name="custom_ban_date"]');
            
            // Mettre à jour le champ caché avec la durée
            banDurationInput.value = duration;
            
            // Effacer la date personnalisée
            customDateInput.value = '';
            
            // Mettre en évidence le bouton sélectionné
            modal.querySelectorAll('.ban-duration-btn').forEach(b => {
                b.classList.remove('active', 'btn-warning', 'btn-danger');
                b.classList.add('btn-outline-warning');
                if (b.dataset.duration === 'permanent') {
                    b.classList.remove('btn-outline-warning');
                    b.classList.add('btn-outline-danger');
                }
            });
            
            this.classList.remove('btn-outline-warning', 'btn-outline-danger');
            this.classList.add('active');
            if (duration === 'permanent') {
                this.classList.add('btn-danger');
            } else {
                this.classList.add('btn-warning');
            }
        });
    });

    // Réinitialiser le formulaire lors de la fermeture du modal
    document.querySelectorAll('[id^="banModal"]').forEach(modal => {
        modal.addEventListener('hidden.bs.modal', function() {
            this.querySelector('input[name="ban_duration"]').value = '';
            this.querySelector('input[name="custom_ban_date"]').value = '';
            this.querySelectorAll('.ban-duration-btn').forEach(btn => {
                btn.classList.remove('active', 'btn-warning', 'btn-danger');
                btn.classList.add('btn-outline-warning');
                if (btn.dataset.duration === 'permanent') {
                    btn.classList.remove('btn-outline-warning');
                    btn.classList.add('btn-outline-danger');
                }
            });
        });
    });

    // Effacer la durée prédéfinie si une date personnalisée est saisie
    document.querySelectorAll('input[name="custom_ban_date"]').forEach(input => {
        input.addEventListener('input', function() {
            if (this.value) {
                const modal = this.closest('.modal');
                modal.querySelector('input[name="ban_duration"]').value = '';
                modal.querySelectorAll('.ban-duration-btn').forEach(btn => {
                    btn.classList.remove('active', 'btn-warning', 'btn-danger');
                    btn.classList.add('btn-outline-warning');
                    if (btn.dataset.duration === 'permanent') {
                        btn.classList.remove('btn-outline-warning');
                        btn.classList.add('btn-outline-danger');
                    }
                });
            }
        });
    });
});
</script>
{% endblock %}