{# templates/admin/user_abonnement/_form.html.twig #}
{{ form_start(form) }}

<script>
    $(document).ready(function () {
        $('.select2').select2({
            style: 'text-white bg-dark border-secondary border-opacity-50',
            width: '100%'
        });
    });
</script>


<div class="card bg-dark border-primary border-opacity-25 shadow-lg rounded-4">
    <div class="card-body p-4">
        <div class="row g-4">

            {# Date Début #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.dateDebut, 'Date de début', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    {{ form_widget(form.dateDebut, {
                        'attr': {
                            'class': 'form-control bg-dark text-white border-secondary border-opacity-50'
                        }
                    }) }}
                    {{ form_errors(form.dateDebut, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

            {# Date Fin #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.dateFin, 'Date de fin', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    {{ form_widget(form.dateFin, {
                        'attr': {
                            'class': 'form-control bg-dark text-white border-secondary border-opacity-50'
                        }
                    }) }}
                    {{ form_errors(form.dateFin, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

            {# Utilisateur associé avec Select2 #}
            <div class="col-md-6">
                 <div class="mb-3">
                    {{ form_label(form.user, 'Utilisateurs', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    <div class="input-group">
                        
                        {{ form_widget(form.user, {
                            'attr': {
                                'class': 'form-select select2 bg-dark text-white border-secondary border-opacity-50'
                            }
                        }) }}
                    </div>
                    {{ form_errors(form.user, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

            {# Type d'Abonnement avec Select2 #}
            <div class="col-md-6">
                <div class="mb-3 text-white">
                    {{ form_label(form.abonnement, 'Type d\'offre', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    {{ form_widget(form.abonnement, {
                        'attr': {
                            'class': 'form-select select2 bg-dark text-white border-secondary border-opacity-50'
                        }
                    }) }}
                    {{ form_errors(form.abonnement, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

        </div>
    </div>

    {# Footer avec actions #}
    <div class="card-footer bg-black bg-opacity-25 border-top border-secondary border-opacity-10 p-3">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('app_user_abonnement_index') }}" class="btn btn-link text-secondary text-decoration-none">
                <i class="bi bi-x-circle me-1"></i> Annuler
            </a>
            <button type="submit" class="btn btn-primary px-5 shadow">
                <i class="bi bi-save-fill me-2"></i> {{ button_label|default('Enregistrer l\'abonnement') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}