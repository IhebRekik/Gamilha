{% extends 'base_front.html.twig' %}

{% block title %}Erreur d'abonnement{% endblock %}

{% block body %}
<div class="container d-flex justify-content-center align-items-center vh-100">
    <div class="card shadow-lg border-0 rounded-4 text-center p-4" style="max-width: 450px;">
        
        <div class="mb-3">
            <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center"
                 style="width: 80px; height: 80px;">
                <i class="bi bi-exclamation-triangle-fill fs-1"></i>
            </div>
        </div>

        <h3 class="fw-bold text-danger">Abonnement déjà souscrit</h3>

        <p class="text-muted mt-3">
            Vous avez déjà souscrit à cet abonnement.  
            Il n'est pas possible de souscrire une deuxième fois.
        </p>

        <div class="mt-4">
            <a href="{{ path('app_homepage') }}" class="btn btn-primary rounded-pill px-4">
                Retour à l'accueil
            </a>
        </div>

    </div>
</div>
{% endblock %}