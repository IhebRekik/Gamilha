{% extends 'base.html.twig' %}

{% block title %}Gamelha - Abonnements utilisateurs{% endblock %}

{% block body %}
<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-white">
            <i class="bi bi-credit-card-2-front-fill text-primary me-2"></i>
            Abonnements des utilisateurs
        </h1>

        <a href="{{ path('app_user_abonnement_new') }}" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nouvel abonnement
        </a>
    </div>

    <div class="card bg-dark border-0 shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-secondary text-uppercase small border-bottom border-primary border-opacity-25">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Date début</th>
                            <th>Date fin</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                    {% for ua in user_abonnements %}
                        <tr class="border-bottom border-secondary border-opacity-10">
                            <td class="ps-4 text-secondary">#{{ ua.id }}</td>

                            <td>
                                <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25 px-3 py-2">
                                    <i class="bi bi-calendar-check me-1"></i>
                                    {{ ua.dateDebut ? ua.dateDebut|date('d/m/Y') : '—' }}
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-25 px-3 py-2">
                                    <i class="bi bi-calendar-x me-1"></i>
                                    {{ ua.dateFin ? ua.dateFin|date('d/m/Y') : '—' }}
                                </span>
                            </td>

                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm">
                                    <a href="{{ path('app_user_abonnement_show', {'id': ua.id}) }}"
                                       class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <a href="{{ path('app_user_abonnement_edit', {'id': ua.id}) }}"
                                       class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center py-5 text-secondary">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Aucun abonnement utilisateur trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>
{% endblock %}
