{# templates/admin/user_abonnement/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Gamelha - Abonnement Utilisateur{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('app_user_abonnement_index') }}" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="text-white h3 mb-0">Détails de l'abonnement utilisateur</h1>
    </div>

    <div >
        <div =>
            <div class="card bg-dark border border-primary border-opacity-25 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark border-bottom border-secondary border-opacity-10 py-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                            <i class="bi bi-person-fill text-white fs-5"></i>
                        </div>
                        <div>
                            <h6 class="text-white mb-0">{{ user_abonnement.user.name }}</h6>
                            <small class="text-secondary">Abonnement ID: <span class="text-info">{{ user_abonnement.id }}</span></small>
                        </div>
                    </div>
                </div>

                <div class="card-body py-4 text-white">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Utilisateur</dt>
                        <dd class="col-sm-8">{{ user_abonnement.user.name }}</dd>
                        <dt class="col-sm-4">Abonnement</dt>
                        <dd class="col-sm-8">{{ user_abonnement.abonnement.type }}</dd>
                        
                         <dt class="col-sm-4">Date de fin</dt>
                        <dd class="col-sm-8">{{ user_abonnement.dateFin ? user_abonnement.dateFin|date('d/m/Y H:i') : '—' }}</dd>
                         <dt class="col-sm-4">Date de fin</dt>
                        <dd class="col-sm-8">{{ user_abonnement.dateFin ? user_abonnement.dateFin|date('d/m/Y H:i') : '—' }}</dd>
                    </dl>
                </div>

                <div class="card-footer bg-dark border-top border-secondary border-opacity-10 py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="{{ path('app_user_abonnement_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left-circle-fill me-2"></i>Retour à la liste
                        </a>

                        <div class="d-flex">
                            <a href="{{ path('app_user_abonnement_edit', {'id': user_abonnement.id}) }}" class="btn btn-warning me-2">
                                <i class="bi bi-pencil-fill me-1"></i>Modifier
                            </a>
                            {{ include('admin/user_abonnement/_delete_form.html.twig') }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
