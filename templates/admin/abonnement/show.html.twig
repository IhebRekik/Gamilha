{% extends 'base.html.twig' %}

{% block title %}Gamelha - Détails Abonnement{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('app_abonnement_index') }}" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="text-white h3 mb-0">Détails de l'Abonnement</h1>
    </div>

    <div >
        <div >
            <div class="card bg-dark border border-primary border-opacity-25 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body py-4">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-white">ID</dt>
                        <dd class="col-sm-8 text-white">{{ abonnement.id }}</dd>

                        <dt class="col-sm-4 text-white">Type</dt>
                        <dd class="col-sm-8 text-white">{{ abonnement.type }}</dd>
                        <dt class="col-sm-4 text-white">Prix</dt>
                        <dd class="col-sm-8 text-white">{{ abonnement.prix }} TND</dd>
                    </dl>
                </div>

                <div class="card-footer bg-dark border-top border-secondary border-opacity-10 d-flex justify-content-between">
                    <a href="{{ path('app_abonnement_index') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left-circle-fill me-2"></i>Retour
                    </a>

                    <div class="d-flex">
                        <a href="{{ path('app_abonnement_edit', {'id': abonnement.id}) }}" class="btn btn-warning me-2">
                            <i class="bi bi-pencil-fill me-1"></i>Modifier
                        </a>
                        {{ include('admin/abonnement/_delete_form.html.twig') }}
                    </div>
                </div>
            </div>
        </div>

       
    </div>
</div>
{% endblock %}
