{{ form_start(form) }}

<div class="card bg-dark border-primary border-opacity-25 shadow-lg rounded-4">
    <div class="card-body p-4">
        <div class="row g-4">

            {# Type d’abonnement #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.type, 'Type d’abonnement', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}

                    <div class="input-group">
                        <span class="input-group-text bg-primary border-0 text-white">
                            <i class="bi bi-bookmark-star-fill"></i>
                        </span>

                        {{ form_widget(form.type, {
                            'attr': {
                                'class': 'form-control bg-dark text-white border-secondary border-opacity-50',
                                'placeholder': 'Ex : Premium, Gold, Basic...'
                            }
                        }) }}
                    </div>

                    {{ form_errors(form.type, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>
              <div class="mb-3">
                    {{ form_label(form.prix, 'Prix de l’abonnement', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}

                    <div class="input-group">
                        <span class="input-group-text bg-primary border-0 text-white">
                            <i class="bi bi-bookmark-star-fill"></i>
                        </span>

                        {{ form_widget(form.prix, {
                            'attr': {
                                'class': 'form-control bg-dark text-white border-secondary border-opacity-50',
                                'placeholder': 'Ex : 10TND, 20TND...'
                            }
                        }) }}
                    </div>

                    {{ form_errors(form.prix, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

        </div>
    </div>

    {# Actions #}
    <div class="card-footer bg-black bg-opacity-25 border-top border-secondary border-opacity-10 p-3">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('app_abonnement_index') }}"
               class="btn btn-link text-secondary text-decoration-none">
                <i class="bi bi-x-circle me-1"></i> Annuler
            </a>

            <button type="submit" class="btn btn-primary px-5 shadow">
                <i class="bi bi-save-fill me-2"></i>
                {{ button_label|default('Enregistrer') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}
