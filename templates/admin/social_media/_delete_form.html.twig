<form method="post" action="{{ path('admin_social_media_delete', {'id': social_media.id}) }}" onsubmit="return confirm('Voulez-vous vraiment supprimer cet élément de Gamelha ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ social_media.id) }}">
    <button class="btn btn-outline-danger w-100">
        <i class="bi bi-trash3 me-2"></i> Supprimer définitivement
    </button>
</form>