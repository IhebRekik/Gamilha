{% extends 'base.html.twig' %}

{% block title %}Gamelha - {{ social_media.platform }} Post{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('admin_social_media_index') }}" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="text-white h3 mb-0">Vue détaillée du Post</h1>
    </div>

    <div class="row">
        <div class="col-lg-8">
            {# "Mockup" du post social #}
            <div class="card bg-dark border border-primary border-opacity-25 shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-dark border-bottom border-secondary border-opacity-10 py-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                            <i class="bi bi-person-fill text-white fs-5"></i>
                        </div>
                        <div>
                            <h6 class="text-white mb-0">Administrateur Gamelha</h6>
                            <small class="text-secondary">Posté sur <span class="text-info">{{ social_media.platform }}</span></small>
                        </div>
                    </div>
                </div>
                
                <div class="card-body py-4">
                    <p class="text-white fs-5 lh-base">
                        {{ social_media.content|nl2br }}
                    </p>
                </div>

                <div class="card-footer bg-dark border-top border-secondary border-opacity-10 py-3">
                    <div class="d-flex align-items-center text-secondary">
                        <div class="me-4">
                            <i class="bi bi-heart-fill text-danger me-2"></i>
                            <span class="text-white fw-bold">{{ social_media.likes }}</span> <small>Likes</small>
                        </div>
                        <div>
                            <i class="bi bi-hash text-primary me-1"></i>
                            <small>ID: {{ social_media.id }}</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Barre latérale d'actions #}
        <div class="col-lg-4">
            <div class="card bg-dark border-0 shadow-sm rounded-4 p-3">
                <h5 class="text-white mb-3 small text-uppercase fw-bold opacity-50">Actions d'administration</h5>
                
                <a href="{{ path('admin_social_media_edit', {'id': social_media.id}) }}" class="btn btn-warning w-100 mb-2">
                    <i class="bi bi-pencil-square me-2"></i> Modifier le contenu
                </a>

                <div class="mt-2">
                    {{ include('admin/social_media/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}