{# templates/admin/social_media/_form.html.twig #}
{{ form_start(form) }}

<div class="card bg-dark border-primary border-opacity-25 shadow-lg rounded-4">
    <div class="card-body p-4">
        <div class="row g-4">
            
            {# Sélection de la Plateforme #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.platform, 'Plateforme de diffusion', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    <div class="input-group">
                        <span class="input-group-text bg-primary border-0 text-white">
                            <i class="bi bi-broadcast"></i>
                        </span>
                        {{ form_widget(form.platform, {
                            'attr': {
                                'class': 'form-select bg-dark text-white border-secondary border-opacity-50',
                                'placeholder': 'Choisir le réseau...'
                            }
                        }) }}
                    </div>
                    {{ form_errors(form.platform, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

            {# Nombre de Likes (Initial ou de départ) #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.likes, 'Engagement (Likes)', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    <div class="input-group">
                        <span class="input-group-text bg-danger border-0 text-white">
                            <i class="bi bi-heart"></i>
                        </span>
                        {{ form_widget(form.likes, {
                            'attr': {
                                'class': 'form-control bg-dark text-white border-secondary border-opacity-50'
                            }
                        }) }}
                    </div>
                    {{ form_errors(form.likes) }}
                </div>
            </div>

            {# Contenu du Message #}
            <div class="col-12">
                <div class="mb-3">
                    {{ form_label(form.content, 'Contenu du Post', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    {{ form_widget(form.content, {
                        'attr': {
                            'class': 'form-control bg-dark text-white border-primary border-opacity-25',
                            'rows': '5',
                            'placeholder': 'Écrivez votre message ici...'
                        }
                    }) }}
                    {{ form_errors(form.content) }}
                </div>
            </div>

        </div>
    </div>

    {# Barre d'actions #}
    <div class="card-footer bg-black bg-opacity-25 border-top border-secondary border-opacity-10 p-3">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('admin_social_media_index') }}" class="btn btn-link text-secondary text-decoration-none">
                <i class="bi bi-x-circle me-1"></i> Annuler
            </a>
            <button type="submit" class="btn btn-primary px-5 shadow">
                <i class="bi bi-send-fill me-2"></i>
                {{ button_label|default('Publier / Enregistrer') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}
