{% extends 'base.html.twig' %}

{% block title %}Gamilha - Brackets{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-white">
            <i class="bi bi-diagram-3-fill text-primary me-2"></i>Gestion des brackets
        </h1>
        <a href="{{ path('admin_bracket_new') }}" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nouveau bracket
        </a>
    </div>

    <div class="card bg-dark border-0 shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-secondary text-uppercase small border-bottom border-primary border-opacity-25">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Type</th>
                            <th>Nombre de tours</th>
                            <th>Statut</th>
                            <th>Événement</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for bracket in brackets %}
                        <tr class="border-bottom border-secondary border-opacity-10">
                            <td class="ps-4 text-secondary">#{{ bracket.idBracket }}</td>
                            <td class="fw-semibold text-white">{{ bracket.typeBracket }}</td>
                            <td><span class="badge bg-info px-3 py-2">{{ bracket.nombreTours }}</span></td>
                            <td><span class="badge bg-secondary px-3 py-2">{{ bracket.statut }}</span></td>
                            <td class="text-white">{{ bracket.evenement ? bracket.evenement.nom : '—' }}</td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm">
                                    <a href="{{ path('admin_bracket_show', {'idBracket': bracket.idBracket}) }}" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                    <a href="{{ path('admin_bracket_edit', {'idBracket': bracket.idBracket}) }}" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                                    <form method="post" action="{{ path('admin_bracket_delete', {'idBracket': bracket.idBracket}) }}" onsubmit="return confirm('Confirmer la suppression ?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ bracket.idBracket) }}">
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5 text-secondary">
                                <i class="bi bi-diagram-3 fs-1 d-block mb-2"></i>
                                Aucun bracket trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
