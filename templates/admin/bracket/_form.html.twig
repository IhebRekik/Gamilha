{{ form_start(form) }}
<div class="card bg-dark border-primary border-opacity-25 shadow-lg rounded-4">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.typeBracket, null, {'label_attr': {'class': 'form-label text-white fw-semibold'}}) }}
                    {{ form_widget(form.typeBracket, {'attr': {'class': 'form-control bg-dark text-white border-secondary border-opacity-50', 'placeholder': 'Ex : Simple élimination'}}) }}
                    {{ form_errors(form.typeBracket, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.nombreTours, null, {'label_attr': {'class': 'form-label text-white fw-semibold'}}) }}
                    {{ form_widget(form.nombreTours, {'attr': {'class': 'form-control bg-dark text-white border-secondary border-opacity-50'}}) }}
                    {{ form_errors(form.nombreTours, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.statut, null, {'label_attr': {'class': 'form-label text-white fw-semibold'}}) }}
                    {{ form_widget(form.statut, {'attr': {'class': 'form-control bg-dark text-white border-secondary border-opacity-50', 'placeholder': 'Ex : En cours'}}) }}
                    {{ form_errors(form.statut, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.evenement, null, {'label_attr': {'class': 'form-label text-white fw-semibold'}}) }}
                    {{ form_widget(form.evenement, {'attr': {'class': 'form-select bg-dark text-white border-secondary border-opacity-50'}}) }}
                    {{ form_errors(form.evenement, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer bg-black bg-opacity-25 border-top border-secondary border-opacity-10 p-3">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('admin_bracket_index') }}" class="btn btn-link text-secondary text-decoration-none"><i class="bi bi-x-circle me-1"></i> Annuler</a>
            <button type="submit" class="btn btn-primary px-5 shadow"><i class="bi bi-save-fill me-2"></i>{{ button_label|default('Enregistrer') }}</button>
        </div>
    </div>
</div>
{{ form_end(form) }}
