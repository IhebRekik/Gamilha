<form method="post" action="{{ path('admin_match_delete', {'idMatch': match.idMatch}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce match ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ match.idMatch) }}">
    <button class="btn btn-outline-danger w-100"><i class="bi bi-trash3 me-2"></i>Supprimer définitivement</button>
</form>
