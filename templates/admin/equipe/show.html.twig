{% extends 'base.html.twig' %}
{% block title %}Gamilha - Détails de l'équipe{% endblock %}
{% block body %}
<div class="container py-5">
    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('admin_equipe_index') }}" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i></a>
        <h1 class="text-white h3 mb-0">Détails de l'équipe</h1>
    </div>
    <div class="card bg-dark border border-primary border-opacity-25 shadow-lg rounded-4 overflow-hidden">
        <div class="card-body py-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-white">ID Équipe</dt>
                <dd class="col-sm-8 text-white">{{ equipe.idEquipe }}</dd>
                <dt class="col-sm-4 text-white">Nom</dt>
                <dd class="col-sm-8 text-white">{{ equipe.nomEquipe }}</dd>
                <dt class="col-sm-4 text-white">Tag</dt>
                <dd class="col-sm-8 text-white">{{ equipe.tag ?? '—' }}</dd>
                <dt class="col-sm-4 text-white">Logo</dt>
                <dd class="col-sm-8 text-white">{{ equipe.logo ?? '—' }}</dd>
                <dt class="col-sm-4 text-white">Pays</dt>
                <dd class="col-sm-8 text-white">{{ equipe.pays ?? '—' }}</dd>
                <dt class="col-sm-4 text-white">Date création</dt>
                <dd class="col-sm-8 text-white">{{ equipe.dateCreation ? equipe.dateCreation|date('d/m/Y') : '—' }}</dd>
                <dt class="col-sm-4 text-white">Niveau</dt>
                <dd class="col-sm-8 text-white">{{ equipe.niveau }}</dd>
            </dl>
        </div>
        <div class="card-footer bg-dark border-top border-secondary border-opacity-10 d-flex justify-content-between">
            <a href="{{ path('admin_equipe_index') }}" class="btn btn-secondary"><i class="bi bi-arrow-left-circle-fill me-2"></i>Retour</a>
            <div class="d-flex">
                <a href="{{ path('admin_equipe_edit', {'idEquipe': equipe.idEquipe}) }}" class="btn btn-warning me-2"><i class="bi bi-pencil-fill me-1"></i>Modifier</a>
                {{ include('admin/equipe/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
