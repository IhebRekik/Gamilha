<form method="post" action="{{ path('admin_equipe_delete', {'idEquipe': equipe.idEquipe}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette équipe ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipe.idEquipe) }}">
    <button class="btn btn-outline-danger w-100"><i class="bi bi-trash3 me-2"></i>Supprimer définitivement</button>
</form>
