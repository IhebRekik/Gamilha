{% extends 'base.html.twig' %}

{% block title %}Gamelha - Détails Équipe{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('admin_team_index') }}" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="text-white h3 mb-0">Détails de l'équipe</h1>
    </div>

    <div class="card bg-dark border border-primary border-opacity-25 shadow-lg rounded-4 overflow-hidden">
        <div class="card-body py-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-white">ID</dt>
                <dd class="col-sm-9 text-white">{{ team.id }}</dd>

                <dt class="col-sm-3 text-white">Nom</dt>
                <dd class="col-sm-9 text-white">{{ team.name }}</dd>

                <dt class="col-sm-3 text-white">Membres</dt>
                <dd class="col-sm-9">
                    {% if team.members|length > 0 %}
                        <ul class="list-group list-group-flush">
                            {% for member in team.members %}
                                <li class="list-group-item bg-dark text-white border-secondary d-flex align-items-center">
                                    <i class="bi bi-person-fill me-2"></i> {{ member.name }}
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <span class="text-secondary">Aucun membre</span>
                    {% endif %}
                </dd>
            </dl>
        </div>

        <div class="card-footer bg-dark border-top border-secondary border-opacity-10 d-flex justify-content-between">
            <a href="{{ path('admin_team_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle-fill me-2"></i>Retour
            </a>

            <div class="d-flex">
                <a href="{{ path('admin_team_edit', {'id': team.id}) }}" class="btn btn-warning me-2">
                    <i class="bi bi-pencil-fill me-1"></i>Modifier
                </a>
                {{ include('admin/team/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
