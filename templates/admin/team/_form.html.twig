{{ form_start(form) }}

<script>
    $(document).ready(function () {
        $('.select2').select2({
            placeholder: 'Rechercher un membre...',
            width: '100%'
        });
    });
</script>

<div class="card bg-dark border-primary border-opacity-25 shadow-lg rounded-4">
    <div class="card-body p-4">
        <div class="row g-4">

            {# Nom de l'équipe #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.name, null, {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    {{ form_widget(form.name, {
                        'attr': {
                            'class': 'form-control bg-dark text-white border-secondary border-opacity-50',
                            'placeholder': 'Entrez le nom de l’équipe'
                        }
                    }) }}
                    {{ form_errors(form.name, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

            {# Membres avec Select2 #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.members, 'Membres', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}
                    <div class="input-group">
                        
                        {{ form_widget(form.members, {
                            'attr': {
                                'class': 'form-select select2 bg-dark text-white border-secondary border-opacity-50'
                            }
                        }) }}
                    </div>
                    {{ form_errors(form.members, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

        </div>
    </div>

    {# Footer avec actions #}
    <div class="card-footer bg-black bg-opacity-25 border-top border-secondary border-opacity-10 p-3">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('admin_team_index') }}" class="btn btn-link text-secondary text-decoration-none">
                <i class="bi bi-x-circle me-1"></i> Annuler
            </a>
            <button type="submit" class="btn btn-primary px-5 shadow">
                <i class="bi bi-save-fill me-2"></i> {{ button_label|default('Enregistrer') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}
