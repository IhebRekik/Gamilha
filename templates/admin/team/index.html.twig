<!-- JavaScript pour recherche, filtre et tri -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput   = document.getElementById('searchInput');
    const filterMembers = document.getElementById('filterMembers');
    const sortMembers   = document.getElementById('sortMembers');
    const table         = document.getElementById('teamsTable');
    const tbody         = table.querySelector('tbody');
    const rows          = Array.from(tbody.querySelectorAll('tr:not(:has(td[colspan]))'));

    function filterAndSort() {
        const searchText = searchInput.value.toLowerCase().trim();
        const minMembers = parseInt(filterMembers.value) || 0;
        const sortOrder  = sortMembers.value;

        // Filtrer
        let filteredRows = rows.filter(row => {
            const name = row.querySelector('.name')?.textContent.toLowerCase() || '';
            const membersCount = parseInt(row.querySelector('.members')?.dataset.members || 0);

            const matchesSearch = name.includes(searchText);
            const matchesMinMembers = membersCount >= minMembers;

            return matchesSearch && matchesMinMembers;
        });

        // Trier
        if (sortOrder === 'asc' || sortOrder === 'desc') {
            filteredRows.sort((a, b) => {
                const aCount = parseInt(a.querySelector('.members')?.dataset.members || 0);
                const bCount = parseInt(b.querySelector('.members')?.dataset.members || 0);
                return sortOrder === 'asc' ? aCount - bCount : bCount - aCount;
            });
        }

        // Afficher
        tbody.innerHTML = '';
        filteredRows.forEach(row => tbody.appendChild(row));

        // Message aucun résultat
        if (filteredRows.length === 0 && rows.length > 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="text-center py-5 text-secondary">
                        <i class="bi bi-search fs-1 d-block mb-2"></i>
                        Aucune équipe ne correspond à votre recherche
                    </td>
                </tr>
            `;
        }
    }

    searchInput.addEventListener('input', filterAndSort);
    filterMembers.addEventListener('change', filterAndSort);
    sortMembers.addEventListener('change', filterAndSort);
});
</script>
