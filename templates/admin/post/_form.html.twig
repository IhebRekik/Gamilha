{{ form_start(form) }}

<div class="card bg-dark shadow rounded-4">
    <div class="card-body p-4">

        <div class="mb-3">
            {{ form_label(form.content, 'Contenu du post', {
                'label_attr': {'class': 'text-white fw-semibold'}
            }) }}
            {{ form_widget(form.content, {
                'attr': {
                    'class': 'form-control bg-dark text-white',
                    'rows': 5
                }
            }) }}
            {{ form_errors(form.content) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.imageFile, 'Image', {
                'label_attr': {'class': 'text-white fw-semibold'}
            }) }}
            {{ form_widget(form.imageFile, {
                'attr': {'class': 'form-control bg-dark text-white'}
            }) }}
            {{ form_errors(form.imageFile) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.mediaurl, 'Lien média', {
                'label_attr': {'class': 'text-white fw-semibold'}
            }) }}
            {{ form_widget(form.mediaurl, {
                'attr': {'class': 'form-control bg-dark text-white'}
            }) }}
            {{ form_errors(form.mediaurl) }}
        </div>

        {% if post is defined %}
            <div class="mb-3">
                <label class="text-white fw-semibold">Likes</label>
<p class="text-white">
    ❤️ {{ post.getLikesCount() }}
</p>
            </div>
        {% endif %}

    </div>

    <div class="card-footer d-flex justify-content-between">
        <a href="{{ path('admin_post_index') }}" class="btn btn-secondary">
            Annuler
        </a>
        <button class="btn btn-primary">
            {{ button_label|default('Enregistrer') }}
        </button>
    </div>
</div>

{{ form_end(form) }}
