{% extends 'base.html.twig' %}

{% block title %}Admin - Posts{% endblock %}

{% block body %}
<div class="container py-4">

    <!-- Titre -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-white">
            <i class="bi bi-card-checklist text-primary me-2"></i>
            Gestion des Posts
        </h1>

        <a href="{{ path('admin_post_new') }}" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>
            Nouveau post
        </a>
    </div>

    <!-- 🔍 Barre de recherche -->
    <div class="card bg-dark border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">

                <!-- Recherche contenu -->
                <div class="col-12 col-md-6">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-secondary border-0 text-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input
                            id="searchPostInput"
                            type="text"
                            class="form-control bg-secondary text-white border-0 shadow-none"
                            placeholder="Rechercher par contenu du post..."
                        >
                    </div>
                </div>

                <!-- Recherche utilisateur -->
                <div class="col-12 col-md-6">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-secondary border-0 text-white">
                            <i class="bi bi-person"></i>
                        </span>
                        <input
                            id="searchUserInput"
                            type="text"
                            class="form-control bg-secondary text-white border-0 shadow-none"
                            placeholder="Rechercher par utilisateur (email)"
                        >
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- 📋 Tableau -->
    <div class="card bg-dark border-0 shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-secondary text-uppercase small border-bottom border-primary border-opacity-25">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Contenu</th>
                            <th>Likes</th>
                            <th>Commentaires</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="postsTableBody">
{% for post in pagination %}
                        <tr class="post-row" data-user="{{ post.user.email|lower }}">
                            <td class="ps-4 text-secondary">#{{ post.id }}</td>
                            <td class="post-content">
                                {{ post.content|slice(0,50)|raw }}{% if post.content|length > 50 %}...{% endif %}
                            </td>
                            <td>❤️ {{ post.getLikesCount() }}</td>
                            <td>{{ post.commentaires|length }}</td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm">
                                    <a href="{{ path('admin_post_show', {'id': post.id}) }}" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="{{ path('admin_post_edit', {'id': post.id}) }}" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post"
                                          action="{{ path('admin_post_delete', {'id': post.id}) }}"
                                          onsubmit="return confirm('Confirmer la suppression ?');"
                                          class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center py-5 text-secondary">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                Aucun post trouvé
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

<div class="pagination-container">
    {{ knp_pagination_render(pagination) }}
</div>

            </div> {# fin table-responsive #}
        </div>
    </div>

</div>

<!-- ⚡ Recherche instantanée -->
<script>
document.addEventListener('DOMContentLoaded', function () {

    const postInput = document.getElementById('searchPostInput');
    const userInput = document.getElementById('searchUserInput');
    const rows = document.querySelectorAll('.post-row');

    function filterPosts() {
        const postValue = postInput.value.toLowerCase().trim();
        const userValue = userInput.value.toLowerCase().trim();

        rows.forEach(row => {
            const content = row.querySelector('.post-content')?.textContent.toLowerCase() || '';
            const user = row.dataset.user || '';

            row.style.display = (content.includes(postValue) && user.includes(userValue)) ? '' : 'none';
        });
    }

    postInput.addEventListener('input', filterPosts);
    userInput.addEventListener('input', filterPosts);
});
</script>

{% endblock %}
