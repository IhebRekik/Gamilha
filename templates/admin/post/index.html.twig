{% extends 'base.html.twig' %}

{% block title %}Admin - Posts{% endblock %}

{% block body %}
<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-white">
            <i class="bi bi-card-checklist text-primary me-2"></i>
            Gestion des Posts
        </h1>

        <a href="{{ path('admin_post_new') }}" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg me-1"></i>
            Nouveau post
        </a>
    </div>
{# ================= Search Form ================= #}
  <form method="get" action="{{ path('admin_post_index') }}" class="mb-4">
    <div class="row g-2">
        <div class="col-md-6">
            <input
                type="text"
                name="q"
                value="{{ search }}"
                class="form-control bg-dark text-white border-secondary"
                placeholder="Rechercher par contenu du post..."
            >
        </div>
        <div class="col-md-4">
            <input
                type="text"
                name="user"
                value="{{ userSearch }}"
                class="form-control bg-dark text-white border-secondary"
                placeholder="Rechercher par utilisateur..."
            >
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100">
                <i class="bi bi-search"></i> Rechercher
            </button>
        </div>
    </div>
</form>

    <div class="card bg-dark border-0 shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-secondary text-uppercase small border-bottom border-primary border-opacity-25">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Contenu</th>
                            <th>Likes</th>
                            <th>Commentaires</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for post in posts|default([]) %}
                            <tr class="border-bottom border-secondary border-opacity-10">
                                <td class="ps-4 text-secondary">#{{ post.id }}</td>
                                <td>{{ post.content|slice(0,50) ~ '...' }}</td>
                                <td>❤️ {{ post.likes }}</td>
                                <td>{{ post.commentaires|length }}</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a href="{{ path('admin_post_show', {'id': post.id}) }}" class="btn btn-sm btn-outline-info">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a href="{{ path('admin_post_edit', {'id': post.id}) }}" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form method="post" action="{{ path('admin_post_delete', {'id': post.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');" class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                            <button class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5 text-secondary">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Aucun post trouvé
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
