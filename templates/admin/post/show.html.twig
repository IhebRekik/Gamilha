{% extends 'base.html.twig' %}

{% block title %}Détails du post{% endblock %}

{% block body %}
<div class="container py-5">

    <div class="d-flex align-items-center mb-4">
        <a href="{{ path('admin_post_index') }}" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <h1 class="text-white h3 mb-0">Détails du Post #{{ post.id }}</h1>
    </div>

    <div class="card bg-dark border border-primary border-opacity-25 shadow-lg rounded-4 overflow-hidden mb-4">
        <div class="card-body py-4">
            <dl class="row mb-0">
                <dt class="col-sm-4 text-white">Contenu</dt>
                <dd class="col-sm-8 text-white">    {{ post.content|raw }}
</dd>

                {% if post.image %}
                    <dt class="col-sm-4 text-white">Image</dt>
                    <dd class="col-sm-8 text-white">
                        <img src="{{ asset('uploads/' ~ post.image) }}" alt="" class="img-fluid rounded">
                    </dd>
                {% endif %}

                {% if post.mediaurl %}
                    <dt class="col-sm-4 text-white">Lien média</dt>
                    <dd class="col-sm-8 text-white">
                        <a href="{{ post.mediaurl }}" target="_blank">{{ post.mediaurl }}</a>
                    </dd>
                {% endif %}

                <dt class="col-sm-4 text-white">Likes</dt>
                <dd class="col-sm-8 text-white">    ❤️ {{ post.getLikesCount() }}


                <dt class="col-sm-4 text-white">Nombre de commentaires</dt>
                <dd class="col-sm-8 text-white">{{ post.commentaires|length }}</dd>
            </dl>
        </div>

        <div class="card-footer bg-dark border-top border-secondary border-opacity-10 d-flex justify-content-between">
            <a href="{{ path('admin_post_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle-fill me-2"></i>Retour
            </a>

            <div class="d-flex">
             <a href="{{ path('admin_post_edit', {'id': post.id}) }}" class="btn btn-outline-primary me-2">
    <i class="bi bi-pencil-fill me-1"></i>Modifier
</a>


                <form method="post" action="{{ path('admin_post_delete', {'id': post.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');" class="d-inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                    <button class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>

    {# ================= Commentaires ================= #}
    <h5 class="text-white mb-3">Commentaires</h5>

    {% for commentaire in post.commentaires %}
        <div class="card bg-dark border border-secondary border-opacity-25 shadow-sm rounded-3 mb-2 p-2 d-flex justify-content-between align-items-center">
            <div>
                <strong class="text-primary">{{ commentaire.user.name }}</strong> : 
                <span class="text-white">{{ commentaire.text }}</span>
            </div>

            <div>
                {{ include('admin/commentaire/_delete_form.html.twig', { commentaire: commentaire }) }}
            </div>
        </div>
    {% else %}
        <p class="text-white">Aucun commentaire pour ce post.</p>
    {% endfor %}

</div>
{% endblock %}
