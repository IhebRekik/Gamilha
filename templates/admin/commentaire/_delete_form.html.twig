{# templates/admin/commentaire/_delete_form.html.twig #}
<form method="post" action="{{ path('admin_comment_delete', {'id': commentaire.id}) }}" onsubmit="return confirm('Supprimer ce commentaire ?');" class="d-inline">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commentaire.id) }}">
    <button class="btn btn-sm btn-danger">
        <i class="bi bi-trash"></i>
    </button>
</form>
