                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- JavaScript pour le filtrage et tri -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const filterGame = document.getElementById('filterGame');
    const sortDate = document.getElementById('sortDate');
    const table = document.getElementById('eventsTable');
    const tbody = table.querySelector('tbody');
    const rows = Array.from(tbody.querySelectorAll('tr:not(:has(td[colspan]))')); // exclure la ligne "aucun résultat"

    function filterAndSort() {
        const searchText = searchInput.value.toLowerCase().trim();
        const selectedGame = filterGame.value.toLowerCase();
        const sortOrder = sortDate.value;

        // Filtrage
        let filteredRows = rows.filter(row => {
            const name = row.querySelector('.name')?.textContent.toLowerCase() || '';
            const game = row.querySelector('.game')?.textContent.toLowerCase() || '';
            const dateText = row.querySelector('.date')?.textContent.toLowerCase() || '';

            const matchesSearch = 
                name.includes(searchText) || 
                game.includes(searchText) || 
                dateText.includes(searchText);

            const matchesGame = selectedGame === '' || game.includes(selectedGame);

            return matchesSearch && matchesGame;
        });

        // Tri par date
        if (sortOrder === 'asc' || sortOrder === 'desc') {
            filteredRows.sort((a, b) => {
                const timeA = parseInt(a.querySelector('.date')?.dataset.timestamp || 0);
                const timeB = parseInt(b.querySelector('.date')?.dataset.timestamp || 0);
                
                if (sortOrder === 'asc') {
                    return timeA - timeB;
                } else {
                    return timeB - timeA;
                }
            });
        }

        // Affichage
        tbody.innerHTML = '';
        filteredRows.forEach(row => tbody.appendChild(row));

        // Message aucun résultat
        if (filteredRows.length === 0 && rows.length > 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="5" class="text-center py-5 text-secondary">
                        <i class="bi bi-search fs-1 d-block mb-2"></i>
                        Aucun événement ne correspond à votre recherche
                    </td>
                </tr>
            `;
        }
    }

    // Événements
    searchInput.addEventListener('input', filterAndSort);
    filterGame.addEventListener('change', filterAndSort);
    sortDate.addEventListener('change', filterAndSort);
});
</script>
