{{ form_start(form) }}

<div class="card bg-dark border-primary border-opacity-25 shadow-lg rounded-4">
    <div class="card-body p-4">
        <div class="row g-4">

            {# Nom de l'événement #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.name, 'Nom de l’événement', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}

                    <div class="input-group">
                        <span class="input-group-text bg-primary border-0 text-white">
                            <i class="bi bi-calendar-event"></i>
                        </span>
                        {{ form_widget(form.name, {
                            'attr': {
                                'class': 'form-control bg-dark text-white border-secondary border-opacity-50',
                                'placeholder': 'Ex : Tournoi FIFA'
                            }
                        }) }}
                    </div>

                    {{ form_errors(form.name, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

            {# Date de l'événement #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.date, 'Date & heure', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}

                    <div class="input-group">
                        <span class="input-group-text bg-info border-0 text-white">
                            <i class="bi bi-clock-fill"></i>
                        </span>
                        {{ form_widget(form.date, {
                            'attr': {
                                'class': 'form-control bg-dark text-white border-secondary border-opacity-50',
                                'placeholder': 'YYYY-MM-DD HH:MM'
                            }
                        }) }}
                    </div>

                    {{ form_errors(form.date, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

            {# Jeu #}
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.game, 'Jeu', {
                        'label_attr': {'class': 'form-label text-white fw-semibold'}
                    }) }}

                    <div class="input-group">
                        <span class="input-group-text bg-warning border-0 text-dark">
                            <i class="bi bi-controller"></i>
                        </span>
                        {{ form_widget(form.game, {
                            'attr': {
                                'class': 'form-control bg-dark text-white border-secondary border-opacity-50',
                                'placeholder': 'Ex : CS2, LoL, FIFA'
                            }
                        }) }}
                    </div>

                    {{ form_errors(form.game, {'attr': {'class': 'text-danger small mt-1'}}) }}
                </div>
            </div>

        </div>
    </div>

    {# Actions #}
    <div class="card-footer bg-black bg-opacity-25 border-top border-secondary border-opacity-10 p-3">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('admin_event_index') }}"
               class="btn btn-link text-secondary text-decoration-none">
                <i class="bi bi-x-circle me-1"></i> Annuler
            </a>

            <button type="submit" class="btn btn-primary px-5 shadow">
                <i class="bi bi-save-fill me-2"></i>
                {{ button_label|default('Enregistrer') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}
