{% extends 'base.html.twig' %}

{% block title %}Gamilha - Événements{% endblock %}

{% macro sort_link(sortBy, currentSortBy, currentSortOrder, search, label) %}
    {% set nextOrder = (currentSortBy == sortBy and currentSortOrder == 'ASC') ? 'DESC' : 'ASC' %}
    <a href="{{ path('admin_evenement_index', { search: search, sortBy: sortBy, sortOrder: nextOrder }) }}" class="text-decoration-none text-secondary d-inline-flex align-items-center">
        {{ label }}
        {% if currentSortBy == sortBy %}
            <i class="bi bi-chevron-{{ currentSortOrder == 'ASC' ? 'up' : 'down' }} ms-1 small"></i>
        {% else %}
            <i class="bi bi-chevron-expand ms-1 small opacity-50"></i>
        {% endif %}
    </a>
{% endmacro %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-white">
            <i class="bi bi-calendar-event-fill text-primary me-2"></i>Gestion des événements
        </h1>
        <a href="{{ path('admin_evenement_new') }}" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nouvel événement
        </a>
    </div>

    <form method="get" action="{{ path('admin_evenement_index') }}" class="mb-3">
        <input type="hidden" name="sortBy" value="{{ sortBy }}">
        <input type="hidden" name="sortOrder" value="{{ sortOrder }}">
        <div class="input-group">
            <span class="input-group-text bg-dark border-secondary text-secondary">
                <i class="bi bi-search"></i>
            </span>
            <input type="text" name="search" value="{{ search }}" class="form-control bg-dark border-secondary text-white" placeholder="Rechercher (nom, jeu, type, statut...)" aria-label="Rechercher">
            <button type="submit" class="btn btn-primary">Rechercher</button>
            {% if search %}
                <a href="{{ path('admin_evenement_index', { sortBy: sortBy, sortOrder: sortOrder }) }}" class="btn btn-outline-secondary">Effacer</a>
            {% endif %}
        </div>
    </form>

    <div class="card bg-dark border-0 shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-secondary text-uppercase small border-bottom border-primary border-opacity-25">
                        <tr>
                            <th class="ps-4">{{ _self.sort_link('idEvenement', sortBy, sortOrder, search, 'ID') }}</th>
                            <th>{{ _self.sort_link('nom', sortBy, sortOrder, search, 'Nom') }}</th>
                            <th>{{ _self.sort_link('jeu', sortBy, sortOrder, search, 'Jeu') }}</th>
                            <th>{{ _self.sort_link('typeEvenement', sortBy, sortOrder, search, 'Type') }}</th>
                            <th>{{ _self.sort_link('dateDebut', sortBy, sortOrder, search, 'Début') }}</th>
                            <th>{{ _self.sort_link('dateFin', sortBy, sortOrder, search, 'Fin') }}</th>
                            <th>{{ _self.sort_link('statut', sortBy, sortOrder, search, 'Statut') }}</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for evenement in evenements %}
                        <tr class="border-bottom border-secondary border-opacity-10">
                            <td class="ps-4 text-secondary">#{{ evenement.idEvenement }}</td>
                            <td class="fw-semibold text-white">{{ evenement.nom }}</td>
                            <td><span class="badge bg-secondary px-2">{{ evenement.jeu }}</span></td>
                            <td>{{ evenement.typeEvenement }}</td>
                            <td>{{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y') : '—' }}</td>
                            <td>{{ evenement.dateFin ? evenement.dateFin|date('d/m/Y') : '—' }}</td>
                            <td><span class="badge bg-info px-2">{{ evenement.statut }}</span></td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm">
                                    <a href="{{ path('admin_evenement_show', {'idEvenement': evenement.idEvenement}) }}" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                    <a href="{{ path('admin_evenement_edit', {'idEvenement': evenement.idEvenement}) }}" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                                    <form method="post" action="{{ path('admin_evenement_delete', {'idEvenement': evenement.idEvenement}) }}" onsubmit="return confirm('Confirmer la suppression ?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.idEvenement) }}">
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                                Aucun événement trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
