{% extends 'base.html.twig' %}

{% block title %}Gamilha - Événements{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-white">
            <i class="bi bi-calendar-event-fill text-primary me-2"></i>Gestion des événements
        </h1>
        <a href="{{ path('admin_evenement_new') }}" class="btn btn-success shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Nouvel événement
        </a>
    </div>

    <div class="card bg-dark border-0 shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="text-secondary text-uppercase small border-bottom border-primary border-opacity-25">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nom</th>
                            <th>Jeu</th>
                            <th>Type</th>
                            <th>Début</th>
                            <th>Fin</th>
                            <th>Statut</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for evenement in evenements %}
                        <tr class="border-bottom border-secondary border-opacity-10">
                            <td class="ps-4 text-secondary">#{{ evenement.idEvenement }}</td>
                            <td class="fw-semibold text-white">{{ evenement.nom }}</td>
                            <td><span class="badge bg-secondary px-2">{{ evenement.jeu }}</span></td>
                            <td>{{ evenement.typeEvenement }}</td>
                            <td>{{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y') : '—' }}</td>
                            <td>{{ evenement.dateFin ? evenement.dateFin|date('d/m/Y') : '—' }}</td>
                            <td><span class="badge bg-info px-2">{{ evenement.statut }}</span></td>
                            <td class="text-end pe-4">
                                <div class="btn-group shadow-sm">
                                    <a href="{{ path('admin_evenement_show', {'idEvenement': evenement.idEvenement}) }}" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                    <a href="{{ path('admin_evenement_edit', {'idEvenement': evenement.idEvenement}) }}" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                                    <form method="post" action="{{ path('admin_evenement_delete', {'idEvenement': evenement.idEvenement}) }}" onsubmit="return confirm('Confirmer la suppression ?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.idEvenement) }}">
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="text-center py-5 text-secondary">
                                <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                                Aucun événement trouvé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
