<form method="post" action="{{ path('admin_evenement_delete', {'idEvenement': evenement.idEvenement}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet événement ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.idEvenement) }}">
    <button class="btn btn-outline-danger w-100"><i class="bi bi-trash3 me-2"></i>Supprimer définitivement</button>
</form>
