{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
<div class="card bg-dark border-primary border-opacity-25 shadow-lg rounded-4">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label text-white fw-semibold'}}) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
                    {{ form_errors(form.nom) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    {{ form_label(form.jeu, null, {'label_attr': {'class': 'form-label text-white fw-semibold'}}) }}
                    {{ form_widget(form.jeu, {'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
                    {{ form_errors(form.jeu) }}
                </div>
            </div>
            <div class="col-12">
                {{ form_row(form.description, {'label_attr': {'class': 'form-label text-white fw-semibold'}, 'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
            </div>
            <div class="col-md-4">
                {{ form_row(form.typeEvenement, {'label_attr': {'class': 'form-label text-white fw-semibold'}, 'attr': {'class': 'form-select bg-dark text-white border-secondary'}}) }}
            </div>
            <div class="col-md-4">
                {{ form_row(form.dateDebut, {'label_attr': {'class': 'form-label text-white fw-semibold'}, 'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
            </div>
            <div class="col-md-4">
                {{ form_row(form.dateFin, {'label_attr': {'class': 'form-label text-white fw-semibold'}, 'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.statut, {'label_attr': {'class': 'form-label text-white fw-semibold'}, 'attr': {'class': 'form-select bg-dark text-white border-secondary'}}) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.image, {'label_attr': {'class': 'form-label text-white fw-semibold'}, 'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
            </div>
            <div class="col-12">
                {{ form_row(form.regles, {'label_attr': {'class': 'form-label text-white fw-semibold'}, 'attr': {'class': 'form-control bg-dark text-white border-secondary'}}) }}
            </div>
        </div>
    </div>
    <div class="card-footer bg-black bg-opacity-25 border-top border-secondary border-opacity-10 p-3">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('admin_evenement_index') }}" class="btn btn-link text-secondary text-decoration-none"><i class="bi bi-x-circle me-1"></i> Annuler</a>
            <button type="submit" class="btn btn-primary px-5 shadow"><i class="bi bi-save-fill me-2"></i>{{ button_label|default('Enregistrer') }}</button>
        </div>
    </div>
</div>
{{ form_end(form) }}
