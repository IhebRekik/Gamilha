{% extends 'base.html.twig' %}

{% block title %}Gestion des donations{% endblock %}

{% block body %}
<h1 class="mb-4">💰 Donations</h1>

<table class="table table-dark table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Montant</th>
            <th>Donateur</th>
            <th>Stream</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    {% for donation in donations %}
        <tr>
            <td>{{ donation.id }}</td>
            <td>{{ donation.amount }} €</td>
            <td>{{ donation.user.email ?? 'Test User' }}</td>
            <td>{{ donation.stream.title }}</td>
            <td>{{ donation.createdAt|date('d/m/Y H:i') }}</td>
            <td>
                <a href="{{ path('app_donation_show', {id: donation.id}) }}" class="btn btn-sm btn-info">Voir</a>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="6" class="text-center">Aucune donation</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
