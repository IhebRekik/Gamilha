{% extends 'base.html.twig' %}

{% block title %}Donations par Stream{% endblock %}

{% block body %}
<h1>Donations – Streams</h1>
<form method="get" class="mb-4">
    <div class="input-group">
        <input
            type="text"
            name="q"
            value="{{ search ?? '' }}"
            class="form-control"
            placeholder="Rechercher un stream (id ou titre)">
        <button class="btn btn-primary">
            Rechercher
        </button>
    </div>
</form>

<table class="table table-dark table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Titre</th>
            <th>Jeu</th>
            <th>Donations</th>
        </tr>
    </thead>
    <tbody>
    {% for stream in streams %}
        <tr>
            <td>{{ stream.id }}</td>
            <td>{{ stream.title }}</td>
            <td>{{ stream.game }}</td>
            <td>
                <a class="btn btn-sm btn-info"
                   href="{{ path('admin_donation_by_stream', { id: stream.id }) }}">
                    Voir les dons
                </a>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="4">Aucun stream trouvé</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{% endblock %}
