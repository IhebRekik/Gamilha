{% extends 'base_front.html.twig' %}

{% block body %}

<style>
.chat-container {
    max-width: 900px;
    margin: auto;
}

.chat-box {
    height: 600px;
    overflow-y: auto;
    background: #1e1e2f;
    border-radius: 20px;
    padding: 25px;
    scroll-behavior: smooth;
}

.message-bubble {
    padding: 12px 18px;
    border-radius: 20px;
    max-width: 70%;
    animation: fadeIn 0.3s ease-in-out;
}

.user-bubble {
    background: linear-gradient(135deg, #0d6efd, #3d8bfd);
    color: white;
    border-bottom-right-radius: 5px;
}

.ai-bubble {
    background: #2f2f44;
    color: white;
    border-bottom-left-radius: 5px;
}

.chat-input-card {
    background: #1e1e2f;
    border-radius: 20px;
}

.form-control {
    border-radius: 15px !important;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
}
</style>

<div class="container py-4 chat-container">

    {# ================= CHAT BOX ================= #}
    <div class="chat-box shadow-lg" id="chatBox">

        {% for message in messages %}
            <div class="d-flex mb-4 {{ message.role == 'user' ? 'justify-content-end' : 'justify-content-start' }}">

                {% if message.role != 'user' %}
                    <div class="me-2">
                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center"
                             style="width:40px;height:40px;">
                            🤖
                        </div>
                    </div>
                {% endif %}

                <div class="message-bubble 
                    {{ message.role == 'user' ? 'user-bubble' : 'ai-bubble' }}">

                    <small class="opacity-75">
                        {{ message.role == 'user' ? 'Vous' : 'Coach IA' }}
                    </small>

                    <div class="mt-1">
                        {{ message.content }}
                    </div>

                    {% if message.imageName %}
                        <div class="mt-3 text-center">
                            <img src="{{ asset('uploads/images/' ~ message.imageName) }}"
                                 class="img-fluid rounded shadow"
                                 style="max-width:250px; cursor:pointer;"
                                 onclick="openImage(this.src)">
                        </div>
                    {% endif %}

                    {% if message.audioName %}
                        <div class="mt-3">
                            <audio controls class="w-100">
                                <source src="{{ asset('uploads/audio/' ~ message.audioName) }}">
                            </audio>
                        </div>
                    {% endif %}
                </div>

                {% if message.role == 'user' %}
                    <div class="ms-2">
                        <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                             style="width:40px;height:40px;">
                            👤
                        </div>
                    </div>
                {% endif %}

            </div>
        {% endfor %}
    </div>

    {# ================= FORM ================= #}
    <div class="card chat-input-card border-0 shadow-lg mt-4 p-3">

        {{ form_start(form, {'attr': {'id': 'chatForm'}}) }}

        <div class="input-group">

            {{ form_widget(form.content, {
                'attr': {
                    'class':'form-control bg-dark text-white border-0',
                    'placeholder':'Écrire un message...',
                    'rows': 1
                }
            }) }}

            <button type="button" id="recordBtn" class="btn btn-danger rounded-pill ms-2">
                🎤
            </button>

            <button type="submit" class="btn btn-success rounded-pill ms-2">
                Envoyer
            </button>

        </div>

        <div class="mt-2">
            {{ form_widget(form.imageFile, {
                'attr': {'class':'form-control bg-dark text-white border-0'}
            }) }}

            {{ form_widget(form.audioFile, {
                'attr': {'style':'display:none;'}
            }) }}
        </div>

        {{ form_end(form) }}
    </div>

</div>
{% endblock %}