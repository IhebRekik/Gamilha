{% extends 'base.html.twig' %}

{% block title %}Social{% endblock %}

{% block body %}
<div class="social-wrapper p-4">
    {# ================= HEADER ================= #}
    <div class="mb-4">
        <h3 class="text-white fw-bold">Social</h3>
        <p class="text-secondary mb-3">Connectez-vous avec la communauté esports</p>
        <div class="social-tabs">
            <a href="{{ path('social_index') }}"
               class="tab {{ app.request.attributes.get('_route') == 'social_index' ? 'active' : '' }}">
                Fil d’actualité
            </a>
            <a href="{{ path('social_friends') }}"
               class="tab {{ app.request.attributes.get('_route') == 'social_friends' ? 'active' : '' }}">
                Amis
            </a>
            <a href="{{ path('social_search') }}"
               class="tab {{ app.request.attributes.get('_route') == 'social_search' ? 'active' : '' }}">
                Rechercher
            </a>
            <a href="{{ path('social_notifications') }}"
               class="tab {{ app.request.attributes.get('_route') == 'social_notifications' ? 'active' : '' }}">
                Notifications
            </a>
        </div>
    </div>

    {# Messages flash #}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="row">
        {# ================= FEED ================= #}
        <div class="col-md-8">
            {# ================= FORM POST ================= #}
            <div class="card bg-dark text-white p-3 rounded-4 shadow-sm mb-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="d-flex gap-3">
                    <div class="avatar avatar-purple">
                        {{ 'app.user.name'|slice(0,2)|upper }}
                    </div>

                    <div class="flex-grow-1">
                        <div class="border border-secondary rounded overflow-hidden bg-dark">
                            {{ form_row(form.content, {
                                'label': false,
                                'attr': {
                                    'id': 'post_content',  
                                    'placeholder': 'Quoi de neuf dans votre partie ? 🎮',
                                    'rows': 8,
                                    'class': 'form-control bg-dark text-white border-0'
                                }
                            }) }}
                        </div>

                        <div class="d-flex align-items-center gap-2 mt-2">
                            <i id="ai-suggest"
                               class="bi bi-stars text-info cursor-pointer fs-5"
                               title="Suggestion IA"></i>
                            <small class="text-muted">Suggestion IA</small>
                        </div>
                        {{ form_errors(form.content) }}

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="d-flex align-items-center gap-4">
                                <label class="d-flex align-items-center gap-1 cursor-pointer">
                                    <i class="bi bi-image-fill"></i>
                                    <span>Image</span>
                                    {{ form_widget(form.imageFile, {'attr': {'class': 'd-none'}}) }}
                                </label>
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-link-45deg"></i>
                                    {{ form_widget(form.mediaurl, {
                                        'attr': {
                                            'class': 'form-control form-control-sm bg-dark text-white border-secondary',
                                            'placeholder': 'Lien vidéo ou image'
                                        }
                                    }) }}
                                </div>
                            </div>
                            <button class="btn btn-primary rounded-pill px-4">
                                Publier
                            </button>
                        </div>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>

            {# ================= POSTS ================= #}
            {% for post in posts %}
                <div class="card bg-dark text-white p-3 rounded-4 shadow-sm mb-4 position-relative">
                    {# ===== HEADER POST ===== #}
                    <div class="d-flex gap-2 align-items-center">
                        <div class="avatar avatar-purple">
                            {{ post.user.name|slice(0,2)|upper }}
                        </div>
                        <div>
                            <div class="fw-semibold">{{ post.user.name }}</div>
                            <small class="text-secondary">{{ post.createdAt|date('d/m/Y H:i') }}</small>
                        </div>
                    </div>

                    {# ===== MENU 3 POINTS POST ===== #}
                    {% if post.user == app.user %}
                    <button class="btn btn-link text-white p-0 position-absolute top-0 end-0 mt-3 me-3"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#postOptions{{ post.id }}">
                        <i class="bi bi-three-dots-vertical fs-5"></i>
                    </button>
                    {% endif %}

                    <!-- Modal Options Post -->
                    <div class="modal fade" id="postOptions{{ post.id }}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content bg-dark text-white border-secondary">
                                <div class="modal-header">
                                    <h5 class="modal-title">Options de la publication</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body d-flex flex-column gap-2">
                                    <button type="button"
                                            class="btn btn-outline-light w-100 d-flex align-items-center justify-content-center gap-2"
                                            data-bs-toggle="modal" data-bs-target="#editPost{{ post.id }}" data-bs-dismiss="modal">
                                        <i class="bi bi-pencil-square"></i> Modifier
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2"
                                            data-bs-toggle="modal" data-bs-target="#deletePost{{ post.id }}" data-bs-dismiss="modal">
                                        <i class="bi bi-trash3-fill"></i> Supprimer
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ===== MODAL EDIT POST ===== #}
                    <div class="modal fade" id="editPost{{ post.id }}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content bg-dark text-white border-secondary">
                                <div class="modal-header border-secondary">
                                    <h5 class="modal-title">Modifier la publication</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body p-4">
                                    {{ form_start(editPostForms[post.id], {'attr': {'novalidate': 'novalidate', 'class':'needs-validation'}}) }}
                                    <div class="mb-4">
                                        <label class="form-label text-white">Contenu</label>
                                        {{ form_widget(editPostForms[post.id].content, {'id':'edit_content_' ~ post.id}) }}
                                        {{ form_errors(editPostForms[post.id].content) }}
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label text-white">Lien média (optionnel)</label>
                                        {{ form_widget(editPostForms[post.id].mediaurl, {'attr': {'class':'form-control bg-dark text-white border-secondary','placeholder':'https://youtube.com/watch?v=...'}}) }}
                                        {{ form_errors(editPostForms[post.id].mediaurl) }}
                                    </div>
                                    <div class="d-flex gap-3 mt-4">
                                        <button type="submit" class="btn btn-success w-100 rounded-pill py-3">Enregistrer</button>
                                        <button type="button" class="btn btn-outline-light w-100 rounded-pill py-3" data-bs-dismiss="modal">Annuler</button>
                                    </div>
                                    {{ form_end(editPostForms[post.id]) }}
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ===== MODAL DELETE POST ===== #}
                    <div class="modal fade" id="deletePost{{ post.id }}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content bg-dark text-white border-secondary">
                                <div class="modal-header">
                                    <h5 class="modal-title text-danger">Supprimer la publication ?</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <p>Cette action est irréversible.</p>
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('post_delete', {id: post.id}) }}" class="btn btn-danger w-100 rounded-pill">Oui, supprimer</a>
                                        <button type="button" class="btn btn-outline-light w-100 rounded-pill" data-bs-dismiss="modal">Annuler</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# ===== CONTENU DU POST ===== #}
                    <div class="mt-3 post-content ql-editor-style">{{ post.content|raw }}</div>

                    {% if post.image %}
                        <img src="{{ asset('uploads/' ~ post.image) }}" class="img-fluid rounded-3 mb-2" alt="Image du post">
                    {% endif %}

                    {% if post.mediaurl %}
                        {% if 'youtube.com' in post.mediaurl or 'youtu.be' in post.mediaurl %}
                            {% if 'watch?v=' in post.mediaurl %}
                                {% set videoId = post.mediaurl|split('watch?v=')|last|split('&')|first %}
                            {% elseif 'youtu.be/' in post.mediaurl %}
                                {% set videoId = post.mediaurl|split('youtu.be/')|last|split('?')|first %}
                            {% endif %}
                            <div class="card mt-3">
                                <div class="ratio ratio-16x9">
                                    <iframe src="https://www.youtube.com/embed/{{ videoId }}" frameborder="0" allowfullscreen></iframe>
                                </div>
                            </div>
                        {% elseif post.mediaurl starts with 'http' %}
                            <div class="card mt-3 border-0">
                                <img src="{{ post.mediaurl }}" class="img-fluid rounded" style="max-height:500px; object-fit:cover;" alt="Média du post">
                            </div>
                        {% else %}
                            <a href="{{ post.mediaurl }}" target="_blank">🔗 Ouvrir le lien</a>
                        {% endif %}
                    {% endif %}

                    {# ===== STATS ===== #}
                    <div class="d-flex gap-4 mt-3 fw-semibold">
                        <a href="{{ path('post_like', {id: post.id}) }}" class="text-decoration-none d-flex align-items-center gap-1">
                            <i class="bi {{ post.isLikedBy(app.user) ? 'bi-heart-fill text-danger' : 'bi-heart' }}"></i>
                            {{ post.getLikesCount() }}
                        </a>
                        <span class="d-flex align-items-center gap-1">
                            <i class="bi bi-chat-dots-fill"></i>
                            {{ post.commentaires|length }}
                        </span>
                    </div>

                    <hr class="border-secondary">

                    {# ================= COMMENTAIRES ================= #}
                    {% for comment in post.commentaires %}
                        <div class="d-flex gap-2 mb-2 position-relative">
                            <div class="avatar avatar-small avatar-purple">{{ comment.user.name|slice(0,2)|upper }}</div>
                            <div class="flex-grow-1 bg-secondary bg-opacity-25 rounded-3 p-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="small">{{ comment.user.name }}</strong>

                                    {% if comment.user == app.user %}
                                    <button class="btn btn-link text-white p-0" type="button"
                                            data-bs-toggle="modal" data-bs-target="#commentOptions{{ comment.id }}">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    {% endif %}
                                </div>
                                <p class="mb-0">{{ comment.text }}</p>
                            </div>

                            {# MODALS COMMENTAIRE #}
{% if comment.user == app.user %}
<!-- Modal Options Commentaire -->
<div class="modal fade" id="commentOptions{{ comment.id }}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header">
                <h5 class="modal-title">Options du commentaire</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body d-flex flex-column gap-2">
                <!-- Modifier le commentaire -->
                <button type="button"
                        class="btn btn-outline-light w-100 d-flex align-items-center justify-content-center gap-2"
                        data-bs-toggle="modal"
                        data-bs-target="#editComment{{ comment.id }}"
                        data-bs-dismiss="modal">
                    <i class="bi bi-pencil-square"></i> Modifier
                </button>
                <!-- Supprimer le commentaire -->
                <button type="button"
                        class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteComment{{ comment.id }}"
                        data-bs-dismiss="modal">
                    <i class="bi bi-trash3-fill"></i> Supprimer
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Edit Comment -->
<div class="modal fade" id="editComment{{ comment.id }}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header">
                <h5 class="modal-title">Modifier le commentaire</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form action="{{ path('comment_edit', {id: comment.id}) }}" method="POST">
                    <textarea name="text" class="form-control bg-dark text-white border-secondary mb-3" required>{{ comment.text }}</textarea>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success w-100">Enregistrer</button>
                        <button type="button" class="btn btn-outline-light w-100" data-bs-dismiss="modal">Annuler</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Delete Comment -->
<div class="modal fade" id="deleteComment{{ comment.id }}" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header">
                <h5 class="modal-title text-danger">Supprimer le commentaire ?</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Cette action est irréversible.</p>
                <div class="d-flex gap-2">
                    <form action="{{ path('comment_delete', {id: comment.id}) }}" method="POST" class="w-100">
                        <button type="submit" class="btn btn-danger w-100">Oui, supprimer</button>
                    </form>
                    <button type="button" class="btn btn-outline-light w-100" data-bs-dismiss="modal">Annuler</button>
                </div>
            </div>
        </div>
    </div>
</div>{% endif %}                            
                        </div>
                    {% endfor %}

                    {# ===== AJOUT COMMENTAIRE ===== #}
                    <form method="POST" action="{{ path('comment_add') }}" class="mt-3">
                        <input type="hidden" name="post_id" value="{{ post.id }}">
                        <div class="d-flex gap-2">
                            <div class="avatar avatar-small avatar-purple">{{ 'app.user.name'|slice(0,2)|upper }}</div>
                            <input type="text" name="text" class="form-control bg-dark text-white border-secondary rounded-pill"
                                   placeholder="Écrire un commentaire..." required>
                            <button class="btn btn-primary rounded-circle">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </form>
                </div>
            {% else %}
                <p class="text-center text-secondary">Aucun post pour le moment.</p>
            {% endfor %}
        </div>

        {# ================= SIDEBAR ================= #}
        <div class="col-md-4">
            {# Suggestions d’amis #}
            <div class="card bg-dark text-white p-3 rounded-4 mb-4">
                <h6 class="mb-3">👤 Suggestions d’amis</h6>
                {% for suggestedUser in suggestedUsers %}
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="avatar avatar-purple">{{ suggestedUser.name|slice(0,2)|upper }}</div>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">{{ suggestedUser.name }}</div>
                            <small class="text-muted" style="color: green">Pas de jeu</small>
                        </div>
                        <form action="{{ path('friend_add', {id: suggestedUser.id}) }}" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-primary rounded-circle">
                                <i class="bi bi-person-plus-fill"></i>
                            </button>
                        </form>
                    </div>
                {% else %}
                    <p class="text-muted">Aucune suggestion pour le moment.</p>
                {% endfor %}
            </div>

            {# Amis en ligne #}
            <div class="card bg-dark text-white p-3 rounded-4">
                <h6 class="text-success mb-3">🟢 Amis en ligne</h6>
                {% for i in 1..4 %}
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <div class="avatar">BM</div>
                        <div>
                            <div class="fw-semibold">BestMate</div>
                            <small class="text-muted">En ligne</small>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{# ===== SCRIPTS ===== #}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const icon = document.getElementById('ai-suggest');
    if(icon){
        icon.addEventListener('click', async function () {
            const editor = CKEDITOR.instances['post_content'];
            if (!editor) { alert("Éditeur introuvable !"); return; }

            let text = editor.getData().replace(/<[^>]+>/g, '').trim();
            if (text.length < 3) text = "Génère un post gaming fun sur un thème au choix ! 🎮";

            icon.classList.add('spinner-border', 'spinner-border-sm');
            icon.classList.remove('bi-lightbulb-fill');

            const loading = document.createElement('small');
            loading.className = 'ms-2 text-info';
            loading.textContent = 'L’IA réfléchit…';
            icon.after(loading);

            try {
                const response = await fetch('{{ path('ai_suggest_text') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prompt: text })
                });
                const data = await response.json();
                if (data.success && data.suggestion) editor.setData(data.suggestion);
                else alert("Erreur IA : texte introuvable");
            } catch (err) { console.error(err); alert("Problème de connexion au serveur IA"); }
            finally {
                icon.classList.remove('spinner-border', 'spinner-border-sm');
                icon.classList.add('bi-lightbulb-fill');
                loading.remove();
            }
        });
    }
});
</script>

<script>
document.querySelectorAll('[id^="editPost"]').forEach(modal => {
    modal.addEventListener('shown.bs.modal', function () {
        const postId = modal.id.replace('editPost','');
        const textareaId = 'edit_content_' + postId;
        if (!CKEDITOR.instances[textareaId]) {
            CKEDITOR.replace(textareaId, {
                toolbar: [
                    ['Format', 'Bold', 'Italic', 'Underline', 'Strike', 'TextColor', 'BGColor'],
                    ['NumberedList', 'BulletedList', 'Blockquote'],
                    ['Undo', 'Redo', 'Source']
                ],
                uiColor: "#1f2937",
                height: 120,
                removePlugins: 'elementspath,image,table,link,about',
                resize_enabled: false,
                contentsCss: '/css/ckeditor-custom.css'
            });
        }
    });
});
</script>
{% endblock %}