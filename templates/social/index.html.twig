{% extends 'base.html.twig' %}
{% block title %}Social{% endblock %}

{% block body %}
<div class="social-wrapper">

    {# ================= HEADER ================= #}
    <div class="mb-4">
        <h3 class="text-white fw-bold">Social</h3>
        <p class="text-secondary mb-3">Connectez-vous avec la communauté esports</p>
        <div class="social-tabs">
            <a href="{{ path('social_index') }}"
               class="tab {{ app.request.attributes.get('_route') == 'social_index' ? 'active' : '' }}">
                Fil d’actualité
            </a>
<a href="{{ path('social_friends') }}" class="tab">Amis</a>            <a href="{{ path('social_search') }}"
               class="tab {{ app.request.attributes.get('_route') == 'social_search' ? 'active' : '' }}">
                Rechercher
            </a>
        </div>
    </div>

    <div class="row">

        {# ================= FEED ================= #}
        <div class="col-md-8">

            {# ================= FORM POST ================= #}
            <div class="card bg-dark text-white p-3 rounded-4 shadow-sm mb-4">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="d-flex gap-3">
                    <div class="avatar avatar-purple">
                        {{ 'Khawla'|slice(0,2)|upper }}
                    </div>
                    <div class="flex-grow-1">
                        {{ form_widget(form.content, {
                            'attr': {
                                'class': 'form-control bg-dark text-white border-secondary',
                                'placeholder': 'Quoi de neuf dans votre partie ? 🎮'
                            }
                        }) }}
                        {{ form_errors(form.content) }}

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div class="d-flex align-items-center gap-4">
                                <label class="d-flex align-items-center gap-1 cursor-pointer">
                                    <i class="bi bi-image-fill"></i>
                                    <span>Image</span>
                                    {{ form_widget(form.imageFile, {'attr': {'class': 'd-none'}}) }}
                                </label>
                                <div class="d-flex align-items-center gap-1">
                                    <i class="bi bi-link-45deg"></i>
                                    {{ form_widget(form.mediaurl, {
                                        'attr': {
                                            'class': 'form-control form-control-sm bg-dark text-white border-secondary',
                                            'placeholder': 'Lien vidéo'
                                        }
                                    }) }}
                                </div>
                            </div>
                            <button class="btn btn-primary rounded-pill px-4">
                                Publier
                            </button>
                        </div>
                    </div>
                </div>
                {{ form_end(form) }}
            </div>

            {# ================= POSTS ================= #}
            {% for post in posts %}
            <div class="card bg-dark text-white p-3 rounded-4 shadow-sm mb-4 position-relative">

                {# ===== HEADER POST ===== #}
                <div class="d-flex gap-2 align-items-center">
                    <div class="avatar avatar-purple">
                        {{ post.user.name|slice(0,2)|upper }}
                    </div>
                    <div>
                        <div class="fw-semibold">{{ post.user.name }}</div>
                        <small class="text-secondary">{{ post.createdAt|date('d/m/Y H:i') }}</small>
                    </div>
                </div>

                {# ===== 3 POINTS (toujours visibles pour test) ===== #}
                <button class="btn btn-link text-white p-0 position-absolute top-0 end-0 mt-3 me-3"
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#postOptions{{ post.id }}">
                    <i class="bi bi-three-dots-vertical fs-5"></i>
                </button>

                <!-- Modal Options Post -->
                <div class="modal fade" id="postOptions{{ post.id }}" tabindex="-1" aria-labelledby="postOptionsLabel{{ post.id }}" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-white border-secondary">
                            <div class="modal-header">
                                <h5 class="modal-title" id="postOptionsLabel{{ post.id }}">Options de la publication</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <button type="button"
                                        class="btn btn-outline-light w-100 mb-3 py-3 d-flex align-items-center justify-content-center gap-2"
                                        data-bs-toggle="modal" data-bs-target="#editPost{{ post.id }}" data-bs-dismiss="modal">
                                    <i class="bi bi-pencil-square"></i> Modifier
                                </button>
                                <button type="button"
                                        class="btn btn-outline-danger w-100 py-3 d-flex align-items-center justify-content-center gap-2"
                                        data-bs-toggle="modal" data-bs-target="#deletePost{{ post.id }}" data-bs-dismiss="modal">
                                    <i class="bi bi-trash3-fill"></i> Supprimer
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

           <!-- Modal EDIT Post -->
<div class="modal fade" id="editPost{{ post.id }}" tabindex="-1" aria-labelledby="editPostLabel{{ post.id }}" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content bg-dark text-white border-secondary">
            <div class="modal-header border-secondary">
                <h5 class="modal-title" id="editPostLabel{{ post.id }}">Modifier la publication</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <div class="modal-body p-4">
                {# On utilise le vrai formulaire Symfony que tu as créé dans le controller #}
                {{ form_start(editPostForms[post.id], {
                    'attr': {
                        'novalidate': 'novalidate',
                        'class': 'needs-validation'
                    }
                }) }}

                <div class="mb-4">
                    <label class="form-label text-white">Contenu</label>
                    {{ form_widget(editPostForms[post.id].content, {
                        'attr': {
                            'class': 'form-control bg-dark text-white border-secondary',
                            'rows': 5,
                            'required': 'required'
                        }
                    }) }}
                    {{ form_errors(editPostForms[post.id].content) }}
                </div>

                <div class="mb-4">
                    <label class="form-label text-white">Lien média (optionnel)</label>
                    {{ form_widget(editPostForms[post.id].mediaurl, {
                        'attr': {
                            'class': 'form-control bg-dark text-white border-secondary',
                            'placeholder': 'https://youtube.com/watch?v=...'
                        }
                    }) }}
                    {{ form_errors(editPostForms[post.id].mediaurl) }}
                </div>

                {# On enlève imageFile car on ne l'utilise pas pour l'édition #}
                {# Pas besoin de le mettre ici #}

                <div class="d-flex gap-3 mt-4">
                    <button type="submit" class="btn btn-success w-100 rounded-pill py-3">
                        Enregistrer les modifications
                    </button>
                    <button type="button" class="btn btn-outline-light w-100 rounded-pill py-3" data-bs-dismiss="modal">
                        Annuler
                    </button>
                </div>

                {{ form_end(editPostForms[post.id]) }}
            </div>
        </div>
    </div>
</div>
                <!-- Modal DELETE Post -->
                <div class="modal fade" id="deletePost{{ post.id }}" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content bg-dark text-white border-secondary">
                            <div class="modal-header">
                                <h5 class="modal-title text-danger">Supprimer la publication ?</h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                            </div>
                            <div class="modal-body">
                                <p>Cette action est irréversible.</p>
                                <div class="d-flex gap-2">
                                    <a href="{{ path('post_delete', {id: post.id}) }}" class="btn btn-danger w-100 rounded-pill">Oui, supprimer</a>
                                    <button type="button" class="btn btn-outline-light w-100 rounded-pill" data-bs-dismiss="modal">Annuler</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# ===== CONTENT ===== #}
                <p class="mt-3 post-content">{{ post.content }}</p>
                {% if post.image %}
                    <img src="{{ asset('uploads/' ~ post.image) }}" class="img-fluid rounded-3 mb-2">
                {% endif %}
                {% if post.mediaurl %}
                    <a href="{{ post.mediaurl }}" target="_blank" class="text-info">🎥 Voir le média</a>
                {% endif %}

                {# ===== STATS ===== #}
              <div class="d-flex gap-4 mt-3 fw-semibold">
    <a href="{{ path('post_like', {id: post.id}) }}"
       class="text-white text-decoration-none d-flex align-items-center gap-1 {% if post.isLikedBy(defaultUser) %}text-danger{% endif %}">
        <i class="bi {% if post.isLikedBy(defaultUser) %}bi-heart-fill text-danger{% else %}bi-heart{% endif %}"></i>
        {{ post.likes }}
    </a>
    <span class="d-flex align-items-center gap-1">
        <i class="bi bi-chat-dots-fill"></i>
        {{ post.commentaires|length }}
    </span>
</div>
                <hr class="border-secondary">

                {# ================= COMMENTS ================= #}
                {% for comment in post.commentaires %}
                <div class="d-flex gap-2 mb-2 position-relative">
                    <div class="avatar avatar-small avatar-purple">
                        {{ comment.user.name|slice(0,2)|upper }}
                    </div>
                    <div class="flex-grow-1 bg-secondary bg-opacity-25 rounded-3 p-2">

                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <strong class="small">{{ comment.user.name }}</strong>

                            {# ===== 3 POINTS COMMENTAIRE (toujours visible pour test) ===== #}
                            <button class="btn btn-link text-white p-0"
                                    type="button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#commentOptions{{ comment.id }}">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                        </div>

                        <p class="mb-0">{{ comment.text }}</p>

                    </div>

                    <!-- Modal Options Comment -->
                    <div class="modal fade" id="commentOptions{{ comment.id }}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content bg-dark text-white border-secondary">
                                <div class="modal-header">
                                    <h5 class="modal-title">Options du commentaire</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <button type="button"
                                            class="btn btn-outline-light w-100 mb-3 py-3 d-flex align-items-center justify-content-center gap-2"
                                            data-bs-toggle="modal" data-bs-target="#editComment{{ comment.id }}" data-bs-dismiss="modal">
                                        <i class="bi bi-pencil-square"></i> Modifier
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-danger w-100 py-3 d-flex align-items-center justify-content-center gap-2"
                                            data-bs-toggle="modal" data-bs-target="#deleteComment{{ comment.id }}" data-bs-dismiss="modal">
                                        <i class="bi bi-trash3-fill"></i> Supprimer
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal EDIT Comment -->
                    <div class="modal fade" id="editComment{{ comment.id }}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content bg-dark text-white border-secondary">
                                <div class="modal-header">
                                    <h5 class="modal-title">Modifier le commentaire</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <form method="post" action="{{ path('comment_edit', {id: comment.id}) }}">
                                        <textarea name="text" rows="4" class="form-control bg-dark text-white border-secondary mb-3" required>{{ comment.text }}</textarea>
                                        <div class="d-flex gap-2">
                                            <button type="submit" class="btn btn-success w-100 rounded-pill">Enregistrer</button>
                                            <button type="button" class="btn btn-outline-light w-100 rounded-pill" data-bs-dismiss="modal">Annuler</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Modal DELETE Comment -->
                    <div class="modal fade" id="deleteComment{{ comment.id }}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content bg-dark text-white border-secondary">
                                <div class="modal-header">
                                    <h5 class="modal-title text-danger">Supprimer ce commentaire ?</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <p>Cette action est irréversible.</p>
                                    <div class="d-flex gap-2">
                                        <a href="{{ path('comment_delete', {id: comment.id}) }}" class="btn btn-danger w-100 rounded-pill">Oui, supprimer</a>
                                        <button type="button" class="btn btn-outline-light w-100 rounded-pill" data-bs-dismiss="modal">Annuler</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                {% endfor %}

                {# ===== ADD COMMENT ===== #}
                <form method="POST" action="{{ path('comment_add') }}" class="mt-3">
                    <input type="hidden" name="post_id" value="{{ post.id }}">
                    <div class="d-flex gap-2">
                        <div class="avatar avatar-small avatar-purple">
                            {{ 'Khawla'|slice(0,2)|upper }}
                        </div>
                        <input type="text"
                               name="text"
                               class="form-control bg-dark text-white border-secondary rounded-pill"
                               placeholder="Écrire un commentaire..."
                               required>
                        <button class="btn btn-primary rounded-circle">
                            <i class="bi bi-send-fill"></i>
                        </button>
                    </div>
                </form>

            </div>
            {% else %}
            <p class="text-center text-secondary">Aucun post pour le moment.</p>
            {% endfor %}

        </div>

       {# ================= SIDEBAR ================= #}
<div class="col-md-4">

    <div class="card bg-dark text-white p-3 rounded-4 mb-4">
        <h6 class="mb-3">👤 Suggestions d’amis</h6>
        {% for suggestedUser in suggestedUsers %}
        <div class="d-flex align-items-center gap-2 mb-2">
            <div class="avatar avatar-purple">{{ suggestedUser.name|slice(0,2)|upper }}</div>
            <div class="flex-grow-1">
                <div class="fw-semibold">{{ suggestedUser.name }}</div>
                <small class="text-muted" style="color: green">
                    Pas de jeu
                </small>
            </div>

            <form action="{{ path('friend_add', {id: suggestedUser.id}) }}" method="post" style="display:inline">
                <button type="submit" class="btn btn-sm btn-primary rounded-circle">
                    <i class="bi bi-person-plus-fill"></i>
                </button>
            </form>
        </div>
        {% else %}
        <p class="text-muted">Aucune suggestion pour le moment.</p>
        {% endfor %}
    </div>

    <div class="card bg-dark text-white p-3 rounded-4">
        <h6 class="text-success mb-3">🟢 Amis en ligne</h6>
        {% for i in 1..4 %}
        <div class="d-flex align-items-center gap-2 mb-2">
            <div class="avatar">BM</div>
            <div>
                <div class="fw-semibold">BestMate</div>
                <small class="text-muted">En ligne</small>
            </div>
        </div>
        {% endfor %}
    </div>

</div>

        </div>

    </div>
</div>
{% endblock %}