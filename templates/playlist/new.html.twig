{# 📁 templates/playlist/new.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Nouvelle playlist{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 650px;">

    <h1 class="mb-4">➕ Créer une playlist</h1>

    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-1"></i> {{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}

        <div class="mb-3">
            {{ form_label(form.title) }}
            {{ form_widget(form.title) }}
            {% for error in form.title.vars.errors %}
                <div class="text-danger small mt-1">{{ error.message }}</div>
            {% endfor %}
        </div>

        <div class="mb-3">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {% for error in form.description.vars.errors %}
                <div class="text-danger small mt-1">{{ error.message }}</div>
            {% endfor %}
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                {{ form_label(form.niveau) }}
                {{ form_widget(form.niveau) }}
            </div>
            <div class="col-md-6">
                {{ form_label(form.categorie) }}
                {{ form_widget(form.categorie) }}
            </div>
        </div>

        <div class="mb-4">
            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile) }}
            {{ form_help(form.imageFile) }}
            {% for error in form.imageFile.vars.errors %}
                <div class="text-danger small mt-1">{{ error.message }}</div>
            {% endfor %}
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
                <i class="bi bi-save me-1"></i> Créer la playlist
            </button>
            <a href="{{ path('playlist_index') }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Retour
            </a>
        </div>

    {{ form_end(form) }}

</div>
{% endblock %}
