{# 📁 templates/playlist/edit.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Modifier — {{ playlist.title }}{% endblock %}

{% block body %}
<div class="container mt-4" style="max-width: 650px;">

    <h1 class="mb-4">✏️ Modifier la playlist</h1>

    {% for msg in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-1"></i> {{ msg }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Image actuelle #}
    {% if playlist.image %}
        <div class="mb-4">
            <p class="small text-muted mb-1">Image actuelle :</p>
            <img src="{{ asset('uploads/playlists/' ~ playlist.image) }}"
                 alt="{{ playlist.title }}"
                 class="rounded-3 shadow"
                 style="height:120px; object-fit:cover; max-width:100%;">
        </div>
    {% endif %}

    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}

        <div class="mb-3">
            {{ form_label(form.title) }}
            {{ form_widget(form.title) }}
            {% for error in form.title.vars.errors %}
                <div class="text-danger small mt-1">{{ error.message }}</div>
            {% endfor %}
        </div>

        <div class="mb-3">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {% for error in form.description.vars.errors %}
                <div class="text-danger small mt-1">{{ error.message }}</div>
            {% endfor %}
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                {{ form_label(form.niveau) }}
                {{ form_widget(form.niveau) }}
            </div>
            <div class="col-md-6">
                {{ form_label(form.categorie) }}
                {{ form_widget(form.categorie) }}
            </div>
        </div>

        <div class="mb-4">
            {{ form_label(form.imageFile) }}
            {{ form_widget(form.imageFile) }}
            {{ form_help(form.imageFile) }}
            <div class="form-text">Laissez vide pour conserver l'image actuelle.</div>
            {% for error in form.imageFile.vars.errors %}
                <div class="text-danger small mt-1">{{ error.message }}</div>
            {% endfor %}
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning text-dark fw-bold">
                <i class="bi bi-save me-1"></i> Sauvegarder
            </button>
            <a href="{{ path('playlist_show', {id: playlist.id}) }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Retour
            </a>
        </div>

    {{ form_end(form) }}

</div>
{% endblock %}
