{% extends 'base.html.twig' %}

{% block title %}Playlists{% endblock %}

{% block body %}
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>🎶 Playlists</h1>
        <form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="q" class="form-control"
               placeholder="🔍 Rechercher..."
               value="{{ app.request.get('q') }}">
    </div>

    <div class="col-md-3">
        <select name="niveau" class="form-select">
            <option value="">Tous niveaux</option>
            <option value="debutant">Débutant</option>
            <option value="intermediaire">Intermédiaire</option>
            <option value="avance">Avancé</option>
        </select>
    </div>

    <div class="col-md-3">
        <select name="categorie" class="form-select">
            <option value="">Toutes catégories</option>
            <option value="fitness">Fitness</option>
            <option value="yoga">Yoga</option>
            <option value="musculation">Musculation</option>
            <option value="cardio">Cardio</option>
        </select>
    </div>

    <div class="col-md-2">
        <button class="btn btn-primary w-100">Filtrer</button>
    </div>
</form>


        <a href="{{ path('playlist_new') }}" class="btn btn-primary">
            ➕ Nouvelle playlist
        </a>
    </div>

    <div class="row">
        {% for playlist in playlists %}
            <div class="col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm bg-dark text-white">

                    <div class="card-body">
                        <h5 class="card-title">
                            {{ playlist.title }}
                        </h5>

                        <p class="card-text small opacity-75">
                            {{ playlist.description|slice(0, 120) }}
                            {% if playlist.description|length > 120 %}...{% endif %}
                        </p>

                        <p class="small">
                            🎯 <strong>Niveau :</strong> {{ playlist.niveau }} <br>
                            📂 <strong>Catégorie :</strong> {{ playlist.categorie }}
                        </p>
                    </div>

                    <!-- 🔘 ACTIONS -->
                    <div class="card-footer bg-transparent border-top d-flex justify-content-between align-items-center">
                        <div>
                            <a href="{{ path('playlist_show', {id: playlist.id}) }}"
                               class="btn btn-info btn-sm">
                                👀 Voir
                            </a>

                            <a href="{{ path('playlist_edit', {id: playlist.id}) }}"
                               class="btn btn-warning btn-sm">
                                ✏️
                            </a>
                        </div>

                        <!-- 🗑️ SUPPRIMER -->
                        <form method="post"
                              action="{{ path('playlist_delete', {id: playlist.id}) }}"
                              onsubmit="return confirm('Supprimer cette playlist ?');">
                            <input type="hidden" name="_token"
                                   value="{{ csrf_token('delete' ~ playlist.id) }}">
                            <button class="btn btn-danger btn-sm">
                                🗑️
                            </button>
                        </form>
                    </div>

                </div>
            </div>
        {% else %}
            <div class="col-12 text-center opacity-75">
                <p>Aucune playlist disponible</p>
            </div>
        {% endfor %}
    </div>

</div>
{% endblock %}
