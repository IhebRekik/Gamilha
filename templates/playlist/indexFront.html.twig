{# 📁 templates/playlist/indexFront.html.twig #}
{% extends 'base_front.html.twig' %}

{% block title %}Playlists — Gamilha{% endblock %}

{% block stylesheets %}
<style>
    .playlist-card {
        background: var(--gamilha-card);
        border: 1px solid var(--gamilha-border);
        border-radius: 16px;
        overflow: hidden;
        transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
    }
    .playlist-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(139, 92, 246, 0.2);
        border-color: rgba(139, 92, 246, 0.5);
    }
    .playlist-card img { height: 200px; object-fit: cover; width: 100%; }
    .badge-debutant      { background: rgba(34,197,94,0.2);  color: #4ade80; border:1px solid rgba(34,197,94,0.3); }
    .badge-intermediaire { background: rgba(251,191,36,0.2); color: #fbbf24; border:1px solid rgba(251,191,36,0.3); }
    .badge-avance        { background: rgba(239,68,68,0.2);  color: #f87171; border:1px solid rgba(239,68,68,0.3); }
    .filter-bar .form-control,
    .filter-bar .form-select {
        background: var(--gamilha-card);
        border-color: var(--gamilha-border);
        color: var(--gamilha-text);
    }
    .filter-bar .form-control::placeholder { color: var(--gamilha-muted); }
</style>
{% endblock %}

{% block body %}
<div class="container mt-4">

    {# Titre #}
    <div class="mb-5 text-center">
        <h1 class="section-title glow-text">🎶 Playlists de Coaching</h1>
        <p class="text-muted">Progressez à votre rythme avec nos vidéos organisées par niveau</p>
    </div>

    {# Filtres #}
    <form method="get" class="row g-2 mb-5 filter-bar justify-content-center">
        <div class="col-md-4">
            <input type="text" name="q" class="form-control"
                   placeholder="🔍 Rechercher une playlist..."
                   value="{{ app.request.get('q') }}">
        </div>
        <div class="col-md-2">
            <select name="niveau" class="form-select">
                <option value="">Tous niveaux</option>
                <option value="debutant"      {{ app.request.get('niveau') == 'debutant' ? 'selected' }}>Débutant</option>
                <option value="intermediaire" {{ app.request.get('niveau') == 'intermediaire' ? 'selected' }}>Intermédiaire</option>
                <option value="avance"        {{ app.request.get('niveau') == 'avance' ? 'selected' }}>Avancé</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="categorie" class="form-select">
                <option value="">Toutes catégories</option>
                <option value="action"   {{ app.request.get('categorie') == 'action' ? 'selected' }}>Action</option>
                <option value="aventure" {{ app.request.get('categorie') == 'aventure' ? 'selected' }}>Aventure</option>
                <option value="sport"    {{ app.request.get('categorie') == 'sport' ? 'selected' }}>Sport</option>
                <option value="course"   {{ app.request.get('categorie') == 'course' ? 'selected' }}>Course</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-gamilha w-100">Filtrer</button>
        </div>
        {% if app.request.get('q') or app.request.get('niveau') or app.request.get('categorie') %}
            <div class="col-md-1">
                <a href="{{ path('playlistFront_index') }}" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        {% endif %}
    </form>

    {# Grille #}
    <div class="row g-4">
        {% for playlist in playlists %}
            <div class="col-lg-4 col-md-6">
                <div class="playlist-card h-100">

                    {% if playlist.image %}
                        <img src="{{ asset('uploads/playlists/' ~ playlist.image) }}"
                             alt="{{ playlist.title }}">
                    {% else %}
                        <div class="d-flex align-items-center justify-content-center bg-secondary"
                             style="height:200px;">
                            <i class="bi bi-collection-play fs-1 text-white-50"></i>
                        </div>
                    {% endif %}

                    <div class="p-3">
                        <h5 class="fw-bold mb-1">{{ playlist.title }}</h5>
                        <p class="small text-muted mb-2">
                            {{ playlist.description|slice(0, 100) }}{% if playlist.description|length > 100 %}...{% endif %}
                        </p>
                        <div class="d-flex gap-2 flex-wrap mb-3">
                            <span class="badge badge-{{ playlist.niveau }}">{{ playlist.niveau|capitalize }}</span>
                            <span class="badge badge-gamilha">{{ playlist.categorie|capitalize }}</span>
                            <span class="badge badge-gamilha ms-auto">
                                <i class="bi bi-film me-1"></i>{{ playlist.videos|length }} vidéo(s)
                            </span>
                        </div>
                        <a href="{{ path('playlistFront_show', {id: playlist.id}) }}"
                           class="btn btn-gamilha w-100">
                            <i class="bi bi-play-circle me-1"></i> Voir la playlist
                        </a>
                    </div>

                </div>
            </div>
        {% else %}
            <div class="col-12 text-center text-muted py-5">
                <i class="bi bi-collection-play fs-1 d-block mb-2 opacity-50"></i>
                <p>Aucune playlist disponible pour le moment.</p>
            </div>
        {% endfor %}
    </div>

</div>
{% endblock %}
