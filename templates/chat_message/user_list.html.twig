{% extends 'base_front.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}

{% block body %}
<div class="container py-4">

    <!-- En-tête -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 gap-3">
        <h1 class="text-white d-flex align-items-center mb-0">
            <i class="bi bi-people text-primary me-2"></i>
            Liste des utilisateurs
        </h1>
    </div>

    <!-- Barre de recherche -->
    <div class="card bg-dark border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-lg-6">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-secondary border-0 text-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input 
                            id="searchInput" 
                            type="text" 
                            class="form-control bg-secondary text-white border-0 shadow-none" 
                            placeholder="Rechercher par nom ou email..." 
                            aria-label="Rechercher">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tableau -->
    <div class="card bg-dark border-0 shadow-lg">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" id="usersTable">
                    <thead class="text-secondary text-uppercase small border-bottom border-primary border-opacity-25">
                        <tr>
                            <th>Nom</th>
                            <th>Email</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for user in users %}
                            <tr class="border-bottom border-secondary border-opacity-10">
                                <td class="name fw-semibold text-white">
                                    {{ user.name ?: user.username ?: '—' }}
                                </td>
                                <td class="email">{{ user.email }}</td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <a href="{{ path('chat_conversation', {'recipientId': user.id}) }}"
                                           class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-chat-dots"></i>
                                            Message
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center py-5 text-secondary">
                                    <i class="bi bi-people fs-1 d-block mb-2"></i>
                                    Aucun utilisateur trouvé
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

<!-- JavaScript : recherche uniquement sur nom OU email -->
<script>
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const table       = document.getElementById('usersTable');
    const tbody       = table.querySelector('tbody');
    const rows        = Array.from(tbody.querySelectorAll('tr:not(:has(td[colspan]))'));

    function updateTable() {
        const searchText = searchInput.value.toLowerCase().trim();

        // On garde toutes les lignes qui contiennent le texte dans le nom OU dans l'email
        const filteredRows = rows.filter(row => {
            const name  = row.querySelector('.name')?.textContent.toLowerCase() || '';
            const email = row.querySelector('.email')?.textContent.toLowerCase() || '';

            return name.includes(searchText) || email.includes(searchText);
        });

        // On vide et on remet les lignes correspondantes
        tbody.innerHTML = '';
        filteredRows.forEach(row => tbody.appendChild(row));

        // Si aucun résultat et qu'il y avait des lignes au départ
        if (filteredRows.length === 0 && rows.length > 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="text-center py-5 text-secondary">
                        <i class="bi bi-search fs-1 d-block mb-2"></i>
                        Aucun utilisateur ne correspond à votre recherche
                    </td>
                </tr>
            `;
        }
    }

    // Recherche en temps réel (à chaque frappe)
    searchInput.addEventListener('input', updateTable);
});
</script>
{% endblock %}