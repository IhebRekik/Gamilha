{% extends 'base.html.twig' %}

{% block title %}Chat Messages
{% endblock %}

{% block body %}
	<div class="container py-4">

		<div class="d-flex justify-content-between align-items-center mb-4">
			<h1 class="text-white">
				<i class="bi bi-chat-dots text-primary me-2"></i>
				Chat Messages
			</h1>

			
		</div>

		{# Search bar #}
		<div class="card bg-dark border-0 shadow-lg mb-3">
			<div class="card-body">
				<input type="text" id="searchInput" class="form-control bg-secondary border-0 text-white" placeholder="Rechercher un message...">
			</div>
		</div>

		<div class="card bg-dark border-0 shadow-lg">
			<div class="card-body p-0">
				<div class="table-responsive">
					<table class="table table-dark table-hover align-middle mb-0" id="chatTable">
						<thead class="text-secondary text-uppercase small border-bottom border-primary border-opacity-25">
							<tr>
								<th class="ps-4">ID</th>
								<th>Content</th>
								<th>Created At</th>
                                <th>Sender</th>
                                <th>Recipient</th>
								<th class="text-end pe-4">Actions</th>
							</tr>
						</thead>

						<tbody>
							{% for chat_message in chat_messages %}
								<tr class="border-bottom border-secondary border-opacity-10">
									<td class="ps-4 text-secondary">#{{ chat_message.id }}</td>
									<td class="message-content">{{ chat_message.content }}</td>
									<td>
										{{ chat_message.createdAt ? chat_message.createdAt|date('Y-m-d H:i') : '' }}
									</td>
									
									<td>
										{{ chat_message.sender.name }}
									</td>
									<td>
										{{ chat_message.recipient.name }}

									</td>

									<td class="text-end pe-4">
										<div class="btn-group shadow-sm">
											<a href="{{ path('app_chat_message_show', {'id': chat_message.id}) }}" class="btn btn-sm btn-outline-info">
												<i class="bi bi-eye"></i>
											</a>

											<a href="{{ path('app_chat_message_edit', {'id': chat_message.id}) }}" class="btn btn-sm btn-outline-warning">
												<i class="bi bi-pencil"></i>
											</a>
										</div>
									</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="5" class="text-center py-5 text-secondary">
										<i class="bi bi-inbox fs-1 d-block mb-2"></i>
										Aucun message trouvé
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		</div>

	</div>

	{# Simple frontend search #}
	<script>
		document.getElementById("searchInput").addEventListener("keyup", function () {
let filter = this.value.toLowerCase();
let rows = document.querySelectorAll("#chatTable tbody tr");

rows.forEach(row => {
let text = row.innerText.toLowerCase();
row.style.display = text.includes(filter) ? "" : "none";
});
});
	</script>

{% endblock %}
