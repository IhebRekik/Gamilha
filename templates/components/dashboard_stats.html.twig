					<small class="text-white">Free / Pro / Elite</small>
				</div>
			</div>
			<div class="card-body p-4 d-flex justify-content-center align-items-center">
				<canvas id="subscriptionChart" height="240"></canvas>
			</div>
		</div>
	</div>

</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script><script>
// Configuration commune pour tous les charts
const commonOptions = {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
        legend: {
            labels: {
                color: '#e0e0ff',
                font: { size: 13 }
            }
        },
        tooltip: {
            backgroundColor: '#2a004f',
            titleColor: '#fff',
            bodyColor: '#e0e0ff'
        }
    },
    scales: {
        x: {
            ticks: { color: '#e0e0ff' },
            grid: { color: 'rgba(255,255,255,0.05)' }
        },
        y: {
            ticks: { color: '#e0e0ff' },
            grid: { color: 'rgba(255,255,255,0.05)' }
        }
    }
};

// 1️⃣ Croissance Utilisateurs
new Chart(document.getElementById('userGrowthChart'), {
    type: 'line',
    data: {
        labels: userGrowth.labels,
        datasets: [{
            label: 'Utilisateurs',
            data: userGrowth.data,
            borderColor: '#c084fc',
            backgroundColor: 'rgba(192,132,252,0.2)',
            tension: 0.4,
            fill: true
        }]
    },
    options: commonOptions
});

// 2️⃣ Revenus Mensuels
new Chart(document.getElementById('revenueChart'), {
    type: 'bar',
    data: {
        labels: revenueGrowth.labels,
        datasets: [{
            label: 'Revenus (€)',
            data: revenueGrowth.data,
            backgroundColor: '#34d399'
        }]
    },
    options: commonOptions
});

// 3️⃣ Tournois par jeu (horizontal)
new Chart(document.getElementById('gamesChart'), {
    type: 'bar',
    data: {
        labels: gamesStats.labels,
        datasets: [{
            label: 'Tournois actifs',
            data: gamesStats.data,
            backgroundColor: '#3b82f6'
        }]
    },
    options: {
        ...commonOptions,
        indexAxis: 'y'
    }
});

// 4️⃣ Répartition Abonnements
new Chart(document.getElementById('subscriptionChart'), {
    type: 'doughnut',
    data: {
        labels: subscriptionStats.labels,
        datasets: [{
            data: subscriptionStats.data,
            backgroundColor: ['#6b7280','#a78bfa','#f472b6']
        }]
    },
    options: {
        ...commonOptions,
        cutout: '65%'
    }
});
</script>
<div class="card bg-dark border-0 mt-2 shadow-lg text-white">

<div class="card-header d-flex align-items-center">
	<i class="bi bi-activity me-2"></i>
	<h5 class="mb-0">Activité Récente</h5>
</div>
</div>
