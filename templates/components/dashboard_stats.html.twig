<script>
const userGrowth = {{ this.getUserGrowth()|json_encode|raw }};
const revenueGrowth = {{ this.getRevenueGrowth()|json_encode|raw }};
const subscriptionStats = {{ this.getSubscriptionStats()|json_encode|raw }};
const gamesStats = {{ this.getGamesStats()|json_encode|raw }};
</script>
<div data-poll="15000|$refresh" class="row g-4 mb-5">

    <div class="col-md-3">
		<div class="card bg-dark border-0 shadow-lg text-white h-100">
			<div class="card-body text-center d-flex flex-column justify-content-center">
				<h2 class="fw-bold mb-1">{{ this.getUsersCount() }}</h2>
				<div class="text-success small">Nombre total des utilisateurs</div>
			</div>
		</div>
	</div>
	<!-- Utilisateurs -->
	<div class="col-md-3">
		<div class="card bg-dark border-0 shadow-lg text-white h-100">
			<div class="card-body text-center d-flex flex-column justify-content-center">
				<h2 class="fw-bold mb-1">{{ this.getUsersEvolution()|round(0, 'floor') }}%</h2>
				<div class="text-success small">Evolution de Utilisateurs de ce mois</div>
			</div>
		</div>
	</div>

	<!-- Tournois Actifs -->
	<div class="col-md-3">
		<div class="card bg-dark border-0 shadow-lg text-white h-100">
			<div class="card-body text-center d-flex flex-column justify-content-center">
                <h2 class="fw-bold mb-1">{{ this.getTournamentsEvolution()|round(0, 'floor') }}%</h2>
				<div class="text-success small">Evolution de Tournois de ce mois</div>
                
			</div>
		</div>
	</div>

	<!-- Streams en direct -->
	<div class="col-md-3">
		<div class="card bg-dark border-0 shadow-lg text-white h-100">
			<div class="card-body text-center d-flex flex-column justify-content-center">
				<h2 class="fw-bold mb-1">{{ this.getStreamsEvolution()|round(0, 'floor') }}%</h2>
                <div class="text-success small">Evolution de Streams de ce mois</div>

			</div>
		</div>
	</div>

	<!-- Revenus Mensuels -->
	<div class="col-md-3">
		<div class="card bg-dark border-0 shadow-lg text-white h-100">
			<div class="card-body text-center d-flex flex-column justify-content-center">
				<div class="fs-6 mb-2 text-muted">Revenus Mensuels</div>
				<h2 class="fw-bold mb-1">{{ this.getRevenueEvolution()|round(0, 'floor') }}%</h2>
				<div class="text-success small">Evolution de Revenu de ce mois</div>
			</div>
		</div>
	</div>

</div>
<div
	class="row g-4 mt-5">

	<!-- 1. Croissance Utilisateurs -->
	<div class="col-xl-6">
		<div class="card bg-dark bg-gradient border-0 shadow-lg overflow-hidden h-100">
			<div class="card-header d-flex align-items-center bg-gradient-primary border-bottom-0 py-3">
				<i class="bi bi-graph-up-arrow fs-4 me-3 text-white"></i>
				<div>
					<h5 class="mb-0 text-white fw-semibold">Croissance Utilisateurs</h5>
					<small class="text-white">Sur les 6 derniers mois</small>
				</div>
			</div>
			<div class="card-body p-4">
				<canvas id="userGrowthChart" height="220"></canvas>
			</div>
		</div>
	</div>

	<!-- 2. Revenus Mensuels -->
	<div class="col-xl-6">
		<div class="card bg-dark bg-gradient border-0 shadow-lg overflow-hidden h-100">
			<div class="card-header d-flex align-items-center bg-gradient-success border-bottom-0 py-3">
				<i class="bi bi-currency-euro fs-4 me-3 text-white"></i>
				<div>
					<h5 class="mb-0 text-white fw-semibold">Revenus Mensuels</h5>
					<small class="text-white">Évolution des revenus</small>
				</div>
			</div>
			<div class="card-body p-4">
				<canvas id="revenueChart" height="220"></canvas>
			</div>
		</div>
	</div>

	<!-- 3. Tournois par jeu -->
	<div class="col-xl-6">
		<div class="card bg-dark bg-gradient border-0 shadow-lg overflow-hidden h-100">
			<div class="card-header d-flex align-items-center bg-gradient-info border-bottom-0 py-3">
				<i class="bi bi-controller fs-4 me-3 text-white"></i>
