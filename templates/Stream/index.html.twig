{% extends 'base.html.twig' %}

{% block body %}


<a href="{{ path('stream_discover') }}"
   class="btn btn-light rounded-pill me-2">
   Découvrir
</a>

<form method="get" action="{{ path('stream_discover') }}" class="d-flex gap-2 mb-4">
    <input type="text" name="q" class="form-control"
           placeholder="Chercher un stream..."
           value="{{ query|default('') }}"
>

    <select name="game" class="form-select">
        <option value="">Tous les jeux</option>
        <option value="CS2">CS2</option>
        <option value="Valorant">Valorant</option>
        <option value="LoL">League of Legends</option>
        <option value="LoL">Dota 2</option>
    </select>

    <select name="sort" class="form-select">
        <option value="">Plus récents</option>
        <option value="viewers">Plus regardés</option>
    </select>

    <button class="btn btn-primary">🔍</button>
</form>

<div class="d-flex justify-content-end mb-3">
    <button class="btn btn-danger rounded-pill px-3 py-2"
            data-bs-toggle="modal"
            data-bs-target="#launchStreamModal">
            <span class="live-dot">⦿</span>
         Lancer un Stream
    </button>
</div>
<h1>Liste des Streams</h1>

<div class="row g-3">
    {% for stream in streams %}
        <div class="col-md-4">
            <div class="card bg-dark border-0 h-100 rounded-4 overflow-hidden stream-card">
                <div class="position-relative">
                    {% if stream.thumbnail %}
                        <img src="{{ stream.thumbnail }}" class="img-fluid rounded-top" style="height:180px; object-fit:cover;">
                    {% else %}
                        <img src="https://plus.unsplash.com/premium_photo-1664910441926-b86731baa43b?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8c3RyZWFtZXJ8ZW58MHx8MHx8fDA%3D" class="img-fluid rounded-top">
                    {% endif %}

                    <span class="badge bg-danger position-absolute top-0 start-0 m-2">LIVE</span>
                    <span class="badge bg-dark position-absolute bottom-0 end-0 m-2">
                        👁 {{ stream.viewers }}
                    </span>
                </div>
                <div class="card-body">
                    <h6 class="fw-bold text-white mb-1">{{ stream.title }}</h6>
                    <small class="text-secondary d-block mb-1">{{ stream.description ? stream.description|slice(0, 60) ~ '…' : 'Live en cours' }}</small>
                    <p class="text-info small mb-0">{{ stream.game }}</p>
                </div>
            </div>
        </div>
    {% endfor %}
</div>

<div class="modal fade" id="launchStreamModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content bg-dark text-white">

      {{ form_start(form) }}

      <div class="modal-header">
        <h5 class="modal-title">Lancer un nouveau Stream</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <div class="mb-3">
            {{ form_label(form.title) }}
            {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.game) }}
            {{ form_widget(form.game, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.game) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.thumbnail) }}
            {{ form_widget(form.thumbnail, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.thumbnail) }}
        </div>

      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            Fermer
        </button>
         <button type="submit"
            class="btn btn-danger rounded-pill px-4">
        🔴 Ajouter le Stream
    </button>

      {{ form_end(form) }}

    </div>
  </div>
</div>


{% endblock %}
