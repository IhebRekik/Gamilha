{% extends 'base_front.html.twig' %}

{% block title %}{{ equipe.nomEquipe }} — Gamilha{% endblock %}

{% block body %}
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb text-muted">
        <li class="breadcrumb-item"><a href="{{ path('app_homepage') }}" class="text-muted text-decoration-none">Accueil</a></li>
        <li class="breadcrumb-item"><a href="{{ path('front_equipe_index') }}" class="text-muted text-decoration-none">Équipes</a></li>
        <li class="breadcrumb-item active text-white">{{ equipe.nomEquipe }}</li>
    </ol>
</nav>

<div class="card card-front overflow-hidden">
    <div class="card-body p-4 p-md-5">
        <div class="d-flex flex-md-row flex-column align-items-center gap-4 mb-4">
            {% if equipe.logo %}
            <img src="{{ equipe.logo }}" alt="{{ equipe.nomEquipe }}" class="rounded-4 shadow" width="120" height="120" style="object-fit: cover;">
            {% else %}
            <div class="rounded-4 bg-dark border border-secondary d-flex align-items-center justify-content-center text-muted" style="width: 120px; height: 120px;">
                <i class="bi bi-people-fill display-4"></i>
            </div>
            {% endif %}
            <div class="flex-grow-1 text-center text-md-start">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h1 class="h2 fw-bold text-white mb-2">{{ equipe.nomEquipe }}</h1>
                        {% if equipe.tag %}
                        <span class="badge badge-gamilha fs-6 me-2">{{ equipe.tag }}</span>
                        {% endif %}
                        <span class="badge bg-dark text-info border border-info">{{ equipe.niveau }}</span>
                        {% if equipe.pays %}
                        <p class="text-muted mt-2 mb-0"><i class="bi bi-geo-alt me-1"></i>{{ equipe.pays }}</p>
                        {% endif %}
                        {% if equipe.dateCreation %}
                        <p class="text-muted small mb-0">Créée le {{ equipe.dateCreation|date('d/m/Y') }}</p>
                        {% endif %}
                    </div>
                    {% if isOwner %}
                    <div class="d-flex gap-2">
                        <a href="{{ path('front_equipe_edit', { idEquipe: equipe.idEquipe }) }}" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil me-1"></i> Modifier
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {% if equipe.owner %}
        <div class="mb-3">
            <small class="text-muted">
                <i class="bi bi-person-badge me-1"></i>
                Propriétaire : <span class="text-white">{{ equipe.owner.name }}</span>
            </small>
        </div>
        {% endif %}

        {% if equipe.members|length > 0 %}
        <div class="mt-4">
            <h3 class="h5 text-white mb-3">
                <i class="bi bi-people-fill me-2"></i>
                Membres ({{ equipe.members|length }})
            </h3>
            <div class="row g-2">
                {% for member in equipe.members %}
                <div class="col-md-6 col-lg-4">
                    <div class="d-flex align-items-center gap-2 p-2 bg-dark rounded">
                        <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                            <i class="bi bi-person-fill text-white"></i>
                        </div>
                        <span class="text-white">{{ member.name }}</span>
                        {% if member == equipe.owner %}
                        <span class="badge bg-primary ms-auto">Propriétaire</span>
                        {% elseif isOwner %}
                        <form method="post" action="{{ path('front_equipe_remove_member', { idEquipe: equipe.idEquipe, userId: member.id }) }}" class="ms-auto d-inline">
                            <input type="hidden" name="_token" value="{{ csrf_token('remove_member' ~ equipe.idEquipe ~ member.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Retirer ce membre de l\'équipe ?');">
                                <i class="bi bi-x"></i>
                            </button>
                        </form>
                        {% endif %}
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
        {% else %}
        <div class="text-center py-4 text-muted">
            <i class="bi bi-people display-6 d-block mb-2"></i>
            <p>Aucun membre pour le moment.</p>
        </div>
        {% endif %}
    </div>
</div>
{% endblock %}
