{% extends 'base_front.html.twig' %}

{% block title %}Mes équipes — Gamilha{% endblock %}

{% block body %}
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb text-muted">
        <li class="breadcrumb-item"><a href="{{ path('app_homepage') }}" class="text-muted text-decoration-none">Accueil</a></li>
        <li class="breadcrumb-item"><a href="{{ path('front_equipe_index') }}" class="text-muted text-decoration-none">Équipes</a></li>
        <li class="breadcrumb-item active text-white">Mes équipes</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="section-title d-flex align-items-center gap-2 mb-0">
        <i class="bi bi-people-fill text-primary"></i>
        Mes équipes
    </h1>
    <div class="d-flex gap-2">
        <a href="{{ path('front_equipe_my_participations') }}" class="btn btn-outline-info">
            <i class="bi bi-calendar-check me-1"></i> Mes participations
        </a>
        <a href="{{ path('front_equipe_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Créer une équipe
        </a>
    </div>
</div>

{% if equipes|length > 0 %}
<div class="row g-4">
    {% for equipe in equipes %}
    <div class="col-md-6 col-lg-4">
        <div class="card card-front h-100">
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    {% if equipe.logo %}
                    <img src="{{ equipe.logo }}" alt="{{ equipe.nomEquipe }}" class="rounded-3" width="56" height="56" style="object-fit: cover;">
                    {% else %}
                    <div class="rounded-3 bg-dark d-flex align-items-center justify-content-center text-muted" style="width: 56px; height: 56px;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    {% endif %}
                    <div class="flex-grow-1 min-w-0">
                        <h5 class="card-title fw-bold text-white mb-1">{{ equipe.nomEquipe }}</h5>
                        <p class="text-muted small mb-0">
                            {% if equipe.tag %}<span class="badge badge-gamilha me-1">{{ equipe.tag }}</span>{% endif %}
                            {{ equipe.niveau }}
                        </p>
                    </div>
                </div>
                <div class="mb-3">
                    <small class="text-muted">
                        <i class="bi bi-people me-1"></i>{{ equipe.members|length }} membre(s)
                    </small>
                </div>
                <div class="d-flex gap-2">
                    <a href="{{ path('front_equipe_show', { idEquipe: equipe.idEquipe }) }}" class="btn btn-sm btn-outline-info flex-fill">
                        <i class="bi bi-eye me-1"></i> Voir
                    </a>
                    <a href="{{ path('front_equipe_edit', { idEquipe: equipe.idEquipe }) }}" class="btn btn-sm btn-outline-warning flex-fill">
                        <i class="bi bi-pencil me-1"></i> Modifier
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% else %}
<div class="card card-front">
    <div class="card-body text-center py-5">
        <i class="bi bi-people display-4 text-muted mb-3"></i>
        <p class="text-muted mb-4">Vous n'avez créé aucune équipe pour le moment.</p>
        <a href="{{ path('front_equipe_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> Créer votre première équipe
        </a>
    </div>
</div>
{% endif %}
{% endblock %}
