{% extends 'base_front.html.twig' %}

{% block title %}Équipes — Gamilha{% endblock %}

{% block body %}
<section class="mb-4">
    <h1 class="section-title d-flex align-items-center gap-2">
        <i class="bi bi-people-fill text-primary"></i>
        Équipes
    </h1>
    <p class="text-muted">Découvrez les équipes qui s'affrontent en tournoi.</p>
</section>

{% if equipes|length > 0 %}
<div class="row g-4">
    {% for equipe in equipes %}
    <div class="col-md-6 col-lg-4">
        <a href="{{ path('front_equipe_show', { idEquipe: equipe.idEquipe }) }}" class="text-decoration-none text-reset">
            <div class="card card-front h-100">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    {% if equipe.logo %}
                    <img src="{{ equipe.logo }}" alt="{{ equipe.nomEquipe }}" class="rounded-3" width="56" height="56" style="object-fit: cover;">
                    {% else %}
                    <div class="rounded-3 bg-dark d-flex align-items-center justify-content-center text-muted" style="width: 56px; height: 56px;">
                        <i class="bi bi-people-fill fs-4"></i>
                    </div>
                    {% endif %}
                    <div class="flex-grow-1 min-w-0">
                        <h5 class="card-title fw-bold text-white mb-1">{{ equipe.nomEquipe }}</h5>
                        <p class="text-muted small mb-0">
                            {% if equipe.tag %}<span class="badge badge-gamilha me-1">{{ equipe.tag }}</span>{% endif %}
                            {{ equipe.niveau }}
                            {% if equipe.pays %} · {{ equipe.pays }}{% endif %}
                        </p>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </div>
            </div>
        </a>
    </div>
    {% endfor %}
</div>
{% else %}
<div class="card card-front">
    <div class="card-body text-center py-5">
        <i class="bi bi-people display-4 text-muted mb-3"></i>
        <p class="text-muted mb-0">Aucune équipe pour le moment.</p>
    </div>
</div>
{% endif %}
{% endblock %}
