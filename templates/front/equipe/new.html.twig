{% extends 'base_front.html.twig' %}

{% block title %}Créer une équipe — Gamilha{% endblock %}

{% block body %}
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb text-muted">
        <li class="breadcrumb-item"><a href="{{ path('app_homepage') }}" class="text-muted text-decoration-none">Accueil</a></li>
        <li class="breadcrumb-item"><a href="{{ path('front_equipe_index') }}" class="text-muted text-decoration-none">Équipes</a></li>
        <li class="breadcrumb-item"><a href="{{ path('front_equipe_my_teams') }}" class="text-muted text-decoration-none">Mes équipes</a></li>
        <li class="breadcrumb-item active text-white">Créer une équipe</li>
    </ol>
</nav>

<div class="card card-front">
    <div class="card-body p-4 p-md-5">
        <h1 class="h3 mb-4 text-white">
            <i class="bi bi-plus-circle-fill text-primary me-2"></i>
            Créer une équipe
        </h1>

        {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
        <div class="row g-3">
            <div class="col-md-6">
                {{ form_row(form.nomEquipe, {
                    'attr': {'class': 'form-control bg-dark text-white border-secondary'},
                    'label_attr': {'class': 'form-label text-white fw-semibold'}
                }) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.tag, {
                    'attr': {'class': 'form-control bg-dark text-white border-secondary'},
                    'label_attr': {'class': 'form-label text-white fw-semibold'}
                }) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.logo, {
                    'attr': {'class': 'form-control bg-dark text-white border-secondary'},
                    'label_attr': {'class': 'form-label text-white fw-semibold'}
                }) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.pays, {
                    'attr': {'class': 'form-control bg-dark text-white border-secondary'},
                    'label_attr': {'class': 'form-label text-white fw-semibold'}
                }) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.dateCreation, {
                    'attr': {'class': 'form-control bg-dark text-white border-secondary'},
                    'label_attr': {'class': 'form-label text-white fw-semibold'}
                }) }}
            </div>
            <div class="col-md-6">
                {{ form_row(form.niveau, {
                    'attr': {'class': 'form-select bg-dark text-white border-secondary'},
                    'label_attr': {'class': 'form-label text-white fw-semibold'}
                }) }}
            </div>
            <div class="col-12">
                {{ form_row(form.members, {
                    'attr': {'class': 'form-select bg-dark text-white border-secondary'},
                    'label_attr': {'class': 'form-label text-white fw-semibold'}
                }) }}
                <small class="form-text text-muted">Sélectionnez les membres de votre équipe. Vous serez automatiquement ajouté comme membre.</small>
            </div>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <a href="{{ path('front_equipe_my_teams') }}" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle me-1"></i> Annuler
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save-fill me-1"></i> Créer l'équipe
            </button>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
