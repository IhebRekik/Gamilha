{% extends 'base_front.html.twig' %}

{% block title %}{{ evenement.nom }} — Gamilha{% endblock %}

{% block body %}
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb text-muted">
        <li class="breadcrumb-item"><a href="{{ path('app_homepage') }}" class="text-muted text-decoration-none">Accueil</a></li>
        <li class="breadcrumb-item"><a href="{{ path('front_evenement_index') }}" class="text-muted text-decoration-none">Événements</a></li>
        <li class="breadcrumb-item active text-white">{{ evenement.nom }}</li>
    </ol>
</nav>

<div class="card card-front mb-4 overflow-hidden">
    {% if evenement.image %}
    <img src="{{ evenement.image }}" alt="{{ evenement.nom }}" class="card-img-top w-100" style="max-height: 320px; object-fit: cover;">
    {% endif %}
    <div class="card-body p-4 p-md-5">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="badge badge-gamilha">{{ evenement.jeu }}</span>
            <span class="badge bg-dark text-info border border-info">{{ evenement.statut }}</span>
            <span class="badge bg-dark text-secondary border border-secondary">{{ evenement.typeEvenement }}</span>
        </div>
        <h1 class="h2 fw-bold text-white mb-3">{{ evenement.nom }}</h1>
        <p class="text-muted mb-4">{{ evenement.description ?? 'Aucune description.' }}</p>
        <div class="row g-3 text-muted small align-items-center">
            <div class="col-auto"><i class="bi bi-calendar3 me-1"></i>Début : {{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y') : '—' }}</div>
            <div class="col-auto"><i class="bi bi-calendar3-event me-1"></i>Fin : {{ evenement.dateFin ? evenement.dateFin|date('d/m/Y') : '—' }}</div>
            {% if is_owner|default(false) %}
            <div class="col-auto ms-auto">
                <div class="btn-group">
                    <a href="{{ path('front_evenement_edit', { idEvenement: evenement.idEvenement }) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                    {% set bracket = evenement.brackets|first %}
                    {% if bracket and bracket.matchs|length > 0 %}
                    <a href="{{ path('front_evenement_edit_matches', { idEvenement: evenement.idEvenement }) }}" class="btn btn-sm btn-outline-info">Détails matchs</a>
                    {% elseif bracket %}
                    <a href="{{ path('front_evenement_tirage', { idEvenement: evenement.idEvenement }) }}" class="btn btn-sm btn-gamilha">Tirage au sort</a>
                    {% endif %}
                    <form method="post" action="{{ path('front_evenement_delete', { idEvenement: evenement.idEvenement }) }}" class="d-inline" onsubmit="return confirm('Supprimer cet événement ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.idEvenement) }}">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                    </form>
                </div>
            </div>
            {% endif %}
        </div>
        {% if evenement.regles %}
        <div class="mt-4 pt-3 border-top border-secondary">
            <h6 class="text-white fw-semibold mb-2">Règles</h6>
            <p class="text-muted small mb-0">{{ evenement.regles }}</p>
        </div>
        {% endif %}
    </div>
</div>

{% if bracketsWithRounds|length > 0 %}
<h2 class="section-title mt-5 mb-3">
    <i class="bi bi-diagram-3-fill text-warning me-2"></i>Brackets & matchs
</h2>
{% for bracketData in bracketsWithRounds %}
{% set bracket = bracketData.bracket %}
{% set matchsByTour = bracketData.matchsByTour %}
{% set rounds = bracketData.rounds %}
{% set matchs = bracket.matchs %}
<div class="card card-front mb-5 overflow-hidden bracket-card">
    <div class="card-header bg-transparent border-bottom border-secondary py-3 d-flex flex-wrap align-items-center gap-2">
        <span class="fw-semibold text-white">{{ bracket.typeBracket }}</span>
        <span class="badge badge-gamilha">{{ bracket.nombreTours }} tour(s)</span>
        <span class="badge bg-dark text-info border border-info">{{ bracket.statut }}</span>
    </div>
    <div class="card-body p-0">
        {% if matchs|length > 0 %}
        <div class="bracket-tree overflow-auto py-4 px-3">
            {% for tour in rounds %}
            <div class="bracket-round" data-round="{{ tour }}">
                <div class="round-label text-muted small text-center mb-2 fw-semibold text-uppercase">
                    {% if loop.last and rounds|length > 1 %}Finale{% elseif loop.revindex == 2 and rounds|length > 2 %}Demi-finales{% else %}Tour {{ tour }}{% endif %}
                </div>
                <div class="bracket-matches d-flex flex-column justify-content-around" style="min-height: {{ (matchsByTour[tour]|length * 120) }}px;">
                    {% for match in matchsByTour[tour] %}
                    <div class="bracket-match-wrapper">
                        <div class="bracket-match {% if match.statut == 'terminé' %}match-finished{% endif %}">
                            <div class="match-team match-team-top {% if match.statut == 'terminé' and match.equipeA and match.equipeB and match.scoreEquipeA > match.scoreEquipeB %}winner{% endif %}">
                                <span class="team-name">{{ match.equipeA ? match.equipeA.nomEquipe : 'TBD' }}</span>
                                <span class="team-score">{{ match.scoreEquipeA }}</span>
                            </div>
                            <div class="match-team match-team-bottom {% if match.statut == 'terminé' and match.equipeA and match.equipeB and match.scoreEquipeB > match.scoreEquipeA %}winner{% endif %}">
                                <span class="team-name">{{ match.equipeB ? match.equipeB.nomEquipe : 'TBD' }}</span>
                                <span class="team-score">{{ match.scoreEquipeB }}</span>
                            </div>
                            <div class="match-status-badge">
                                <span class="badge {% if match.statut == 'terminé' %}bg-success{% elseif match.statut == 'en cours' %}bg-warning text-dark{% else %}bg-secondary{% endif %}">{{ match.statut }}</span>
                            </div>
                            {% if match.dateMatch %}
                            <div class="match-date text-muted small">{{ match.dateMatch|date('d/m H:i') }}</div>
                            {% endif %}
                        </div>
                        {% if not loop.last %}
                        <div class="bracket-connector"></div>
                        {% endif %}
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% if not loop.last %}
            <div class="bracket-round-connector">
                <svg viewBox="0 0 40 100" preserveAspectRatio="none"><path d="M20 0 L20 50 L40 50 M20 50 L20 100" stroke="rgba(139, 92, 246, 0.4)" stroke-width="1.5" fill="none"/></svg>
            </div>
            {% endif %}
            {% endfor %}
        </div>
        <style>
        .bracket-tree { display: flex; align-items: center; gap: 0; padding: 24px 16px; }
        .bracket-round { flex: 0 0 auto; min-width: 240px; padding: 0 20px; display: flex; flex-direction: column; align-items: center; }
        .bracket-round-connector { flex: 0 0 32px; min-width: 32px; display: flex; align-items: center; justify-content: center; }
        .bracket-round-connector svg { width: 100%; height: 80px; }
        .bracket-matches { display: flex; flex-direction: column; justify-content: space-evenly; gap: 20px; width: 100%; }
        .bracket-match-wrapper { position: relative; }
        .bracket-match { background: linear-gradient(145deg, rgba(26, 26, 38, 0.98), rgba(18, 18, 26, 0.98)); border: 1px solid rgba(139, 92, 246, 0.3); border-radius: 14px; overflow: hidden; box-shadow: 0 6px 20px rgba(0,0,0,0.4); min-width: 220px; position: relative; transition: border-color 0.2s, transform 0.2s; }
        .bracket-match:hover { border-color: rgba(139, 92, 246, 0.5); transform: translateY(-2px); }
        .bracket-match.match-finished { border-color: rgba(34, 197, 94, 0.5); box-shadow: 0 6px 20px rgba(34, 197, 94, 0.1); }
        .match-team { display: flex; justify-content: space-between; align-items: center; padding: 12px 16px; border-bottom: 1px solid rgba(139, 92, 246, 0.12); min-height: 44px; }
        .match-team:last-of-type { border-bottom: none; }
        .match-team.winner { background: linear-gradient(90deg, rgba(34, 197, 94, 0.2), transparent); border-left: 3px solid #22c55e; }
        .match-team .team-name { color: #e2e8f0; font-weight: 600; font-size: 0.95rem; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 10px; }
        .match-team .team-score { background: rgba(139, 92, 246, 0.35); color: #c084fc; font-weight: 700; min-width: 36px; text-align: center; padding: 6px 10px; border-radius: 10px; font-size: 1rem; }
        .match-team.winner .team-score { background: rgba(34, 197, 94, 0.5); color: #4ade80; }
        .match-status-badge { position: absolute; top: 10px; right: 10px; }
        .match-date { position: absolute; bottom: 8px; left: 16px; font-size: 0.72rem; opacity: 0.8; }
        .round-label { letter-spacing: 0.1em; }
        .bracket-connector { height: 16px; }
        @media (max-width: 768px) { .bracket-tree { flex-direction: column; } .bracket-round-connector { transform: rotate(90deg); height: 24px; } }
        </style>
        {% else %}
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-trophy display-6 mb-2"></i>
            <p class="mb-0">Aucun match dans ce bracket pour le moment.</p>
        </div>
        {% endif %}
    </div>
</div>
{% endfor %}
{% else %}
<div class="card card-front">
    <div class="card-body text-center py-5 text-muted">
        <i class="bi bi-diagram-3 display-6 mb-2"></i>
        <p class="mb-0">Aucun bracket associé à cet événement.</p>
    </div>
</div>
{% endif %}

{% if similarEvents|length > 0 %}
<h2 class="section-title mt-5 mb-3">
    <i class="bi bi-collection-play text-warning me-2"></i>Événements similaires
</h2>
<div class="row g-4">
    {% for similarEvent in similarEvents %}
    <div class="col-12 col-md-6 col-lg-3">
        <a href="{{ path('front_evenement_show', { idEvenement: similarEvent.idEvenement }) }}" class="text-decoration-none">
            <div class="card card-front h-100 similar-event-card">
                {% if similarEvent.image %}
                <img src="{{ similarEvent.image }}" alt="{{ similarEvent.nom }}" class="card-img-top" style="height: 140px; object-fit: cover;">
                {% endif %}
                <div class="card-body p-3">
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <span class="badge badge-gamilha small">{{ similarEvent.jeu }}</span>
                        <span class="badge bg-dark text-info border border-info small">{{ similarEvent.statut }}</span>
                    </div>
                    <h6 class="text-white mb-1">{{ similarEvent.nom }}</h6>
                    <p class="text-muted small mb-2">{{ similarEvent.description|length > 80 ? similarEvent.description|slice(0, 80) ~ '...' : similarEvent.description }}</p>
                    <div class="text-muted small">
                        <i class="bi bi-calendar3 me-1"></i>{{ similarEvent.dateDebut ? similarEvent.dateDebut|date('d/m/Y') : '—' }}
                    </div>
                </div>
            </div>
        </a>
    </div>
    {% endfor %}
</div>
<style>
.similar-event-card { transition: transform 0.2s, border-color 0.2s; }
.similar-event-card:hover { transform: translateY(-4px); border-color: rgba(139, 92, 246, 0.5); }
</style>
{% else %}
<div class="alert alert-info mt-5">
    <i class="bi bi-info-circle me-2"></i>Aucun événement similaire trouvé.
</div>
{% endif %}
{% endblock %}
