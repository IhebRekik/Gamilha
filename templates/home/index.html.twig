{% extends 'base_front.html.twig' %}

{% block title %}Gamilha — Accueil{% endblock %}

{% block body %}
<section class="hero-section text-center py-5 mb-5">
    <h1 class="display-4 fw-bold mb-3 glow-text">
        Bienvenue sur <span class="text-gradient-violet">Gamilha</span>
    </h1>
    <p class="lead text-secondary mb-4 mx-auto" style="max-width: 560px;">
        Suivez les tournois e-sport, les événements et les équipes. Résultats en direct et brackets.
    </p>
    <div class="d-flex flex-wrap gap-3 justify-content-center">
        <a href="{{ path('front_evenement_index') }}" class="btn btn-gamilha btn-lg">
            <i class="bi bi-calendar-event me-2"></i>Voir les événements
        </a>
        <a href="{{ path('front_equipe_index') }}" class="btn btn-outline-light btn-lg rounded-3">
            <i class="bi bi-people-fill me-2"></i>Équipes
        </a>
    </div>
</section>

<section class="mb-5">
    <h2 class="section-title d-flex align-items-center gap-2">
        <i class="bi bi-trophy-fill text-warning"></i>
        Événements à suivre
    </h2>
    {% if evenements|length > 0 %}
    <div class="row g-4">
        {% for evenement in evenements %}
        <div class="col-md-6 col-lg-4">
            <a href="{{ path('front_evenement_show', { idEvenement: evenement.idEvenement }) }}" class="text-decoration-none text-reset">
                <div class="card card-front h-100">
                    {% if evenement.image %}
                    <img src="{{ evenement.image }}" alt="{{ evenement.nom }}" class="card-img-top w-100" style="height: 180px; object-fit: cover;">
                    {% else %}
                    <div class="card-img-top bg-dark d-flex align-items-center justify-content-center text-muted" style="height: 180px;">
                        <i class="bi bi-calendar-event display-4"></i>
                    </div>
                    {% endif %}
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge badge-gamilha">{{ evenement.jeu }}</span>
                            <span class="badge bg-dark text-info border border-info">{{ evenement.statut }}</span>
                        </div>
                        <h5 class="card-title fw-bold text-white mb-2">{{ evenement.nom }}</h5>
                        <p class="text-muted small mb-3">{{ evenement.description ? evenement.description|slice(0, 100) ~ '…' : 'Aucune description.' }}</p>
                        <div class="d-flex gap-2 flex-wrap">
                            <span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>{{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y') : '—' }}</span>
                            <span class="text-muted small"><i class="bi bi-geo me-1"></i>{{ evenement.typeEvenement }}</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
        {% endfor %}
    </div>
    <div class="text-center mt-4">
        <a href="{{ path('front_evenement_index') }}" class="btn btn-outline-secondary rounded-3">Tous les événements</a>
    </div>
    {% else %}
    <div class="card card-front">
        <div class="card-body text-center py-5">
            <i class="bi bi-calendar-x display-4 text-muted mb-3"></i>
            <p class="text-muted mb-0">Aucun événement pour le moment.</p>
            <a href="{{ path('admin_evenement_new') }}" class="btn btn-gamilha mt-3">Créer un événement (admin)</a>
        </div>
    </div>
    {% endif %}
</section>
{% endblock %}
