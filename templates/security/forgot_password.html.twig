{% extends 'base_login.html.twig' %}

{% block body %}
<div class="d-flex align-items-center justify-content-center" style="min-height:70vh;">
    <div class="card-front p-4" style="width: 100%; max-width: 420px;">
        <h3 class="text-center mb-2 text-gradient-violet">Mot de passe oublié ?</h3>
        <p class="text-center text-muted mb-4">
            <small>Entrez votre email et nous vous enverrons un code de vérification</small>
        </p>

        {# Affichage des erreurs #}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <div class="d-flex align-items-start">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div class="flex-grow-1">
                        <strong>Erreur</strong>
                        <p class="mb-0 mt-1">{{ message }}</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <div class="d-flex align-items-start">
                    <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                    <div class="flex-grow-1">
                        <strong>Succès</strong>
                        <p class="mb-0 mt-1">{{ message }}</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <form method="post">
            <div class="mb-4">
                <label class="form-label">
                    <i class="bi bi-envelope me-1"></i>Adresse email
                </label>
                <input type="email" 
                       name="email" 
                       class="form-control"
                       placeholder="votre.email@exemple.com"
                       required
                       autofocus>
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>L'email associé à votre compte
                </small>
            </div>

            <button class="btn btn-gamilha w-100 mb-3" type="submit">
                <i class="bi bi-send me-2"></i>Envoyer le code
            </button>

            <div class="text-center">
                <small class="text-muted">
                    <a href="{{ path('app_login') }}" class="text-decoration-none">
                        <i class="bi bi-arrow-left"></i> Retour à la connexion
                    </a>
                </small>
            </div>
        </form>
    </div>
</div>

<style>
    .alert-danger {
        background: linear-gradient(135deg, rgba(220, 53, 69, 0.1) 0%, rgba(220, 53, 69, 0.05) 100%);
        border: 1px solid rgba(220, 53, 69, 0.3);
        border-radius: 10px;
        color: #dc3545;
    }

    .alert-success {
        background: linear-gradient(135deg, rgba(40, 167, 69, 0.1) 0%, rgba(40, 167, 69, 0.05) 100%);
        border: 1px solid rgba(40, 167, 69, 0.3);
        border-radius: 10px;
        color: #28a745;
    }

    .card-front {
        backdrop-filter: blur(10px);
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }

    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(130, 87, 230, 0.25);
        border-color: #8257e6;
    }

    .btn-gamilha:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(130, 87, 230, 0.4);
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.alert').forEach(function(alert) {
        setTimeout(function() {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        }, 10000);
    });
});
</script>
{% endblock %}
