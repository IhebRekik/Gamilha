{% extends 'base_login.html.twig' %}

{% block body %}
<div class="d-flex align-items-center justify-content-center" style="min-height:70vh;">
    <div class="card-front p-4" style="width: 100%; max-width: 420px;">
        <div class="text-center mb-4">
            <div class="verification-icon mb-3">
                <i class="bi bi-shield-check text-gradient-violet" style="font-size: 4rem;"></i>
            </div>
            <h3 class="text-gradient-violet">Vérification</h3>
            <p class="text-muted mb-0">
                <small>Entrez le code à 6 chiffres envoyé à</small><br>
                <strong>{{ email }}</strong>
            </p>
        </div>

        {# Affichage des erreurs #}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <div class="d-flex align-items-start">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div class="flex-grow-1">
                        <strong>Erreur</strong>
                        <p class="mb-0 mt-1">{{ message }}</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <form method="post">
            <div class="mb-4">
                <label class="form-label text-center d-block">
                    <i class="bi bi-key me-1"></i>Code de vérification
                </label>
                <input type="text" 
                       name="code" 
                       id="codeInput"
                       class="form-control text-center fs-3 fw-bold"
                       placeholder="000000"
                       maxlength="6"
                       pattern="[0-9]{6}"
                       required
                       autofocus
                       style="letter-spacing: 0.5rem;">
                <small class="text-muted d-block text-center mt-2">
                    <i class="bi bi-clock me-1"></i>Le code expire dans 15 minutes
                </small>
            </div>

            <button class="btn btn-gamilha w-100 mb-3" type="submit">
                <i class="bi bi-check-circle me-2"></i>Vérifier le code
            </button>

            <div class="text-center">
                <small class="text-muted">
                    Vous n'avez pas reçu le code ? 
                    <a href="{{ path('app_forgot_password') }}" class="text-decoration-none">
                        <i class="bi bi-arrow-clockwise"></i> Renvoyer
                    </a>
                </small>
            </div>
        </form>
    </div>
</div>

<style>
    .alert-danger {
        background: linear-gradient(135deg, rgba(220, 53, 69, 0.1) 0%, rgba(220, 53, 69, 0.05) 100%);
        border: 1px solid rgba(220, 53, 69, 0.3);
        border-radius: 10px;
        color: #dc3545;
    }

    .card-front {
        backdrop-filter: blur(10px);
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }

    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(130, 87, 230, 0.25);
        border-color: #8257e6;
    }

    #codeInput {
        font-family: 'Courier New', monospace;
    }

    .verification-icon {
        animation: pulse 2s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.05);
        }
    }

    .btn-gamilha:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(130, 87, 230, 0.4);
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const codeInput = document.getElementById('codeInput');
    
    // Accepter seulement les chiffres
    codeInput.addEventListener('input', function(e) {
        this.value = this.value.replace(/[^0-9]/g, '');
    });

    // Auto-submit quand 6 chiffres sont entrés
    codeInput.addEventListener('input', function(e) {
        if (this.value.length === 6) {
            this.form.submit();
        }
    });

    document.querySelectorAll('.alert').forEach(function(alert) {
        setTimeout(function() {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        }, 10000);
    });
});
</script>
{% endblock %}
