{% extends 'base_login.html.twig' %}

{% block body %}
<div class="d-flex align-items-center justify-content-center" style="min-height:70vh;">
    <div class="card-front p-4" style="width: 100%; max-width: 420px;">
        <div class="text-center mb-4">
            <i class="bi bi-lock-fill text-gradient-violet" style="font-size: 3rem;"></i>
            <h3 class="mt-2 text-gradient-violet">Nouveau mot de passe</h3>
            <p class="text-muted mb-0">
                <small>Choisissez un mot de passe sécurisé</small>
            </p>
        </div>

        {# Affichage des erreurs #}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <div class="d-flex align-items-start">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                    <div class="flex-grow-1">
                        <strong>Erreur</strong>
                        <p class="mb-0 mt-1">{{ message }}</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        <form method="post">
            <div class="mb-3">
                <label class="form-label">
                    <i class="bi bi-lock me-1"></i>Nouveau mot de passe
                </label>
                <div class="input-group">
                    <input type="password" 
                           name="password" 
                           id="passwordInput"
                           class="form-control"
                           placeholder="••••••••"
                           required
                           autofocus>
                    <button class="btn btn-outline-secondary" 
                            type="button" 
                            id="togglePassword"
                            title="Afficher/Masquer le mot de passe">
                        <i class="bi bi-eye" id="toggleIcon"></i>
                    </button>
                </div>
                <small class="text-muted">
                    <i class="bi bi-info-circle me-1"></i>Min 8 caractères, dont 1 majuscule, 1 minuscule et 1 chiffre
                </small>
            </div>

            <div class="mb-4">
                <label class="form-label">
                    <i class="bi bi-lock-fill me-1"></i>Confirmer le mot de passe
                </label>
                <div class="input-group">
                    <input type="password" 
                           name="confirm_password" 
                           id="confirmPasswordInput"
                           class="form-control"
                           placeholder="••••••••"
                           required>
                    <button class="btn btn-outline-secondary" 
                            type="button" 
                            id="toggleConfirmPassword"
                            title="Afficher/Masquer le mot de passe">
                        <i class="bi bi-eye" id="toggleConfirmIcon"></i>
                    </button>
                </div>
            </div>

            <button class="btn btn-gamilha w-100 mb-3" type="submit">
                <i class="bi bi-check-circle me-2"></i>Réinitialiser le mot de passe
            </button>
        </form>
    </div>
</div>

<style>
    .alert-danger {
        background: linear-gradient(135deg, rgba(220, 53, 69, 0.1) 0%, rgba(220, 53, 69, 0.05) 100%);
        border: 1px solid rgba(220, 53, 69, 0.3);
        border-radius: 10px;
        color: #dc3545;
    }

    .card-front {
        backdrop-filter: blur(10px);
        border-radius: 15px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    }

    .form-control:focus {
        box-shadow: 0 0 0 0.25rem rgba(130, 87, 230, 0.25);
        border-color: #8257e6;
    }

    .btn-outline-secondary {
        border-left: none;
        background: transparent;
        color: #6c757d;
        transition: all 0.3s ease;
    }

    .btn-outline-secondary:hover {
        color: #495057;
        background: rgba(108, 117, 125, 0.1);
        border-color: #ced4da;
    }

    .btn-outline-secondary:focus {
        box-shadow: none;
        border-color: #ced4da;
    }

    .btn-gamilha:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(130, 87, 230, 0.4);
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Toggle password visibility
    const togglePassword = document.getElementById('togglePassword');
    const passwordInput = document.getElementById('passwordInput');
    const toggleIcon = document.getElementById('toggleIcon');

    if (togglePassword) {
        togglePassword.addEventListener('click', function() {
            const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordInput.setAttribute('type', type);
            
            if (type === 'password') {
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            } else {
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            }
        });
    }

    // Toggle confirm password visibility
    const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
    const confirmPasswordInput = document.getElementById('confirmPasswordInput');
    const toggleConfirmIcon = document.getElementById('toggleConfirmIcon');

    if (toggleConfirmPassword) {
        toggleConfirmPassword.addEventListener('click', function() {
            const type = confirmPasswordInput.getAttribute('type') === 'password' ? 'text' : 'password';
            confirmPasswordInput.setAttribute('type', type);
            
            if (type === 'password') {
                toggleConfirmIcon.classList.remove('bi-eye-slash');
                toggleConfirmIcon.classList.add('bi-eye');
            } else {
                toggleConfirmIcon.classList.remove('bi-eye');
                toggleConfirmIcon.classList.add('bi-eye-slash');
            }
        });
    }

    document.querySelectorAll('.alert').forEach(function(alert) {
        setTimeout(function() {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        }, 10000);
    });
});
</script>
{% endblock %}
