{% extends 'base_front.html.twig' %}

{% block title %}Changer le mot de passe — Gamilha{% endblock %}

{% block stylesheets %}
<style>
    .password-requirements {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.25);
        border-radius: 12px;
        padding: 1rem;
    }
    .requirement {
        color: var(--gamilha-muted);
        transition: color 0.3s;
    }
    .requirement.valid {
        color: #4ade80;
    }
    .password-toggle {
        cursor: pointer;
        transition: color 0.2s;
    }
    .password-toggle:hover {
        color: var(--gamilha-accent);
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    
    <div class="row justify-content-center">
        <div class="col-lg-6">
            
            {# Header #}
            <div class="mb-4">
                <a href="{{ path('app_profile') }}" class="btn btn-outline-light mb-3">
                    <i class="bi bi-arrow-left me-2"></i>Retour au profil
                </a>
                <h1 class="display-6 fw-bold mb-2">
                    <i class="bi bi-key-fill me-3 text-gradient-violet"></i>Changer le mot de passe
                </h1>
                <p class="text-muted">Assurez-vous de choisir un mot de passe sécurisé</p>
            </div>

            {# Flash Messages #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show border-success border-opacity-50" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>{{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show border-danger border-opacity-50" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {# Formulaire #}
            <div class="card-front p-4">
                {{ form_start(form) }}

                {# Mot de passe actuel #}
                <div class="mb-4">
                    {{ form_label(form.currentPassword, null, {'label_attr': {'class': 'form-label fw-semibold text-white'}}) }}
                    <div class="input-group">
                        <span class="input-group-text bg-dark text-white border-secondary">
                            <i class="bi bi-shield-lock-fill"></i>
                        </span>
                        {{ form_widget(form.currentPassword, {'attr': {'id': 'currentPassword'}}) }}
                        <span class="input-group-text bg-dark text-white border-secondary password-toggle" onclick="togglePassword('currentPassword', this)">
                            <i class="bi bi-eye"></i>
                        </span>
                    </div>
                    {{ form_errors(form.currentPassword) }}
                </div>

                <hr class="my-4 border-secondary opacity-50">

                {# Nouveau mot de passe #}
                <div class="mb-3">
                    {{ form_label(form.newPassword.first, null, {'label_attr': {'class': 'form-label fw-semibold text-white'}}) }}
                    <div class="input-group">
                        <span class="input-group-text bg-dark text-white border-secondary">
                            <i class="bi bi-key-fill"></i>
                        </span>
                        {{ form_widget(form.newPassword.first, {'attr': {'id': 'newPassword'}}) }}
                        <span class="input-group-text bg-dark text-white border-secondary password-toggle" onclick="togglePassword('newPassword', this)">
                            <i class="bi bi-eye"></i>
                        </span>
                    </div>
                    {{ form_errors(form.newPassword.first) }}
                </div>

                {# Confirmer nouveau mot de passe #}
                <div class="mb-4">
                    {{ form_label(form.newPassword.second, null, {'label_attr': {'class': 'form-label fw-semibold text-white'}}) }}
                    <div class="input-group">
                        <span class="input-group-text bg-dark text-white border-secondary">
                            <i class="bi bi-check-circle-fill"></i>
                        </span>
                        {{ form_widget(form.newPassword.second, {'attr': {'id': 'confirmPassword'}}) }}
                        <span class="input-group-text bg-dark text-white border-secondary password-toggle" onclick="togglePassword('confirmPassword', this)">
                            <i class="bi bi-eye"></i>
                        </span>
                    </div>
                    {{ form_errors(form.newPassword.second) }}
                </div>

                {# Exigences du mot de passe #}
                <div class="password-requirements mb-4">
                    <h6 class="text-white mb-3">
                        <i class="bi bi-info-circle me-2"></i>Exigences du mot de passe
                    </h6>
                    <ul class="mb-0" style="list-style: none; padding-left: 0;">
                        <li class="requirement mb-2">
                            <i class="bi bi-check-circle me-2"></i>
                            Au moins 8 caractères
                        </li>
                        <li class="requirement mb-2">
                            <i class="bi bi-check-circle me-2"></i>
                            Une lettre majuscule
                        </li>
                        <li class="requirement mb-2">
                            <i class="bi bi-check-circle me-2"></i>
                            Une lettre minuscule
                        </li>
                        <li class="requirement">
                            <i class="bi bi-check-circle me-2"></i>
                            Un chiffre
                        </li>
                    </ul>
                </div>

                {# Boutons d'action #}
                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
                    <a href="{{ path('app_profile') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>Annuler
                    </a>
                    <button type="submit" class="btn btn-gamilha">
                        <i class="bi bi-shield-check me-2"></i>Modifier le mot de passe
                    </button>
                </div>

                {{ form_end(form) }}
            </div>

        </div>
    </div>

</div>

<script>
function togglePassword(inputId, icon) {
    const input = document.getElementById(inputId);
    const iconElement = icon.querySelector('i');
    
    if (input.type === 'password') {
        input.type = 'text';
        iconElement.classList.remove('bi-eye');
        iconElement.classList.add('bi-eye-slash');
    } else {
        input.type = 'password';
        iconElement.classList.remove('bi-eye-slash');
        iconElement.classList.add('bi-eye');
    }
}
</script>
{% endblock %}
