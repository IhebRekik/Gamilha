{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-8">

            <!-- Carte Profil -->
            <div class="card bg-dark text-light shadow-lg border-primary">

                <!-- Header -->
                <div class="card-header d-flex align-items-center bg-primary text-white">
                    <i class="bi bi-person-circle fs-2 me-3"></i>
                    <div>
                        <h4 class="mb-0">{{ app.user.name }}</h4>
                        <small class="opacity-75">Compte utilisateur</small>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body">

                    <!-- Infos -->
                    <div class="mb-4">
                        <h5 class="text-primary">
                            <i class="bi bi-info-circle me-2"></i>
                            Informations personnelles
                        </h5>

                        <ul class="list-group list-group-flush bg-dark">
                            <li class="list-group-item bg-dark text-light">
                                <strong>Nom :</strong> {{ app.user.name }}
                            </li>
                            <li class="list-group-item bg-dark text-light">
                                <strong>Email :</strong> {{ app.user.email }}
                            </li>
                            <li class="list-group-item bg-dark text-light">
                                <strong>Rôles :</strong>
                                {% for role in app.user.roles %}
                                    <span class="badge bg-secondary">{{ role }}</span>
                                {% endfor %}
                            </li>
                        </ul>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex justify-content-between mt-4">

                        <a href="{{ path('app_homepage') }}" class="btn btn-outline-light">
                            <i class="bi bi-arrow-left me-1"></i>
                            Retour à l’accueil
                        </a>

                        <div>
                            <a href="#" class="btn btn-warning me-2">
                                <i class="bi bi-pencil-square me-1"></i>
                                Modifier le profil
                            </a>

                            <a href="{{ path('app_logout') }}" class="btn btn-danger">
                                <i class="bi bi-box-arrow-right me-1"></i>
                                Déconnexion
                            </a>
                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>
{% endblock %}
