{% extends 'base_front.html.twig' %}

{% block title %}{{ app.user.name }} — Mon Profil{% endblock %}

{% block stylesheets %}
<style>
    .profile-header {
        background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(124, 58, 237, 0.1));
        border: 1px solid rgba(139, 92, 246, 0.3);
        border-radius: 20px;
        padding: 2.5rem;
        position: relative;
        overflow: hidden;
    }
    .profile-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.15), transparent);
        border-radius: 50%;
    }
    .profile-avatar {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        border: 4px solid var(--gamilha-accent);
        box-shadow: 0 8px 32px rgba(139, 92, 246, 0.4);
        object-fit: cover;
    }
    .profile-avatar-placeholder {
        width: 140px;
        height: 140px;
        background: linear-gradient(135deg, var(--gamilha-accent), var(--gamilha-neon));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 4rem;
        color: white;
        border: 4px solid rgba(139, 92, 246, 0.5);
        box-shadow: 0 8px 32px rgba(139, 92, 246, 0.4);
    }
    .stat-card {
        background: rgba(139, 92, 246, 0.08);
        border: 1px solid rgba(139, 92, 246, 0.25);
        border-radius: 16px;
        padding: 1.5rem;
        text-align: center;
        transition: all 0.3s;
    }
    .stat-card:hover {
        background: rgba(139, 92, 246, 0.15);
        border-color: rgba(139, 92, 246, 0.5);
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(139, 92, 246, 0.2);
    }
    .stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        background: linear-gradient(135deg, var(--gamilha-accent), var(--gamilha-neon));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .info-item {
        background: var(--gamilha-card);
        border: 1px solid rgba(139, 92, 246, 0.15);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1rem;
        transition: border-color 0.3s;
    }
    .info-item:hover {
        border-color: rgba(139, 92, 246, 0.4);
    }
    .badge-role {
        background: rgba(139, 92, 246, 0.2);
        color: var(--gamilha-neon);
        border: 1px solid rgba(139, 92, 246, 0.4);
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
    }
    .action-btn {
        padding: 0.75rem 1.5rem;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s;
    }
    .btn-edit {
        background: linear-gradient(135deg, #8b5cf6, #a78bfa);
        border: none;
        color: white;
    }
    .btn-edit:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(139, 92, 246, 0.4);
        color: white;
    }
    .section-card {
        background: var(--gamilha-card);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 16px;
        padding: 2rem;
        margin-bottom: 1.5rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="container py-5">
    
    {# Profile Header #}
    <div class="profile-header mb-5">
        <div class="row align-items-center position-relative">
            <div class="col-lg-3 text-center mb-4 mb-lg-0">
                {% if app.user.profileImage %}
                    <img src="{{ asset('uploads/profile_images/' ~ app.user.profileImage) }}" 
                         alt="{{ app.user.name }}" 
                         class="profile-avatar">
                {% else %}
                    <div class="profile-avatar-placeholder mx-auto">
                        <i class="bi bi-person-fill"></i>
                    </div>
                {% endif %}
            </div>
            
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold mb-2 text-white">{{ app.user.name }}</h1>
                <p class="text-muted fs-5 mb-3">
                    <i class="bi bi-envelope me-2"></i>{{ app.user.email }}
                </p>
                <div class="d-flex flex-wrap gap-2">
                    {% for role in app.user.roles %}
                        <span class="badge-role">
                            <i class="bi bi-shield-check me-1"></i>{{ role }}
                        </span>
                    {% endfor %}
                    {% if app.user.isActive %}
                        <span class="badge-role" style="background: rgba(34, 197, 94, 0.2); color: #4ade80; border-color: rgba(34, 197, 94, 0.4);">
                            <i class="bi bi-check-circle-fill me-1"></i>Compte actif
                        </span>
                    {% endif %}
                </div>
            </div>
            
            <div class="col-lg-3 text-center text-lg-end mt-4 mt-lg-0">
                <a href="{{ path('app_profile_edit') }}" class="action-btn btn-edit btn d-block mb-2">
                    <i class="bi bi-pencil-square me-2"></i>Modifier profil
                </a>
                <a href="{{ path('app_logout') }}" class="action-btn btn btn-outline-danger d-block">
                    <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                </a>
            </div>
        </div>
    </div>

    {# Statistics #}
    <div class="row mb-5">
        <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="stat-card">
                <i class="bi bi-trophy-fill text-warning mb-3" style="font-size: 2.5rem;"></i>
                <div class="stat-number">0</div>
                <div class="text-muted fw-semibold">Tournois</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="stat-card">
                <i class="bi bi-people-fill mb-3" style="font-size: 2.5rem; color: var(--gamilha-accent);"></i>
                <div class="stat-number">0</div>
                <div class="text-muted fw-semibold">Équipes</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="stat-card">
                <i class="bi bi-star-fill text-warning mb-3" style="font-size: 2.5rem;"></i>
                <div class="stat-number">0</div>
                <div class="text-muted fw-semibold">Abonnements</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="stat-card">
                <i class="bi bi-chat-dots-fill mb-3" style="font-size: 2.5rem; color: var(--gamilha-neon);"></i>
                <div class="stat-number">0</div>
                <div class="text-muted fw-semibold">Messages</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="stat-card {{ app.user.reports > 0 ? 'border-warning' : '' }}">
                <i class="bi bi-flag-fill {{ app.user.reports > 0 ? 'text-warning' : 'text-muted' }} mb-3" style="font-size: 2.5rem;"></i>
                <div class="stat-number">{{ app.user.reports }}</div>
                <div class="text-muted fw-semibold">Signalements</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6 mb-3">
            <div class="stat-card">
                <i class="bi bi-clock-fill mb-3" style="font-size: 2.5rem; color: var(--gamilha-accent);"></i>
                <div class="stat-number">0</div>
                <div class="text-muted fw-semibold">Heures jouées</div>
            </div>
        </div>
    </div>

    <div class="row">
        {# Informations personnelles #}
        <div class="col-lg-6 mb-4">
            <div class="section-card">
                <h3 class="mb-4">
                    <i class="bi bi-person-badge me-2 text-gradient-violet"></i>
                    Informations personnelles
                </h3>
                
                <div class="info-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted d-block mb-1">Nom d'utilisateur</small>
                            <strong class="fs-5">{{ app.user.name }}</strong>
                        </div>
                        <i class="bi bi-person-circle fs-3" style="color: var(--gamilha-accent);"></i>
                    </div>
                </div>

                <div class="info-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted d-block mb-1">Adresse email</small>
                            <strong class="fs-5">{{ app.user.email }}</strong>
                        </div>
                        <i class="bi bi-envelope-fill fs-3" style="color: var(--gamilha-accent);"></i>
                    </div>
                </div>

                <div class="info-item">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-muted d-block mb-1">Statut du compte</small>
                            <strong class="fs-5">
                                {% if app.user.isActive %}
                                    <span class="text-success">
                                        <i class="bi bi-check-circle-fill me-1"></i>Actif
                                    </span>
                                {% else %}
                                    <span class="text-danger">
                                        <i class="bi bi-x-circle-fill me-1"></i>Désactivé
                                    </span>
                                {% endif %}
                            </strong>
                        </div>
                        <i class="bi bi-shield-check fs-3" style="color: var(--gamilha-accent);"></i>
                    </div>
                </div>

                {% if app.user.banUntil and app.user.banUntil > date() %}
                <div class="info-item border-danger border-opacity-50">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <small class="text-danger d-block mb-1">Banni jusqu'au</small>
                            <strong class="fs-5 text-danger">{{ app.user.banUntil|date('d/m/Y à H:i') }}</strong>
                        </div>
                        <i class="bi bi-ban fs-3 text-danger"></i>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {# Sécurité & Paramètres #}
        <div class="col-lg-6 mb-4">
            <div class="section-card">
                <h3 class="mb-4">
                    <i class="bi bi-gear-fill me-2 text-gradient-violet"></i>
                    Sécurité & Paramètres
                </h3>

                <div class="d-grid gap-3">
                    <a href="{{ path('app_profile_change_password') }}" class="btn btn-outline-light action-btn text-start">
                        <i class="bi bi-key-fill me-3" style="color: var(--gamilha-accent);"></i>
                        <strong>Changer le mot de passe</strong>
                        <small class="d-block text-muted ms-4 ps-2 mt-1">Modifier votre mot de passe actuel</small>
                    </a>

                    <a href="{{ path('app_profile_edit') }}" class="btn btn-outline-light action-btn text-start">
                        <i class="bi bi-pencil-square me-3" style="color: var(--gamilha-accent);"></i>
                        <strong>Modifier les informations</strong>
                        <small class="d-block text-muted ms-4 ps-2 mt-1">Changer nom, email et photo de profil</small>
                    </a>

                    <a href="#privacy" class="btn btn-outline-light action-btn text-start">
                        <i class="bi bi-shield-lock-fill me-3" style="color: var(--gamilha-accent);"></i>
                        <strong>Confidentialité</strong>
                        <small class="d-block text-muted ms-4 ps-2 mt-1">Gérer la visibilité de votre profil</small>
                    </a>

                    <a href="#notifications" class="btn btn-outline-light action-btn text-start">
                        <i class="bi bi-bell-fill me-3" style="color: var(--gamilha-accent);"></i>
                        <strong>Notifications</strong>
                        <small class="d-block text-muted ms-4 ps-2 mt-1">Préférences de notification par email</small>
                    </a>
                </div>
            </div>

            {# Quick Actions #}
            <div class="section-card mt-4">
                <h5 class="mb-3">
                    <i class="bi bi-lightning-charge-fill me-2" style="color: var(--gamilha-neon);"></i>
                    Actions rapides
                </h5>
                <div class="d-flex flex-wrap gap-2">
                    <a href="{{ path('app_homepage') }}" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-house-door me-1"></i>Accueil
                    </a>
                    <a href="{{ path('front_evenement_index') }}" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-calendar-event me-1"></i>Événements
                    </a>
                    <a href="{{ path('front_equipe_index') }}" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-people-fill me-1"></i>Équipes
                    </a>
                    <a href="{{ path('chat_user_list') }}" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-chat-dots me-1"></i>Messages
                    </a>
                    <a href="{{ path('social_index') }}" class="btn btn-sm btn-outline-light">
                        <i class="bi bi-globe me-1"></i>Réseaux
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
