<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
		<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
		<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"> {% block stylesheets %}{% endblock %}
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
		<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet"/>
		<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
		<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
		

		<link rel="icon" type="image/x-icon" href="{{ asset('images/gamilha.png') }}">
		<link rel="stylesheet" href="{{ asset('styles/app.css') }}">
	</head>
	<body style="background-color: #2a004f; color: white;">
		<nav class="navbar navbar-expand-lg navbar-dark bg-gradient-dark shadow-sm">
			<div
				class="container-fluid px-4">

				<!-- Logo gauche -->
				<a class="fw-bold text-gradient-violet" href="#">
					<img src="{{ asset('images/gamilha.png') }}" alt="Logo Gamilha" class="me-2" width="125" height="125">
					Gamilha Admin
				</a>

				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="collapse navbar-collapse justify-content-end" id="navbarContent">
					<ul
						class="navbar-nav align-items-center">
						<!-- Liens principaux -->
						<li class="nav-item">
							<a class="nav-link" href="{{ path('admin_dashboard') }}">
								<i class="bi bi-speedometer2 me-1"></i>
								Dashboard</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('admin_user_index') }}">
								<i class="bi bi-people me-1"></i>
								Utilisateurs</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('admin_event_index') }}">
								<i class="bi bi-trophy me-1"></i>
								Événements</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('admin_team_index') }}">
								<i class="bi bi-people-group me-1"></i>
								Équipes</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('admin_social_media_index') }}">
								<i class="bi bi-share me-1"></i>
								Social</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('admin_stream_index') }}">
								<i class="bi bi-broadcast me-1"></i>
								Streams</a>
						</li>
						  
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_abonnement_index') }}">
								<i class="bi bi-broadcast me-1"></i>
								Abonnements</a>
						</li>
							<li class="nav-item">
							<a class="nav-link" href="{{ path('app_user_abonnement_index') }}">
								<i class="bi bi-broadcast me-1"></i>
								Abonnements Utilisateurs</a>
						</li>
						</li>
							<li class="nav-item">
							<a class="nav-link" href="{{ path('app_chat_message_index') }}">
								<i class="bi bi-chat-dots me-1"></i>
								Chat Admin</a>
						</li>
							<li class="nav-item">
							<a class="nav-link" href="{{ path('chat_user_list') }}">
								<i class="bi bi-chat-dots me-1"></i>
								List des Amis</a>
						</li>
						

						<!-- Dropdown utilisateur (optionnel) -->
						<li class="nav-item dropdown ms-3">
							<a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
								<i class="bi bi-person-circle fs-4 me-2"></i>
								<span>Iheb</span>
							</a>

							<ul class="dropdown-menu dropdown-menu-end bg-dark border-primary shadow" aria-labelledby="userDropdown">
								<li>
									<a class="dropdown-item text-white" href="#">
										<i class="bi bi-person me-2"></i>
										Mon profil
									</a>
								</li>
								<li><hr class="dropdown-divider bg-secondary"></li>
								<li>
									<a class="dropdown-item text-white" href="#">
										<i class="bi bi-box-arrow-right me-2"></i>
										Déconnexion
									</a>
								</li>
							</ul>

						</li>

					</ul>
				</div>
			</div>
		</nav>
		<div class="container-fluid px-0" style="background: linear-gradient(135deg, #0f001a 0%, #1a0033 40%, #2a004f 70%, #3d0066 100%);
				            min-height: 100vh;
				            color: #e0e0ff;">

			<div class="container py-4"> {% block body %}{% endblock %}
				</div>

			</div>
		</body>
	</html>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}</body></html>
