<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gamilha — E-Sport & Tournois{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="icon" type="image/x-icon" href="{{ asset('images/gamilha.png') }}">
    <style>
        :root {
            --gamilha-bg: #0a0a0f;
            --gamilha-surface: #12121a;
            --gamilha-card: #1a1a26;
            --gamilha-border: rgba(139, 92, 246, 0.2);
            --gamilha-accent: #8b5cf6;
            --gamilha-accent-hover: #a78bfa;
            --gamilha-neon: #c084fc;
            --gamilha-text: #e2e8f0;
            --gamilha-muted: rgb(218 218 218 / 75%);
        }
        .text-muted {
            color: rgb(218 218 218 / 75%) !important;
        }
        body {
            background: var(--gamilha-bg);
            color: var(--gamilha-text);
            font-family: 'Segoe UI', system-ui, sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
        }
        .front-nav {
            background: linear-gradient(180deg, rgba(10,10,15,0.98) 0%, rgba(10,10,15,0.9) 100%);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--gamilha-border);
        }
        .front-nav .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            background: linear-gradient(135deg, var(--gamilha-accent), var(--gamilha-neon));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .front-nav .nav-link {
            color: var(--gamilha-muted) !important;
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
            transition: color 0.2s, background 0.2s;
        }
        .front-nav .nav-link:hover, .front-nav .nav-link.active {
            color: var(--gamilha-neon) !important;
            background: rgba(139, 92, 246, 0.1);
        }
        .btn-gamilha {
            background: linear-gradient(135deg, var(--gamilha-accent), #7c3aed);
            border: none;
            color: #fff;
            font-weight: 600;
            padding: 0.6rem 1.25rem;
            border-radius: 10px;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .btn-gamilha:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(139, 92, 246, 0.4);
            color: #fff;
        }
        .card-front {
            background: var(--gamilha-card);
            border: 1px solid var(--gamilha-border);
            border-radius: 16px;
            overflow: hidden;
            transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
        }
        .card-front:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(139, 92, 246, 0.15);
            border-color: rgba(139, 92, 246, 0.4);
        }
        .hero-gradient {
            background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(139, 92, 246, 0.25), transparent),
                        radial-gradient(ellipse 60% 40% at 80% 50%, rgba(124, 58, 237, 0.15), transparent),
                        var(--gamilha-bg);
        }
        .glow-text {
            text-shadow: 0 0 40px rgba(139, 92, 246, 0.5);
        }
        .badge-gamilha {
            background: rgba(139, 92, 246, 0.25);
            color: var(--gamilha-neon);
            border: 1px solid var(--gamilha-border);
            font-weight: 500;
        }
        .footer-front {
            background: var(--gamilha-surface);
            border-top: 1px solid var(--gamilha-border);
            padding: 3rem 0 1.5rem;
            margin-top: 4rem;
        }
        .match-card {
            border-left: 4px solid var(--gamilha-accent);
        }
        .section-title {
            font-weight: 700;
            font-size: 1.75rem;
            margin-bottom: 1.5rem;
            background: linear-gradient(90deg, #fff, var(--gamilha-muted));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .text-gradient-violet {
            background: linear-gradient(135deg, var(--gamilha-accent), var(--gamilha-neon));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="hero-gradient">


    <main class="container py-4 pb-5 ">
        {% block body %}{% endblock %}
    </main>

    <footer class="footer-front">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    <img src="{{ asset('images/gamilha.png') }}" alt="Gamilha" height="32" class="me-2">
                    <span class="text-muted">Gamilha — Plateforme e-sport & tournois</span>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <a href="{{ path('front_evenement_index') }}" class="text-muted text-decoration-none me-3">Événements</a>
                    <a href="{{ path('front_equipe_index') }}" class="text-muted text-decoration-none me-3">Équipes</a>
                    <a href="{{ path('admin_dashboard') }}" class="text-muted text-decoration-none">Admin</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
