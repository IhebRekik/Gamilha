<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gamilha — E-Sport & Tournois{% endblock %}</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="icon" type="image/x-icon" href="{{ asset('images/gamilha.png') }}">

    <style>
        /* ===== VARIABLES ===== */
        :root {
            --gamilha-bg: #0a0a0f;
            --gamilha-surface: #12121a;
            --gamilha-card: #1a1a26;
            --gamilha-border: rgba(139, 92, 246, 0.2);
            --gamilha-accent: #8b5cf6;
            --gamilha-accent-hover: #a78bfa;
            --gamilha-neon: #c084fc;
            --gamilha-text: #e2e8f0;
            --gamilha-muted: rgb(218 218 218 / 75%);
        }

        /* ===== BASE ===== */
        .text-muted {
            color: rgb(218 218 218 / 75%) !important;
        }

        body {
            background-color: #0f0f18;
            color: #e4e6eb;
        }

        /* ===== HERO GRADIENT ===== */
        .hero-gradient {
            background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(139, 92, 246, 0.25), transparent),
                        radial-gradient(ellipse 60% 40% at 80% 50%, rgba(124, 58, 237, 0.15), transparent),
                        var(--gamilha-bg);
        }

        /* ===== NAVBAR ===== */
        .navbar {
            background-color: #141421;
            border-bottom: 1px solid #2a2a40;
        }

        .navbar-brand {
            font-weight: 700;
            color: #9d4edd !important;
        }

        /* front-nav (style du premier fichier) */
        .front-nav {
            background: linear-gradient(180deg, rgba(10,10,15,0.98) 0%, rgba(10,10,15,0.9) 100%);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--gamilha-border);
        }

        .front-nav .navbar-brand {
            font-weight: 800;
            font-size: 1.4rem;
            background: linear-gradient(135deg, var(--gamilha-accent), var(--gamilha-neon));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .front-nav .nav-link {
            color: var(--gamilha-muted) !important;
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
            transition: color 0.2s, background 0.2s;
        }

        .front-nav .nav-link:hover,
        .front-nav .nav-link.active {
            color: var(--gamilha-neon) !important;
            background: rgba(139, 92, 246, 0.1);
        }

        /* ===== NAV LINKS (global) ===== */
        .nav-link {
            color: #cfcfe8 !important;
            font-weight: 500;
        }

        .nav-link:hover {
            color: #c77dff !important;
        }

        /* ===== BUTTONS ===== */
        .btn-gamilha {
            background: linear-gradient(135deg, var(--gamilha-accent), #7c3aed);
            border: none;
            color: #fff;
            font-weight: 600;
            padding: 0.6rem 1.25rem;
            border-radius: 10px;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-gamilha:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(139, 92, 246, 0.4);
            color: #fff;
        }

        /* ===== CARDS ===== */
        .card-custom {
            background-color: #1a1a2e;
            border: 1px solid #2a2a40;
            border-radius: 15px;
        }

        .card-front {
            background: var(--gamilha-card);
            border: 1px solid var(--gamilha-border);
            border-radius: 16px;
            overflow: hidden;
            transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
        }

        .card-front:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(139, 92, 246, 0.15);
            border-color: rgba(139, 92, 246, 0.4);
        }

        /* ===== BADGE ===== */
        .badge-gamilha {
            background: rgba(139, 92, 246, 0.25);
            color: var(--gamilha-neon);
            border: 1px solid var(--gamilha-border);
            font-weight: 500;
        }

        /* ===== MATCH CARD ===== */
        .match-card {
            border-left: 4px solid var(--gamilha-accent);
        }

        /* ===== SECTION TITLE ===== */
        .section-title {
            font-weight: 700;
            font-size: 1.75rem;
            margin-bottom: 1.5rem;
            background: linear-gradient(90deg, #fff, var(--gamilha-muted));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* ===== TYPOGRAPHY HELPERS ===== */
        .glow-text {
            text-shadow: 0 0 40px rgba(139, 92, 246, 0.5);
        }

        .text-gradient-violet {
            background: linear-gradient(135deg, var(--gamilha-accent), var(--gamilha-neon));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* ===== FOOTER ===== */
        footer {
            background-color: #141421;
            border-top: 1px solid #2a2a40;
        }

        .footer-front {
            background: var(--gamilha-surface);
            border-top: 1px solid var(--gamilha-border);
            padding: 3rem 0 1.5rem;
            margin-top: 4rem;
        }

        /* ===== DROPDOWNS ===== */
        .dropdown-menu {
            background-color: #1a1a2e;
            border: 1px solid #2a2a40;
        }

        .dropdown-item {
            color: #fff;
        }

        .dropdown-item:hover {
            background-color: #7b2cbf;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body class="hero-gradient">

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container">

        <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_homepage') }}">
            <img src="{{ asset('images/gamilha.png') }}" height="35">
            Gamilha
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_homepage') }}">
                        <i class="bi bi-house-door me-1"></i> Accueil
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('front_evenement_index') }}">
                        <i class="bi bi-calendar-event me-1"></i> Événements
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('front_equipe_index') }}">
                        <i class="bi bi-people-fill me-1"></i> Équipes
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('chat') }}">
                        <i class="bi bi-robot me-1"></i> Gamilha AI
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('chat_user_list') }}">
                        <i class="bi bi-person-lines-fill me-1"></i> Amis
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('social_index') }}">
                        <i class="bi bi-share-fill me-1"></i> Réseaux
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('stream_index') }}">
                        <i class="bi bi-broadcast-pin me-1"></i> Streams
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_abonnementuser_index') }}">
                        <i class="bi bi-gem me-1"></i> Abonnements
                    </a>
                </li>

                <!-- USER DROPDOWN -->
                <li class="nav-item dropdown ms-lg-3">
                    <a class="nav-link dropdown-toggle d-flex align-items-center"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown">

                        <i class="bi bi-person-circle fs-5 me-2"></i>

                        {% if app.user %}
                            {{ app.user.name }}
                        {% else %}
                            Compte
                        {% endif %}
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li>
                            <a class="dropdown-item" href="{{ path('app_profile') }}">
                                <i class="bi bi-person me-2"></i> Mon profil
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_logout') }}">
                                <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                            </a>
                        </li>
                    </ul>
                </li>

            </ul>
        </div>
    </div>
</nav>

<!-- ================= MAIN CONTENT ================= -->
<main class="container py-4">
    {% block body %}{% endblock %}
</main>

<!-- ================= FOOTER ================= -->
<footer class="py-4 mt-5">
    <div class="container">
        <div class="row text-center text-md-start align-items-center">

            <div class="col-md-6 mb-3 mb-md-0">
                <img src="{{ asset('images/gamilha.png') }}" height="30" class="me-2">
                <span class="text-muted">Gamilha — Plateforme E-Sport & Tournois</span>
            </div>

        </div>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

{% block javascripts %}
    {% if app.user %}
        <script src="https://cdn.ably.com/lib/ably.min-1.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const currentUserId = {{ app.user.id }};

                const ably = new Ably.Realtime('{{ ably_api_key }}');

                const channel = ably.channels.get('streams:new');

                channel.subscribe('message', (msg) => {
                    const data = msg.data;

                    if (data.type !== 'new_stream') return;
                    if (data.streamerId === currentUserId) return;

                    const toastHTML = `
                        <div class="toast show bg-dark text-white border-0 position-fixed bottom-0 end-0 m-3"
                             style="z-index: 9999; min-width: 300px;" data-bs-autohide="true" data-bs-delay="8000">
                            <div class="toast-header bg-danger text-white">
                                <strong class="me-auto">🔴 NOUVEAU LIVE !</strong>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                            </div>
                            <div class="toast-body">
                                <strong>${data.title}</strong><br>
                                <small>par ${data.streamerName} • ${data.game}</small>
                                <hr class="my-2 border-secondary">
                                <a href="${data.url}" class="btn btn-sm btn-outline-light w-100">
                                    Regarder le live maintenant →
                                </a>
                            </div>
                        </div>`;

                    const container = document.createElement('div');
                    container.innerHTML = toastHTML;
                    document.body.appendChild(container.firstElementChild);
                });
            });
        </script>
    {% endif %}
{% endblock %}
</body>
</html>
