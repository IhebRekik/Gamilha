<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Gamilha — E-Sport & Tournois{% endblock %}</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <link rel="icon" type="image/x-icon" href="{{ asset('images/gamilha.png') }}">

    <style>
        body {
            background-color: #0f0f18;
            color: #e4e6eb;
        }

        .navbar {
            background-color: #141421;
            border-bottom: 1px solid #2a2a40;
        }

        .navbar-brand {
            font-weight: 700;
            color: #9d4edd !important;
        }

        .nav-link {
            color: #cfcfe8 !important;
            font-weight: 500;
        }

        .nav-link:hover {
            color: #c77dff !important;
        }

        .btn-gamilha {
            background-color: #7b2cbf;
            color: #fff;
            border: none;
        }

        .btn-gamilha:hover {
            background-color: #9d4edd;
            color: #fff;
        }

        .card-custom {
            background-color: #1a1a2e;
            border: 1px solid #2a2a40;
            border-radius: 15px;
        }

        footer {
            background-color: #141421;
            border-top: 1px solid #2a2a40;
        }

        .dropdown-menu {
            background-color: #1a1a2e;
            border: 1px solid #2a2a40;
        }

        .dropdown-item {
            color: #fff;
        }

        .dropdown-item:hover {
            background-color: #7b2cbf;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>

<body>

<!-- ================= NAVBAR ================= -->
<nav class="navbar navbar-expand-lg navbar-dark sticky-top">
    <div class="container">

        <a class="navbar-brand d-flex align-items-center gap-2" href="{{ path('app_homepage') }}">
            <img src="{{ asset('images/gamilha.png') }}" height="35">
            Gamilha
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_homepage') }}">
                        <i class="bi bi-house-door me-1"></i> Accueil
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('front_evenement_index') }}">
                        <i class="bi bi-calendar-event me-1"></i> Événements
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('front_equipe_index') }}">
                        <i class="bi bi-people-fill me-1"></i> Équipes
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('chat') }}">
                        <i class="bi bi-robot me-1"></i> Gamilha AI
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('chat_user_list') }}">
                        <i class="bi bi-person-lines-fill me-1"></i> Amis
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('social_index') }}">
                        <i class="bi bi-share-fill me-1"></i> Réseaux
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('stream_index') }}">
                        <i class="bi bi-broadcast-pin me-1"></i> Streams
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_abonnementuser_index') }}">
                        <i class="bi bi-gem me-1"></i> Abonnements
                    </a>
                </li>

                <!-- USER DROPDOWN -->
                <li class="nav-item dropdown ms-lg-3">
                    <a class="nav-link dropdown-toggle d-flex align-items-center"
                       href="#"
                       role="button"
                       data-bs-toggle="dropdown">

                        <i class="bi bi-person-circle fs-5 me-2"></i>

                        {% if app.user %}
                            {{ app.user.name }}
                        {% else %}
                            Compte
                        {% endif %}
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end shadow">
                        <li>
                            <a class="dropdown-item" href="{{ path('app_profile') }}">
                                <i class="bi bi-person me-2"></i> Mon profil
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="{{ path('app_logout') }}">
                                <i class="bi bi-box-arrow-right me-2"></i> Déconnexion
                            </a>
                        </li>
                    </ul>
                </li>

            </ul>
        </div>
    </div>
</nav>

<!-- ================= MAIN CONTENT ================= -->
<main class="container py-4">
    {% block body %}{% endblock %}
</main>

<!-- ================= FOOTER ================= -->
<footer class="py-4 mt-5">
    <div class="container">
        <div class="row text-center text-md-start align-items-center">

            <div class="col-md-6 mb-3 mb-md-0">
                <img src="{{ asset('images/gamilha.png') }}" height="30" class="me-2">
                <span class="text-muted">Gamilha — Plateforme E-Sport & Tournois</span>
            </div>

            

        </div>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}
        {% if app.user %}
            <script src="https://cdn.ably.com/lib/ably.min-1.js"></script>
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    const currentUserId = {{ app.user.id }};

                    // ← UTILISE LA VARIABLE PASSÉE PAR LE CONTRÔLEUR
                    const ably = new Ably.Realtime('{{ ably_api_key }}');

                    const channel = ably.channels.get('streams:new');

                    channel.subscribe('message', (msg) => {
                        const data = msg.data;

                        if (data.type !== 'new_stream') return;

                        if (data.streamerId === currentUserId) return;

                        const toastHTML = `
                            <div class="toast show bg-dark text-white border-0 position-fixed bottom-0 end-0 m-3"
                                 style="z-index: 9999; min-width: 300px;" data-bs-autohide="true" data-bs-delay="8000">
                                <div class="toast-header bg-danger text-white">
                                    <strong class="me-auto">🔴 NOUVEAU LIVE !</strong>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                                </div>
                                <div class="toast-body">
                                    <strong>${data.title}</strong><br>
                                    <small>par ${data.streamerName} • ${data.game}</small>
                                    <hr class="my-2 border-secondary">
                                    <a href="${data.url}" class="btn btn-sm btn-outline-light w-100">
                                        Regarder le live maintenant →
                                    </a>
                                </div>
                            </div>`;

                        const container = document.createElement('div');
                        container.innerHTML = toastHTML;
                        document.body.appendChild(container.firstElementChild);
                    });
                });
            </script>

 {% endif %}
{% endblock %}
</body>
</html>