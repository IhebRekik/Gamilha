{% extends 'base.html.twig' %}

{% block title %}Modifier vidéo{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1>✏️ Modifier la vidéo</h1>

    {{ form_start(form) }}
        {{ form_widget(form) }}
        <button class="btn btn-success mt-3">💾 Mettre à jour</button>
    {{ form_end(form) }}

    <a href="{{ path('video_index') }}" class="btn btn-secondary mt-3">
        ⬅️ Retour
    </a>
</div>
{% endblock %}
